      const ua = navigator.userAgent.toLowerCase()
      const ipadRegex = /iPad|Android(?!.*Mobile)|tablet|Tablet|kindle|silk|playbook|touchpad|hpwos|webos|rim tablet/i
      const MobileRegex =
        /Mobile|Android|iPod|iPhone|BlackBerry|Windows Phone|Opera Mini|IEMobile|webOS|symbian|smartphone|iemobile|phone|bb10|blackberry/i
      const isSafari = ua.includes('safari') && !ua.includes('chrome')
      // pc端不处理
      if ((!ipadRegex.test(ua) && !MobileRegex.test(ua)) || !isSafari) return

      const match = ua.match(/version\/([\d.]+).*safari/)
      // 没匹配到safari不处理
      if (!match) {
        console.warn('not match safari')
        return
      }
      const safariVersion = match[1]
      const versionNumber = Number(safariVersion.split('.')[0])
      console.warn('safari Version: ', versionNumber)
      if (isNaN(versionNumber) || versionNumber > 14) return
      console.warn('version is to low, cannot use feature flex-gap; open the polyfill')
      document.body.style.setProperty('--flex-gap-polyfill', '1')
    })()</script><div id="app-root"></div></body><script async>const host = window.location.host
  /** 获取query参数*/
  const getUrlParams = function () {
    const url = new URL(window.location.href)
