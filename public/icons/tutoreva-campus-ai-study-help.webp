  }
  const searchParams = getUrlParams()
  if (host !== 'cn-www.xizi-ai.com' && !searchParams.get('without_outsea_scripts')) {
    const script = document.createElement('script')
    script.src = 'https://d3rrhwck8vmxlf.cloudfront.net/web/assets/js/advertisement_injecting.js'
    script.type = 'text/javascript'
    script.async = true
    const body = document.querySelector('body')
    body.parentNode.insertBefore(script, body.nextSibling)
  }</script></html>