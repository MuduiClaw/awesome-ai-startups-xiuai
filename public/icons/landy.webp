<link href="/static/web_service/css/includes/how_it_works.f9914e83537c.css" rel="stylesheet"/>

<section class="how-it-works-section">
    <h2>How It Works</h2>
    <div class="steps-container">
        <!-- Step 1 -->
        <div class="step left" data-step="1">
            <div class="step-number">1</div>
            <div class="step-content">
                <div class="image-container">
                    <img src="/static/web_service/images/steps/step1_static.595d01afcd21.jpg" alt="Import a Listing" class="static-image">
                    <video class="animated-image" muted playsinline>
                        <source src="/static/web_service/images/steps/step1_animation.34c69c72b2e4.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <h3>Import a Listing</h3>
                <p>Copy and paste any listing link or type the address of a home you want to buy.</p>
            </div>
        </div>
        <!-- Step 2 -->
        <div class="step right" data-step="2">
            <div class="step-number">2</div>
            <div class="step-content">
                <div class="image-container">
                    <img src="/static/web_service/images/steps/step2_static.9b39943c8e7a.jpg" alt="Request a Tour or Offer Prep Session" class="static-image">
                    <video class="animated-image" muted playsinline>
                        <source src="/static/web_service/images/steps/step2_animation.87719abc8111.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <h3>Click the Tour or Offer Button</h3>
                <p>Choose a time that works for you to begin booking with a flat-fee agent.</p>
            </div>
        </div>
        <!-- Step 3 -->
        <div class="step left" data-step="3">
            <div class="step-number">3</div>
            <div class="step-content">
                <div class="image-container">
                    <img src="/static/web_service/images/steps/step3_static.83cbc1334899.jpg" alt="Adjust Your Preferences" class="static-image">
                    <video class="animated-image" muted playsinline>
                        <source src="/static/web_service/images/steps/step3_animation.c0145a416752.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <h3>Set Your Terms</h3>
                <p>You decide what you want from an agent and how they should get paid.</p>
            </div>
        </div>
        <!-- Step 4 -->
        <div class="step right" data-step="4">
            <div class="step-number">4</div>
            <div class="step-content">
                <div class="image-container">
                    <img src="/static/web_service/images/steps/step4_static.12cc999b066f.jpg" alt="Get Matched with an Agent" class="static-image">
                    <video class="animated-image" muted playsinline>
                        <source src="/static/web_service/images/steps/step4_animation.fcba69e09a9a.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <h3>Get An Agent</h3>
                <p>We instantly ping our network of top-rated agents and find someone to work for you on a non-exclusive, flat-fee basis.</p>
            </div>
        </div>
        <!-- Step 5 -->
        <div class="step left" data-step="5">
            <div class="step-number">5</div>
            <div class="step-content">
                <div class="image-container">
                    <img src="/static/web_service/images/steps/step5_static.a2a758eb4e80.jpg" alt="Finalize and Save" class="static-image">
                    <video class="animated-image" muted playsinline>
                        <source src="/static/web_service/images/steps/step5_animation.a7f88c9f558d.mp4" type="video/mp4">
                        Your browser does not support the video tag.
                    </video>
                </div>
                <h3>Finalize and Save</h3>
                <p>Complete your transaction and save big over traditional agents.</p>
            </div>
        </div>
    </div>
    <script src="/static/web_service/js/includes/how_it_works.28c0a310571f.js"></script>
</section> 

