<section class="pricing-options-section">
    <h2>How Much Can You Save?</h2>
<!-- Add Property Price Input -->
<div class="property-price-input">
    <i class="fas fa-home property-price-icon"></i>
    <label for="property-price">Property Price:</label>
    <input type="text" id="property-price" name="property_price" value="$500,000">
</div>

<!-- Pricing Chart Section -->


<div class="pricing-chart">
    <p class="compare-text">
        Compare your potential agent fees to complete a home purchase if you end up buying after taking 5 tours and making 2 offers:
    </p>
    <div class="cards-container" id="pricing-container-cards">
        <!-- Traditional Agent Card -->
        <div class="card">
            <div class="card-header">
                <img src="/static/scheduling_service/images/traditional_representation.d69564789b86.png" alt="Traditional" class="pricing-chart-icon">
                <h3>Traditional Agent</h3>
            </div>
            <div class="card-row">
                <p></p>
                <span></span>
            </div>
            <div class="card-body">
                <div class="card-row">
                    <p><strong>Booking Fee:</strong></p>
                    <span>None</span>
                </div>
                <div class="card-row">
                    <p><strong>Tour Fees:</strong></p>
                    <span>None</span>
                </div>
                <div class="card-row">
                    <p><strong>Offer Fees:</strong></p>
                    <span>None</span>
                </div>
                <div class="card-row">
                    <p><strong>At Closing Fee (3%):</strong></p>
                    <span class="traditional-closing-fee">$</span>
                </div>
                <div class="card-row separator"></div>
                <div class="card-row">
                    <p><strong>Total Fees:</strong></p>
                    <span class="traditional-total-fees">$</span>
