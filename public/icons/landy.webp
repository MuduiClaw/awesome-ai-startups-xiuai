    <script>
    document.addEventListener("DOMContentLoaded", function() {
        var header = document.querySelector("header");
        var logo = document.getElementById("logo");
        var hamburgerButton = document.getElementById("hamburger-button");
        var mainNav = document.getElementById("main-nav");

        // Store the paths to the logos
        var transparentLogo = "/static/web_service/images/landian_wordmark_logo_beta_medium_trans_white.423c165594a3.png";
        var whiteLogo = "/static/web_service/images/landian_wordmark_logo_beta_medium_trans.0e3745305707.png";

        // Preload images
        var logoImages = {
            transparent: new Image(),
            white: new Image()
        };

        logoImages.transparent.src = transparentLogo;
        logoImages.white.src = whiteLogo;

        var imagesLoaded = {
            transparent: false,
            white: false
        };

        logoImages.transparent.onload = function() {
            imagesLoaded.transparent = true;
        };
        logoImages.white.onload = function() {
            imagesLoaded.white = true;
        };

        // Function to set the logo src
        function setLogoSrc(src) {
            if (src === whiteLogo && imagesLoaded.white) {
                logo.src = whiteLogo;
            } else if (src === transparentLogo && imagesLoaded.transparent) {
                logo.src = transparentLogo;
            }
        }

        // Function to determine the correct logo based on the header type
        function updateLogoBasedOnHeader() {
            if (header.classList.contains("transparent-header")) {
                if (window.scrollY > 0 || header.classList.contains("menu-open")) {
                    setLogoSrc(whiteLogo);
                } else {
                    setLogoSrc(transparentLogo);
                }
            } else if (header.classList.contains("white-header")) {
                setLogoSrc(whiteLogo);
            }
        }

        // Handle scroll to change header state
        window.addEventListener("scroll", function() {
            if (window.scrollY > 0) {
                header.classList.add("scrolled");
            } else {
                header.classList.remove("scrolled");
            }
            updateLogoBasedOnHeader();
        });

        // Handle menu toggle
        hamburgerButton.addEventListener("click", function() {
            mainNav.classList.toggle("open");
            header.classList.toggle("menu-open");

            if (mainNav.classList.contains("open")) {
                setLogoSrc(whiteLogo); // Use white logo when menu is open
            } else {
                updateLogoBasedOnHeader(); // Update logo based on the header state and scroll position
            }
        });

        // Initial logo update on page load
        updateLogoBasedOnHeader();
    });
    </script>

