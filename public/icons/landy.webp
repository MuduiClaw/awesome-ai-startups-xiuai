<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.innerWidth <= 768) {  
      const dotContainer = document.querySelector('.dot-container');
      const testimonialCarousel = document.querySelector('.testimonial-carousel');
      const testimonials = testimonialCarousel.querySelectorAll('.testimonial-card') || [];
      
      testimonials.forEach(testimonial => {
        const dot = document.createElement('div');
        dotContainer.style.display = 'flex';
        dot.classList.add('dot');
        dot.addEventListener('click', () => {
          testimonialCarousel.scrollLeft = testimonial.offsetLeft - testimonialCarousel.offsetLeft;
        });
        dotContainer.appendChild(dot);
        testimonialCarousel.addEventListener('scroll', updateActiveDot);
        window.addEventListener('resize', updateActiveDot);
        updateActiveDot();
      });
    }

    function updateActiveDot() {
      const dotContainer = document.querySelector('.dot-container');
      const testimonialCarousel = document.querySelector('.testimonial-carousel');
      const scrollLeft = testimonialCarousel.scrollLeft;
      const containerWidth = testimonialCarousel.offsetWidth;
      const currentIndex = Math.round(scrollLeft / containerWidth);
      const dots = dotContainer.querySelectorAll('.dot');
      
      dots.forEach((dot, index) => {
        if (index === currentIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }
  });
</script>


