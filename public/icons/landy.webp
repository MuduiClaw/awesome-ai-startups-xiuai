    <div class="easter-egg-icon" title="Click to change background">
        <i class="fas fa-sync-alt"></i> <!-- Font Awesome icon for refresh -->
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function() {
    
        function getRandomImageNumber(min, max) {
            return String(Math.floor(Math.random() * (max - min + 1) + min)).padStart(2, '0');
        }
    
        let lastImageNumber = localStorage.getItem('lastImageNumber') || '01'; // Use the last image number or default to 01
        let imageTimestamp = localStorage.getItem('imageTimestamp');
        let imageUpdated = sessionStorage.getItem('imageUpdated') === 'true'; // Track if the image has been updated in this session
    
        function updateBackgroundImage(forceUpdate = false) {
            let imageNumber = lastImageNumber;
            const currentTime = new Date().getTime();
            
            if (forceUpdate || (!imageUpdated && (!imageTimestamp || currentTime - imageTimestamp > 30 * 60 * 1000))) {
                do {
                    imageNumber = getRandomImageNumber(1, 13); // Adjust the range according to your available images, starting from 02
                } while (imageNumber == lastImageNumber);
                
                localStorage.setItem('imageTimestamp', currentTime);
                sessionStorage.setItem('imageUpdated', 'true'); // Mark that the image has been updated
            }
    
            const imageUrl = `/static/web_service/images/background/${imageNumber}.jpeg`;
            const img = new Image();
            img.src = imageUrl;
            img.onload = function() {
                let newBackground = `linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('${imageUrl}') no-repeat top/cover`;
                $('.welcome-background').css('background', newBackground);
                $('.welcome-background').css('opacity', '1'); // Set opacity to 1 after the image has loaded
            };
    
            localStorage.setItem('lastImageNumber', imageNumber);
            lastImageNumber = imageNumber;
        }
    
        // Initial background image load based on session data
        if (lastImageNumber === '01') {
            const initialImageUrl = `/static/web_service/images/background/01.0aa2f69ad08e.jpeg`;
            $('.welcome-background').css('background', `linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('${initialImageUrl}') no-repeat top/cover`);
        } else {
            updateBackgroundImage(); // Load the last remembered image
        }
    
        // Change background on Easter egg icon click
        $('.easter-egg-icon').on('click', function() {
            if (!$(this).hasClass('hidden')) {
                $('.welcome-background').css('opacity', '0'); // Reduce the opacity to 0
    
                setTimeout(() => {
                    updateBackgroundImage(true); // Forcefully update the image
                }, 500);
            }
        });
    
        // Change background on keypress (e.g., Command/Ctrl + I)
        $(document).on('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && e.which === 73) {
                $('.welcome-background').css('opacity', '0'); // Reduce the opacity to 0
    
                setTimeout(() => {
                    updateBackgroundImage(true); // Forcefully update the image
                }, 500); 
                
                return false; // Prevent default action
            }
        });
    
        $(window).on('scroll', function() {
            var welcomeSectionBottom = $('.welcome-section').offset().top + $('.welcome-section').outerHeight();
    
            var scrollTop = $(this).scrollTop();
            var windowTop = scrollTop; // Top of the viewport
    
            if (windowTop > welcomeSectionBottom) {
                $('.easter-egg-icon').css('opacity', '0').addClass('hidden'); // Fully faded out and hidden
            } else if (windowTop > welcomeSectionBottom - $(window).height()) {
                var easterEggOpacity = 1 - (windowTop - (welcomeSectionBottom - $(window).height())) / $(window).height(); // Calculate opacity based on the fade-out range
                $('.easter-egg-icon').css('opacity', easterEggOpacity).removeClass('hidden'); // Gradually fade out
            } else {
                $('.easter-egg-icon').css('opacity', '1').removeClass('hidden'); // Fully visible when above the fade-out threshold
            }
        });
    
        // Function to show the search help text when the search box is focused
        function showSearchHelpText() {
            $('#search-help-text').html('<i class="fas fa-info-circle"></i> &nbsp;Importing takes a minute, thanks for your patience!');
        }

        // Attach the focus event to the search input
        $('.search-input').on('focus', function() {
            showSearchHelpText();
        });

        // Hide the search help text when the search box loses focus (optional)
        $('.search-input').on('blur', function() {
            $('#search-help-text').css('opacity', '0').css('visibility', 'hidden');
        });
    
        // Check if background needs to be updated after 30 minutes, but only update once
        if (!imageUpdated && imageTimestamp && (new Date().getTime() - imageTimestamp) > 30 * 60 * 1000) {
            updateBackgroundImage(true); // Forcefully update the image after 30 minutes
        }
    
    });
</script>
    

