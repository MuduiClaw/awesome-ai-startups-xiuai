    .exact-middle {
      font-family: sans-serif;
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: #888999;
    }

    .color-pulse-font {
      animation: color-change 1s infinite;
    }

    @keyframes color-change {
      0% {
        color: white;
      }

      50% {
        color: black;
      }

      100% {
        color: white;
      }
    }

    .helvetica-font {
      font-family: Helvetica;
      font-weight: 300;
      font-size: large;
    }
