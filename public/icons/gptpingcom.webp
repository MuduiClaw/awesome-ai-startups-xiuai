<style type="text/css">* {
  box-sizing: border-box;
  margin: 0;
  text-wrap: pretty;
}
html {
  width: 100%;
  height: 100%;
  margin: 0px;
  padding: 0px;
  color: #fff;
  background-color: #0047FF;
}
body {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  flex-wrap: nowrap;
  min-height: 100%;
  margin: 0px;
  padding: 0px;
  font-size: 15px;
  font-family: -apple-system, system-ui, 'Roboto', sans-serif;
}
h1, h2 {
  font-weight: 400;
}
h2 {
  font-size: 1.25rem;
}
a {
  text-decoration: none;
  color: #0047FF;
}
button, .btn {
  appearance: none;
  background-color: #FFE500;
  font-weight: 700;
  font-size: 15px;
  color: #000000;
  padding-left: 1.5em;
  padding-right: 1.5em;
  padding-top: 0.8em;
  padding-bottom: 0.8em;
  border-radius: 9999px;
  outline: none;
  border: 0px;
}
.btn--secondary {
  background-color: rgba(250,250,250,0.20);
  color: #fff;
}
.btn--link {
  background-color: transparent;
  padding: 0;
  color: #0047FF;
}
button:disabled {
  background-color: #767676;
}
btn--circle {
  height: 35px;
  width: 35px;
  padding: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex-wrap: nowrap;
  flex: 0 0 auto;
}
[data-event-click]:hover {
  cursor: pointer;
}
[data-event-click]:active:hover {
  filter: brightness(85%);
}
input {
  padding-top: 10px;
  padding-bottom: 10px;
  font-size: 15px;
  height: 40px;
  background-color: transparent;
  border: 0px;
  color: #fff;
  outline: 0px;
}
input:-internal-autofill-selected {
  background-color: transparent;
  border: 0px;
}
textarea {
  padding-left: 15px;
  padding-right: 15px;
  padding-top: 5px;
  padding-bottom: 40px;
  font-size: 15px;
  background-color: transparent;
  border: 0px;
  color: #fff;
  outline: 0px;
  resize: none;
}
select {
  padding-top: 10px;
  padding-bottom: 10px;
  height: 40px;
  font-size: 15px;
  background-color: transparent;
  border: 0px;
  color: #fff;
  outline: 0px;
}
.hidden {
  overflow: hidden;
}
.no-underline {
  text-decoration: none;
}
.linkless {
  color: #000000;
  text-decoration: none;
}
.inline {
  display: inline;
}
.rtl {
  direction: rtl;
}
.nosel {
  user-drag: none;
  -webkit-user-drag: none;
  user-select: none;
  -moz-user-select: none;
  -webkit-user-select: none;
  -ms-user-select: none;
}
.border-solid {
  border-style: solid;
}
.divide-y > * + * {
  border-top: 1px solid #ccc;
}
@keyframes spin {
  to  {
    transform: rotate(360deg);
}
}
@-webkit-keyframes spin {
  to  {
    -webkit-transform: rotate(360deg);
}
}
.loader {
  display: inline-block;
  width: 25px;
  height: 25px;
  border: 4px solid rgba(255,255,255,.3);
  border-radius: 50%;
  border-top-color: #FFE500;
  animation: spin 0.8s linear infinite;
}
.loader-sm {
  width: 16px;
  height: 16px;
}
