\"images\":\"Images\",\"plan\":\"Plan\"},\"generate-image\":\"Generate Image Now\",\"normal-reset-info\":\"Reset in {hour, plural, =0 {# hour} =1 {# hour} other {# hours}}.\",\"vip-reset-info\":\"Reset on {date, date, ::yyyyMd}\"},\"newsletter\":{\"email\":\"Email\",\"hints\":{\"success\":{\"message\":\"Thank you for subscribing to our newsletter. We will keep you posted.\",\"title\":\"Subscribed\"},\"error\":{\"input\":\"Please enter a valid email address.\",\"submission\":\"We apologize, but we were unable to sign you up for our newsletter. Please try again later.\",\"title\":\"Error\"}},\"submit\":\"Subscribe\",\"subtitle\":\"Be among the first to get access to supastarter.nextjs.\",\"title\":\"Get early access\"},\"pricing\":{\"description\":\"Choose the plan that works best for you.\",\"month\":\"month\",\"monthly\":\"Monthly\",\"subscribe\":\"Subscribe\",\"title\":\"Pricing\",\"year\":\"year\",\"yearly\":\"Yearly\",\"free\":\"Free to Use\",\"billed-yearly\":\"(billed yearly)\"},\"settings\":{\"account\":{\"changeEmail\":{\"description\":\"Enter a new email and click save to update it.\",\"note\":\"You will need to verify your new email address before you can sign in again.\",\"title\":\"Your email\"},\"changeName\":{\"title\":\"Your name\"},\"deleteAccount\":{\"title\":\"Account\",\"note\":\"(Deleting your account isn’t unsubscribing. \u003cspan\u003eIf you’re a subscriber, your subscription will not continue to be valid after you delete your account!!!\u003c/span\u003e To unsubscribe, look for the unsubscribe link in your confirmation email or contact us for assistance.)\",\"deleteMyAccount\":\"Delete my account\",\"manageSubscription\":\"Manage subscription\",\"dialogTitle\":\"Delete Account\",\"deleteMessage\":\"Deleting your account will delete all the associated data\",\"deleteInputTitle\":\"To confirm, type \\\"\u003cstrong\u003edelete my account\u003c/strong\u003e\\\" below\",\"deleteInputPlaceholder\":\"Type \\\"delete my account\\\"\",\"cancel\":\"Cancel\",\"delete\":\"Delete\"},\"changePassword\":{\"description\":\"To change your password, enter the new one below and click save.\",\"note\":\"Please enter at least 8 characters.\",\"title\":\"Your password\"},\"title\":\"Account\"},\"billing\":{\"subscription\":{\"cancel\":\"Cancel your subscription\",\"later\":\"Later\",\"currentPlan\":\"Your current plan\",\"currentSubscription\":\"Your current subscription\",\"endsOn\":\"Your subscription ends on \u003cstrong\u003e{nextPaymentDate, date, medium}\u003c/strong\u003e\",\"cancelScheduleCancel\":\"Don't Cancel\",\"scheduleCancel\":\"This subscription is scheduled to be canceled on \u003cstrong\u003e{cancelDate, date, medium}\u003c/strong\u003e.\",\"freePlan\":{\"title\":\"Free\"},\"month\":\"month\",\"monthly\":\"Monthly\",\"nextPayment\":\"The next payment will be on \u003cstrong\u003e{nextPaymentDate, date, medium}\u003c/strong\u003e\",\"pauseSubscription\":\"Pause your subscription\",\"resumeSubscription\":\"Resume your subscription\",\"status\":{\"active\":\"Active\",\"canceled\":\"Canceled\",\"expired\":\"Expired\",\"trialing\":\"Trialing\",\"paused\":\"Paused\",\"incomplete\":\"Incomplete\",\"unpaid\":\"Unpaid\",\"past_due\":\"Past due\"},\"subscribe\":\"Subscribe\",\"switchToPlan\":\"Switch to this plan\",\"updateBillingDetails\":\"Update billing details\",\"upgradePlan\":\"Upgrade your plan\",\"year\":\"year\",\"yearly\":\"Yearly\",\"yourSubscription\":\"Your are subscribed to \u003cstrong\u003e{plan}\u003c/strong\u003e ({price}/{interval})\",\"resume\":\"Resume subscription\"},\"title\":\"Billing\",\"cancelSubscription\":{\"title\":\"Are you sure?\",\"confirm\":\"Once you cancel the subscription it will continue its active state until the end of next billing period.\",\"notifications\":{\"success\":{\"title\":\"Subscription was canceled\"},\"error\":{\"title\":\"Could not cancel subscription\"}}},\"cancelScheduleCancel\":{\"title\":\"Are you sure?\",\"confirm\":\"Once you remove the scheduled cancelation it will continue its active state and billing cycle.\",\"notifications\":{\"success\":{\"title\":\"The subscription will no longer be canceled\"},\"error\":{\"title\":\"Could not cancel the schedule\"}}},\"resumeSubscription\":{\"notifications\":{\"success\":{\"title\":\"Subscription was resumed\"},\"error\":{\"title\":\"Could not resume subscription\"}}},\"createCustomerPortal\":{\"label\":\"Manage billing details\",\"notifications\":{\"error\":{\"title\":\"Could not create a customer portal session. Please try again.\"}}},\"pauseSubscription\":{\"notifications\":{\"success\":{\"title\":\"The subscription was paused.\"},\"error\":{\"title\":\"Could not pause the subscription. Please try again.\"}},\"label\":\"Pause subscription\"}},\"notifications\":{\"emailUpdated\":\"Your email has been updated.\",\"nameUpdated\":\"Your name has been updated.\",\"passwordUpdated\":\"Your password has been updated.\",\"passwordNotUpdated\":\"We were unable to update your password. Please try again.\",\"teamNameNotUpdated\":\"We were unable to update your team name. Please try again later.\",\"teamNameUpdated\":\"Your team name has been updated.\",\"nameUpdateFailed\":\"Could not update your name. Please try again later.\"},\"save\":\"Save\",\"subtitle\":\"Manage your settings\",\"team\":{\"changeName\":{\"description\":\"Enter a new name and click save to update it.\",\"teamUrl\":\"Your team url will be \u003cstrong\u003e{url}\u003c/strong\u003e.\",\"title\":\"Team name\"},\"members\":{\"invite\":\"Invite a new member\",\"inviteMember\":{\"email\":\"Email\",\"role\":\"Role\",\"submit\":\"Invite\",\"title\":\"Invite new member\",\"notifications\":{\"error\":{\"title\":\"Could not invite member\",\"description\":\"We were unable to invite the member. Please try again later.\"},\"success\":{\"title\":\"Member invited\",\"description\":\"The member has been invited.\"}}},\"activeMembers\":\"Active members\",\"pendingInvitations\":\"Pending invitations\",\"invitations\":{\"email\":\"Email\",\"revoke\":\"Revoke invitation\",\"empty\":\"You have not invited any members yet.\"},\"removeMember\":\"Remove member\",\"roles\":{\"member\":\"Member\",\"owner\":\"Owner\"},\"title\":\"Members\",\"notifications\":{\"removeMember\":{\"success\":{\"description\":\"The member has been successfully removed from your team.\"},\"error\":{\"description\":\"Could not remove the member from your team. Please try again.\"},\"loading\":{\"description\":\"Removing member from team...\"}},\"revokeInvitation\":{\"success\":{\"description\":\"The invitation has been revoked.\"},\"error\":{\"description\":\"The invitation could not be revoked. Please try again later.\"},\"loading\":{\"description\":\"Revoking invitation...\"}},\"updateMembership\":{\"success\":{\"description\":\"Membership was updated successfully\"},\"error\":{\"description\":\"Could not update team membership. Please try again.\"},\"loading\":{\"description\":\"Updating membership...\"}}}},\"subtitle\":\"Manage your team settings and members\",\"title\":\"Team\"},\"title\":\"Settings\",\"sections\":{\"team\":\"Team\"},\"menu\":{\"team\":{\"title\":\"Team\",\"general\":\"General\",\"members\":\"Members\",\"billing\":\"Billing\"},\"account\":{\"title\":\"Account\",\"general\":\"General\"}}},\"layout\":{\"metadata\":{\"title\":\"Stable Diffusion Online\",\"description\":\"Stable Diffusion is a deep learning model that generates images from text descriptions. Use Stable Diffusion online for free.\"},\"header\":{\"pricing\":\"Pricing\",\"features\":\"Features\",\"faqs\":\"FAQ\",\"prompts\":\"Prompt Database\",\"upscale\":\"Image Upscaler\",\"ai-summarizer\":\"AI Summarizer\",\"blog\":\"Blog\",\"tags\":\"Tags\",\"ai-tools\":{\"2\":{\"name\":\"Stable Diffusion WebUI\",\"des\":\"A most popular browser interface for Stable Diffusion\"},\"3\":{\"name\":\"ControlNet\",\"des\":\"Control diffusion models by adding extra conditions\"},\"4\":{\"name\":\"Image to Video\",\"des\":\"Generates video from images\"},\"5\":{\"name\":\"Background Remover\",\"des\":\"Free background removal tool - private and simple.\"},\"6\":{\"name\":\"Magic Eraser\",\"des\":\"Erase Unwanted Objects\"},\"7\":{\"name\":\"Edit Anything\",\"des\":\"Edit anything in photo to add, remove, replace object with simple text description.\"},\"8\":{\"name\":\"Image Upscaler\",\"des\":\"Upscale your image up to 4K by AI.\"},\"9\":{\"name\":\"AI Clothes Changer\",\"des\":\"Change Clothes freely with lastest AI Technology.\"},\"10\":{\"name\":\"AI Portrait Maker\",\"des\":\"Create AI Art of Specific People or Yourself.\"},\"11\":{\"name\":\"Sketch to Image\",\"des\":\"Convert your hand-drawn art into digital image.\"},\"12\":{\"name\":\"More Free AI Tools\",\"des\":\"Empower Innovation with AI, Unleash the Boundless Potential of Technology.\"},\"faceswap\":{\"name\":\"Face Swap Online\",\"des\":\"Create amazing videos and photo face swaps for FREE.\"},\"label\":\"AI Tools\"},\"cta\":{\"1\":\"Mobile App\",\"2\":\"Pro Version\"},\"apps\":\"Mobile App\",\"credit\":\"Credit:\",\"get-credit\":\"Get Credit\"},\"footer\":{\"copyright\":\"Copyright © {year} Black Technology LTD. All rights reserved.\",\"faqs\":\"FAQ\",\"license\":\"License\",\"prompts\":\"Prompts\",\"apps\":\"Mobile App\",\"get-it-on\":\"GET IT ON\",\"google-play\":\"Google Play\",\"app-store\":\"App Store\",\"private-policy\":\"Private Policy\",\"terms-and-conditions\":\"Terms and Conditions\",\"faceswap\":\"Face Swap\",\"ai-summarizer\":\"AI Summarizer\",\"image-upscaler\":\"Image Upscaler\",\"tetris\":\"Tetris\"}},\"home\":{\"hero\":{\"h1\":\"Stable Diffusion \u003chighlight\u003eOnline\u003c/highlight\u003e\",\"p1\":\"Stable Diffusion is a latent text-to-image diffusion model capable of generating photo-realistic images given any text input, cultivates autonomous freedom to produce incredible imagery, empowers billions of people to create stunning art within seconds.\",\"p2\":\"Create beautiful art using stable diffusion ONLINE for free.\",\"button_generate\":\"Draw\",\"input_placeholder\":\"What do you want to draw?\",\"button_start\":\"Get Started Now\",\"button_pricing\":{\"hovered\":\"$$8.33/month for \",\"normal\":\"AI Art Generator \",\"pro\":\"PRO\"},\"tab1\":\"Style\",\"tab2\":\"Aspect ratio\",\"invalid-prompts-message\":\"Please enter valid prompts, only allowing entering English letters, numbers, and half-width punctuation marks with a minimum of 3 characters and a maximum of 500 characters.\"},\"images\":{\"more\":\"Show more\",\"less\":\"Show less\",\"try\":\"Try an Example\"},\"features\":{\"h2\":\"Making your dreams come true\",\"subtitle\":\"Generate amazing AI Art images from text using Stable Diffusion XL.\",\"f1\":{\"h3\":\"Easy to use\",\"p\":\"Stablediffusionweb.com is an easy-to-use interface for creating images using the recently released Stable Diffusion XL image generation model.\",\"item1\":{\"name\":\"High quality images\",\"description\":\"It can create high quality images of anything you can imagine in seconds–just type in a text prompt and hit Generate.\"},\"item2\":{\"name\":\"GPU enabled and fast generation\",\"description\":\"Perfect for running a quick sentence through the model and get results back rapidly.\"}},\"f2\":{\"h3\":\"Privacy\",\"p\":\"We care about your privacy.\",\"item1\":{\"name\":\"Anonymous\",\"description\":\"We don't collect and use ANY personal information, neither store your text or image.\"},\"item2\":{\"name\":\"Freedom\",\"description\":\"No limitations on what you can enter.\"}}},\"ai\":{\"h2\":\"Stable Diffusion AI Image Generator\",\"p1\":\"Stable Diffusion powered AI image generator that creates images from textual descriptions.\",\"p2\":\"Use our Free AI Image Generator on this page or download \u003clink\u003eMobile App\u003c/link\u003e for on-the-go access.\"},\"cta\":{\"h2\":\"Wanna create better prompt?\",\"p\":\"It’s time to try our new Prompt Database feature, search more than 9 million stable diffusion prompts all over the world!\",\"link\":\"Prompt Database\"},\"faqs\":{\"h2\":\"Frequently asked questions\",\"p\":\"If you can’t find what you’re looking for, email our support team and if you’re lucky someone will get back to you.\",\"group1\":{\"q1\":{\"question\":\"What is Stable Diffusion?\",\"answer\":\"Stable Diffusion is a deep learning model used for converting text to images. It can generate high-quality, photo-realistic images that look like real photographs by simply inputting any text. The latest version of this model is Stable Diffusion XL, which has a larger UNet backbone network and can generate even higher quality images. You can use the free AI image generator on Stable Diffusion Online or search over 9 million Stable Diffusion prompts on Prompt Database. \"},\"q2\":{\"question\":\"What is the difference between Stable Diffusion and other AI image generators? \",\"answer\":\"Stable Diffusion is unique in that it can generate high-quality images with a high degree of control over the output. It can produce output using various descriptive text inputs like style, frame, or presets. In addition to creating images, SD can add or replace parts of images thanks to inpainting and extending the size of an image, called outpainting.\"},\"q3\":{\"question\":\"What was the Stable Diffusion model trained on?\",\"answer\":\"The underlying dataset for Stable Diffusion was the 2b English language label subset of LAION 5b https://laion.ai/blog/laion-5b/, a general crawl of the internet created by the German charity LAION. \"},\"q4\":{\"question\":\"What is the copyright for using Stable Diffusion generated images?\",\"answer\":\"The area of AI-generated images and copyright is complex and will vary from jurisdiction to jurisdiction.\"},\"q5\":{\"question\":\"Can artists opt-in or opt-out to include their work in the training data?\",\"answer\":\"There was no opt-in or opt-out for the LAION 5b model data. It is intended to be a general representation of the language-image connection of the Internet.\"},\"q6\":{\"question\":\"What kinds of GPUs will be able to run Stable Diffusion, and at what settings?\",\"answer\":\"Most NVidia and AMD GPUs with 8GB or more. \"}},\"group2\":{\"q1\":{\"question\":\"How does Stable Diffusion work?\",\"answer\":\"Instead of operating in the high-dimensional image space, Stable Diffusion first compresses the image into the latent space. The model then gradually destroys the image by adding noise, and is trained to reverse this process and regenerate the image from scratch.\"},\"q2\":{\"question\":\"What are some tips for creating effective prompts for Stable Diffusion? \",\"answer\":\"To create effective prompts for Stable Diffusion, it’s important to provide a clear and concise description of the image you want to generate. You should also use descriptive language that is specific to the type of image you want to generate. For example, if you want to generate an image of a sunset, you might use words like \\\"orange\\\", \\\"red\\\", and \\\"purple\\\" to describe the colors in the image.\"},\"q3\":{\"question\":\"Which model are you using?\",\"answer\":\"We are using the Stable Diffusion XL model, which is a latent text-to-image diffusion model capable of generating photo-realistic images given any text input. Compared to previous versions of Stable Diffusion, SDXL leverages a three times larger UNet backbone: The increase of model parameters is mainly due to more attention blocks and a larger cross-attention context as SDXL uses a second text encoder.\"},\"q4\":{\"question\":\"What is the copyright on images created through Stable Diffusion Online?\",\"answer\":\"Images created through Stable Diffusion Online are fully open source, explicitly falling under the CC0 1.0 Universal Public Domain Dedication.\"},\"q5\":{\"question\":\"What is the difference between SDXL Turbo and SDXL 1.0?\",\"answer\":\"SDXL Turbo (Stable Diffusion XL Turbo) is an improved version of SDXL 1.0 (Stable Diffusion XL 1.0), which was the first text-to-image model based on diffusion models. SDXL Turbo implements a new distillation technique called Adversarial Diffusion Distillation (ADD), which enables the model to synthesize images in a single step and generate real-time text-to-image outputs while maintaining high sampling fidelity.\"}},\"group3\":{\"q1\":{\"question\":\"Can I use Stable Diffusion for commercial purposes?\",\"answer\":\"Yes, you can use Stable Diffusion for commercial purposes. Stable Diffusion model has been released under a permissive license that allows users to generate images for both commercial and non-commercial purposes.\"},\"q2\":{\"question\":\"How can I use Stable Diffusion to generate images? \",\"answer\":\"There are primarily two ways that you can use Stable Diffusion to create AI images, either through an API on your local machine or through an online software program like https://stablediffusionweb.com. If you plan to install Stable Diffusion locally, you need a computer with beefy specs to generate images quickly. \"},\"q3\":{\"question\":\"What are Diffusion Models?\",\"answer\":\"Generative models are a class of AI machine learning models that can generate new data based on training data. \"},\"q4\":{\"question\":\"Can we expect more features?\",\"answer\":\"Absolutely. We are working on that.\"},\"q5\":{\"question\":\"How to write creative and high-quality prompt?\",\"answer\":\"Please try our Prompt Database.\"},\"q6\":{\"question\":\"What is SDXL Turbo?\",\"answer\":\"SDXL Turbo is a new text-to-image model that can generate realistic images from text prompts in a single step and in real time, using a novel distillation technique called Adversarial Diffusion Distillation (ADD).\"}}}},\"apps\":{\"metadata\":{\"title\":\"Stable Diffusion App\",\"description\":\"Dreamer is a mobile app that generates images using Stable Diffusion XL.\"},\"h1\":\"Stable Diffusion XL App\",\"get-it-on\":\"GET IT ON\",\"google-play\":\"Google Play\",\"app-store\":\"App Store\",\"dreamer\":{\"caption\":{\"1\":\