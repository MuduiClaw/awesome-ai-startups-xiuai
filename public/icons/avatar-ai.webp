96621b35ea8ac386167b937168301-1.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1726199420-9b6a22fbcc8c67c0d1542d792e914d47-3.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1725043699-f8bb7a58f9dcc9c271b46e9db58ef6b6-1.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1725034571-35dddee8ad4820bb9f31b990d915dd3c-1.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1726199105-710b6aa41092c152d6e06d40b70bbc01-1.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1726206566-912b771b756d38b0c1f803a30e2c1f43-3.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1726205810-8914e93ca27d89e89de4729074a6240f-3.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1726204444-1aa30a8bb41d5f5b538f48aa57ff63a5-1.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1726195679-06b94d6ee178d18a2484386b70c0608d-4.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1726205053-8311294d448d9fbae018961c36d4c283-2.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1726195952-1a6d6376a10e8dbf522206f2de1e11d6-3.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1726205515-65a3ccfcb3934ed06bb52f2693073d35-3.png","\/cdn-cgi\/image\/format=auto,fit=cover,width=250,height=375,quality=50\/https:\/\/r2-us-west.photoai.com\/1726197277-f3409a97675cb683f39e32b24216b8dc-2.png"];

				if(heroPhotos.length>0) {
					var containerBg = document.getElementById("netflix-container-bg");

					var chance = COVER_PROBABILTY / 100;

					for (let i = 0; i < ROWS; i++) {
						const box = createBox();
						for (let i = 0; i < ROW_ITEMS; i++) {
							Math.random() < chance ?
							createElement(box, "netflix-cover") :
							createElement(box, "netflix-thumbnail");
						}
					}
				}

			

				function createElement(box, classname) {
					const element = document.createElement("div");
					imageNumber=Math.floor(Math.random()*heroPhotos.length);
					// hot fix to avoid random pics
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);
					if(in_array(imageNumber,alreadyDone)) imageNumber=Math.floor(Math.random()*heroPhotos.length);

					randomImage=heroPhotos[imageNumber];
					alreadyDone.push(imageNumber);
					let background = 'url('+randomImage+')';
					element.style.backgroundImage = background;
					element.classList.add(classname);
					box.appendChild(element);
				}

				function createBox() {
					const box = document.createElement("div");
					box.classList.add("netflix-box");
					containerBg.appendChild(box);
					return box;
				}

				function getRandomInt(min, max) {
					min = Math.ceil(min);
					max = Math.floor(max);
					return Math.floor(Math.random() * (max - min + 1)) + min;
				}

			</script>
		</netflix>

