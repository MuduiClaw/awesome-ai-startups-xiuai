	:root.training_mode {
		--take-photo-container-height:1px;
	}

	@media (max-width:400px) {
		.hide-before-400px {
			display:none;
		}
	}
	@media (max-width:600px) {
		.hide-before-600px {
			display:none;
		}
	}
	@media (max-width:1200px) {
		.hide-before-1200px {
			display:none;
		}
	}

	.image_viewer model-viewer,
	.div_output_image model-viewer {
		/* add gray radial gradient for 3d models as if it's a 3d scene */
		background:radial-gradient(circle, #b0b0b0, #8a8a8a 50%, #4e4e4e);
	}

	model-viewer .userInput {
		outline:none !important;
	}

	:root.guest {
		--copycat-gallery-height: 1px;
		--take-photo-container-height:1px;
	}
	@media (min-width:800px) {
		html:not(.guest) .top_folder_selector {
