					}

					

					if($('div.sidebar textarea.manual_prompt').val()=='') {
						$('div.sidebar textarea.manual_prompt').focus();
						$('.sidebar').animate({
							scrollTop:
							-$('.sidebar').offset().top+$('div.sidebar textarea.manual_prompt').scrollTop()+$('div.sidebar textarea.manual_prompt').offset().top-28
						},500);
