			$('.select_create_model_gender').bind('change',function() {

				if($('.select_create_model_real_or_ai').val()=='ai_influencer') {
					return;
				}

				var selectedGender = $(this).val();
				if(selectedGender=='couple') {
					if(!confirm("You selected couple as model type. This means your model will be trained as two people together. Make sure that all the photos you upload contain both of you in one photo. It will not work if there is any photos with you separately in a photo. Every photo needs BOTH of you in them so the AI learns you're training BOTH of you in one photo! If you understand this, continue!")) {
						$(this).val(''); // Reset to blank if user cancels
					}
				}
