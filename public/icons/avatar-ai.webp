		$('body').on('click','.action-copycat',function(event) {
			event.stopPropagation();

			
				if($('.image_viewer').is(':visible')) {
					$('.image_viewer_backdrop').click();
				}
				
				if($('.hero .cta-box .input_confirm_email').val().trim()=='') {
