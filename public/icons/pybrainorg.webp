<path d="M0.593133 11.2295C0.17208 10.8345 0.172081 10.166 0.593133 9.77095L9.90938 1.03051C10.5479 0.431405 11.5936 0.884181 11.5936 1.7598V19.2407C11.5936 20.1163 10.5479 20.5691 9.90938 19.97L0.593133 11.2295Z" fill="black"/>
