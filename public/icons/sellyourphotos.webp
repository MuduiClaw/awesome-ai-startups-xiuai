<?xml version="1.0" encoding="UTF-8"?>
<svg width="800" height="800" viewBox="0 0 800 800" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Main camera body -->
  <rect x="100" y="200" width="600" height="400" rx="40" fill="#2563EB"/>
  
  <!-- Camera lens -->
  <circle cx="400" cy="400" r="150" fill="#1E40AF"/>
  <circle cx="400" cy="400" r="120" fill="#3B82F6"/>
  <circle cx="400" cy="400" r="90" fill="#60A5FA"/>
  
  <!-- Flash -->
  <rect x="500" y="150" width="100" height="50" rx="25" fill="#3B82F6"/>
  
  <!-- Camera details -->
  <circle cx="650" cy="300" r="20" fill="#60A5FA"/>
  
  <!-- Inner lens detail -->
  <circle cx="400" cy="400" r="40" fill="#1E40AF"/>
  <circle cx="380" cy="380" r="15" fill="#ffffff" opacity="0.6"/>
</svg>
