<script>
    // Geo Locator
	(() => {
    	const geoLocator = document.querySelector('.geo-locator');
    	const countrySelector = geoLocator.querySelector('#country-selector');
    	const continueButton = geoLocator.querySelector('.geo-locator-actions .btn-content');
    	const closeButton = geoLocator.querySelector('.geo-locator-actions .close-button');
    	const geoLocatorText = geoLocator.querySelector('.geo-locator-text>p');
        
    	// Event listener to update the Geo Locator's Continue button href based on the selected option
    	countrySelector.addEventListener('change', function () {
    	    const selectedUrl = this.value;
    	    continueButton.href = selectedUrl;
    	});
	
    	// Event listener to close Geo locator when clicking on X icon
    	closeButton.addEventListener('click', function () {
    	    geoLocator.classList.add('hide');
    	});
	
    	// Custom event to update the country and text in the get locator.
    	document.addEventListener('nvShowGeoLocator', function (e) {
    	    if (e.detail && e.detail.country && e.detail.textMessage) {
    	        const countryCode = e.detail.country.toLowerCase();
    	        const textMessage = e.detail.textMessage;
			
    	        const countryOption = countrySelector.querySelector('option[data-country="' + countryCode + '"]');
    	        if (countryOption) {
    	            countryOption.selected = true;
    	            continueButton.href = countryOption.value;
				
    	            // Show the geo locator
    	            geoLocator.classList.remove('hide');
    	        } else {
    	            console.log("Error nvShowGeoLocator: Country not found for code:", countryCode);
    	        }
			
    	        geoLocatorText.innerHTML = textMessage;
    	    } else {
    	        console.error("Error nvShowGeoLocator: Missing country or text message in the event detail", e.detail);
    	    }
    	});
	})();
</script>
	<!-- Geo Locator Ends -->
