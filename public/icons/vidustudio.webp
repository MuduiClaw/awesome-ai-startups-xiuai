escription\":\"Effortlessly generate engaging videos using Vidu's world top AI video generation platform in seconds. Let us bring your vision to life fast and easy.\"},\"explore\":{\"title\":\"Explore\",\"description\":\"Explore Vidu's tailored pricing plans and compare features to find the ideal AI video generation solution for your personal or professional projects.\"},\"templates\":{\"title\":\"Using Templates To Generate Creative Video Without Text Prompt\",\"description\":\"Discover Vidu's ready-made template library, and select from our featured kissing, hugging, or festival theme. Bring your vision to life in just one click.\"},\"creations\":{\"title\":\"My Creations\",\"description\":\"View and manage all the AI videos you've created with Vidu. Easily view, re-edit, and share your video content here.\"},\"elements\":{\"title\":\"My References\",\"description\":\"Create and edit my references, efficiently use my references in the video creation process, and generate AI videos that maintain multi-reference consistency, including multiple character consistency, scene consistency, and object consistency\"},\"payments\":{\"title\":\"Pricing\",\"description\":\"Explore Vidu's tailored pricing plans and compare features to find the ideal AI video generation solution for your personal or professional projects.\"},\"share\":{\"title\":\"Share Your AI-Generated Video\",\"description\":\"This AI-generated video was created by one of our users using Vidu AI. Discover the creativity behind it and start crafting your own AI masterpiece today!\"},\"shareAudio\":{\"title\":\"Share Your AI Sound Effects\",\"description\":\"This AI Sound Effects was created by one of our users using Vidu AI. Discover the creativity behind it and start crafting your own AI masterpiece today!\"},\"login\":{\"title\":\"Log in with Your Account\",\"description\":\"Log in to Vidu AI with your account to create AI videos, check your creations, view pricing, check credit usage, and more.\"},\"banned\":{\"title\":\"Access Denied: Blacklist Notice\",\"description\":\"This page is restricted. If you see this page, your account has been blacklisted. For more information or to resolve the issue, please contact Vidu support.\"},\"notFound\":{\"title\":\"404 Page\",\"description\":\"This page does not exist.\"},\"img2video\":{\"title\":\"Image to Video\",\"description\":\"Convert images into stunning videos with Vidu. Simply upload your photos, add a description, and watch your images come to life.\"},\"text2video\":{\"title\":\"Text to Video\",\"description\":\"Turn text to video using Vidu for free online. You can turn any text prompt into high-quality AI-generated videos in seconds with just a few clicks.\"},\"character2video\":{\"title\":\"Reference to Video\",\"description\":\"Try Vidu's Reference to Video feature to generate AI videos with multi-reference consistency.\"},\"invite\":{\"title\":\"Earn Credits in Vidu by Inviting Friends\",\"description\":\"Share your link and invite friends to Vidu to earn more credits passes through our referral program. Generating more high-quality videos from text and images.\"},\"ai-video-generator\":{\"title\":\"AI Video Generator - Text \u0026 Image to Video in Seconds\",\"description\":\"Create AI videos for free with Vidu AI Video Generator. Convert text, images, or avatars into stunning realistic or animated AI videos—no skills required.\"},\"ai-animation-generator\":{\"title\":\"AI Animation Generator - Text \u0026 Image to Animated and Anime Videos\",\"description\":\"Generate animation or anime videos online for free in seconds. Simply enter text or upload images to create AI animations with a few clicks. \"},\"ai-image-animator\":{\"title\":\"AI Image Animator - Animate Old Photos, Portraits \u0026 Paintings\",\"description\":\"Animate photos, including portraits, paintings, anime, and cartoons, turning them into moving videos. Bring people, animals, or objects to life with AI.\"},\"ai-ad-generator\":{\"title\":\"AI Video Ad Generator - Create Commercial Video Ads\",\"description\":\"Create stunning video ads for free and grow your business! Upload product images, add prompts, and effortlessly generate video ads for promotions.\"},\"ai-hug-generator\":{\"title\":\"AI Hug Generator: Create AI Hug Videos Free Online\",\"description\":\"Vidu AI hug generator can create hug videos simply by uploading images, without prompts. It ensures character consistency and is free from distortion.\"},\"ai-kissing-generator\":{\"title\":\"AI Kissing Generator - Create AI Kissing Video Free\",\"description\":\"Try the free AI kissing generator to create natural, romantic kissing videos from your images. Effortlessly bring your photos to life with a kiss for free!\"},\"cpp\":{\"title\":\"Creative Partners Program (CPP)\",\"description\":\"Join the Vidu Creative Partners Program (CPP)! Be part of a vibrant creator community with exclusive perks, credits, and talent showcase opportunities.\"},\"text2audio\":{\"title\":\"AI Sound Effects\",\"description\":\"AI Generated Sound Effects: Text to Audio/Sound Effects. Exact control over duration, timing, and multiple sound overlaps!\"}},\"credits\":\"credits\",\"header\":{\"navCreate\":\"Create Video\",\"navCreations\":\"My Creations\",\"navElements\":\"My References\",\"navApi\":\"API\",\"navCreativePartnerProgram\":\"Creative Partner Program\",\"navCpp\":\"CPP\",\"navLogin\":\"Sign in\",\"navHome\":\"Try Vidu\",\"modelSelection\":{\"label\":\"Model selection:\",\"OptionDescription1_5\":\"Precise prompts and dynamic generation.\",\"OptionDescription2_0\":\"Fastest generation speed with more stable visuals.\",\"OptionDescription3_0\":\"High Quality.\",\"autoSwitchTo1_5\":\"Switched to Vidu 1.5.\",\"autoSwitchTo2_0\":\"Switched to Vidu 2.0.\"},\"tabs\":{\"features\":{\"label\":\"Features\",\"reference\":\"Reference to Video\",\"image\":\"Image to Video\",\"text\":\"Text to Video\"},\"templates\":{\"label\":\"Templates\"},\"pricing\":{\"label\":\"Pricing\"},\"joinDiscord\":{\"label\":\"Join Discord\"},\"api\":{\"label\":\"API\"},\"community\":{\"label\":\"Join Community\",\"weChat\":\"Join WeChat\"},\"support\":{\"label\":\"Support\",\"helpCenter\":\"Help Center\",\"tutorial\":\"Tutorial\",\"blog\":\"Blog\"}}},\"sidebar\":{\"home\":\"Home\",\"explore\":\"Explore\",\"back\":\"Back\",\"tools\":\"TOOLS\",\"toolsItems\":{\"textToVideo\":\"Text to Video\",\"imageToVideo\":\"Image to Video\",\"referenceToVideo\":\"Reference to Video\"},\"lab\":\"LAB\",\"labItems\":{\"templates\":\"Templates\",\"text2audio\":\"AI Sound Effects\"},\"assets\":\"ASSETS\",\"assetsItems\":{\"creations\":\"My Creations\",\"elements\":\"My References\"},\"system\":\"SYSTEM\",\"systemItems\":{\"notification\":\"Notification\",\"logout\":\"Logout\",\"language\":\"Language\",\"chineseOption\":\"Chinese\",\"englishOption\":\"English\",\"cancel\":\"Cancel\",\"confirm\":\"Confirm\"},\"service\":\"SERVICE\",\"serviceItems\":{\"api\":\"API\"},\"loginOut\":\"Log out\",\"inviteFriends\":\"Invite Friends\",\"terms\":\"Terms of Use\",\"privacy\":\"Privacy Policy\",\"serviceEmail\":\"Service Email: support@vidu.cn\"},\"personal\":{\"profile\":\"Profile\",\"logout\":\"Logout\",\"subscribe\":\"Subscribe\",\"help\":\"Help Center\",\"feedback\":\"Feedback \u0026 Support\",\"delete\":{\"label\":\"Delete Account\",\"description\":\"Deleting your account will permanently remove all of your creations and can not be undone.\",\"button\":\"Delete My Account\"},\"basicInformation\":\"Basic Information\",\"accountInformation\":\"Account Information\",\"avatar\":\"Avatar\",\"avatarDialog\":{\"edit\":\"Edit Image\",\"cancel\":\"Cancel\",\"confirm\":\"Confirm\",\"success\":\"success\",\"error\":\"Not approved. Please upload a new one.\"},\"save\":\"Save\",\"edit\":\"Edit\",\"username\":{\"label\":\"Username\",\"note\":\"Please input 4-30 valid characters (English letters, hyphen, underscore, or numbers)\",\"lengthError\":\"Username needs to be between 4 and 30 characters.\",\"formatError\":\"Username must contain only letters, numbers, and special characters\",\"requiredError\":\"Username is required\",\"info\":\"Username can be changed up to 3 times within 7 days.\",\"success\":\"Saved\",\"error\":\"Not approved. Please upload a new one.\",\"dialogTitle\":\"Save Username\",\"dialogDescription\":\"Are you sure you want to save the changes?\"},\"bio\":{\"label\":\"Bio\",\"note\":\"Please input 1-100 valid characters (English letters, hyphen, underscore, or numbers)\",\"lengthError\":\"Bio is limited to 100 characters.\",\"formatError\":\"Bio must contain only letters, numbers, and special characters\",\"requiredError\":\"Bio is required\",\"success\":\"Saved\",\"error\":\"Not approved. Please upload a new one.\",\"info\":\"Bio can be changed up to 3 times within 7 days.\",\"dialogTitle\":\"Save Bio\",\"dialogDescription\":\"Are you sure you want to save the changes?\"},\"email\":{\"label\":\"Email\",\"note\":\"The email address used to sign up for Vidu.\"},\"phone\":{\"label\":\"Phone\",\"note\":\"The phone number used to sign up for Vidu.\"},\"version\":\"Version\",\"anon\":\"an\",\"freeCredits\":\"Earn point\"},\"login\":{\"title\":\"Log in or sign up for free!\",\"slogan\":\"What you imagine is what Vidu\",\"footer\":\"By using Vidu, you agree to the \u003cterm\u003eTerms of Use\u003c/term\u003e and \u003cprivacy\u003ePrivacy Policy\u003c/privacy\u003e.\",\"consentMarketingMsg\":\"I agree to receive general updates and product offers from Vidu via email.\",\"login\":\"Login/Register\",\"next\":\"Next\",\"confirm\":\"Confirm\",\"chromeLogin\":\"Continue with Google\",\"googleLoginWarning\":\"WeChat browser does not support Google login, please use another browser or choose another login method.\",\"emailLogin\":\"Continue with Email\",\"phoneLogin\":\"Continue with Phone\",\"emailPlaceholder\":\"Email address\",\"phonePlaceholder\":\"Phone number\",\"invitationNoticePc\":\"Nice to meet you! Your were invited by @{user}\",\"invitationNoticeMobile\":\"Your were invited by @{user}\",\"visitorMode\":\"Visitor Login\",\"code\":{\"title\":\"Verification Code\",\"subtitle\":\"We sent a verification code to {identity}. Please enter the code below.\",\"button\":\"Resend Code\",\"tip\":\"Haven't received a verification code?\"},\"inviteCode\":{\"title\":\"Invite Code\",\"entrance\":\"Register with invitation code\",\"placeholder\":\"Invite code\"},\"error\":{\"unknownError\":\"Error while signing in.\",\"sendVerifyCodeError\":\"Failed to send verification code, please try again in 1 minute.\",\"codeInvalid\":\"Invalid verification code.\",\"emailInvalid\":\"Please enter the correct email address.\",\"phoneInvalid\":\"Please enter the correct phone number.\",\"resendExceeded\":\"You're making requests too quickly. Please try again in 3 minutes. Thanks for your patience!\",\"banedUser\":\"You have been blacklisted. If you have any questions, please contact us at support@vidu.studio.\",\"emailDomainDisabled\":\"Sorry, this email address is not supported for registration. Please try again with a different email address\",\"emailAliasNotSupport\":\"Sorry, email aliases are not supported for registration. Please try again with your primary email address\",\"googleLoginError\":\"Google login failed. Please try again later.\",\"identityInvalid\":\"The {identityType} is invalid, please go back and revise.\",\"network\":\"Network error.\",\"captchaError\":\"Captcha error.\",\"inviteCodeInvalid\":\"Invitation code error or expired.\"}},\"home3\":{\"heroSection\":{\"navLogin\":\"Sign in\",\"navHome\":\"Try Vidu\",\"slogan\":\"What you imagine is what Vidu\",\"release\":\"New Release\",\"description\":\"Experience advanced comprehension, cinematic visuals, smooth 24fps motion, and the ability to generate 5-second videos.\",\"ios\":\"ios\",\"android\":\"Andriod\",\"viduQ1\":\"Vidu Q1\",\"createButton\":\"Create\"},\"viduAbility\":{\"reference\":{\"title\":\"Reference to Video\",\"description\":\"Create videos that align with reference subjects, such as characters, objects, and scenes. \",\"multiReference\":\"Multi-Reference Consistency\",\"mltReDesc\":\"Keep people, objects, and scenes consistent throughout your video by uploading up to 7 images.\",\"themeLibrary\":\"My References\",\"themeLibraryDesc\":\"Save characters, props, and scenes in My References for effortless reuse.\",\"button\":\"Coming Soon\",\"button2\":\"Get Started\"},\"image\":{\"title\":\"Image to Video\",\"description\":\"Bring still images to life with dynamic motion that aligns with your vision.\",\"setFirst\":\"First \u0026 Last Frames Control\",\"setFirstReDesc\":\"Upload the first and last frame images, and Vidu AI will create smooth transitions in between.\",\"animeArt\":\"Anime Art to Video\",\"animeArtDesc\":\"Transform anime art into fluid animations with lifelike character motions.\",\"button\":\"Get Started\"}},\"whyVidu\":{\"title\":\"Why Choose Vidu?\",\"description\":\"Vidu AI Video Generator delivers what others can't - trusted by millions worldwide.\",\"instant\":\"Instant Video\",\"creation\":\"Creation\",\"instantDesc\":\"Generate videos in just 10 seconds—fast, effortless, and efficient.\",\"superiorAnime\":\"Superior Anime\",\"generation\":\"Generation\",\"generationDesc\":\"Create high-quality anime videos with natural character animation.\",\"unlimitedFree\":\"Unlimited Free\",\"credits\":\"Generation\",\"creditsDesc\":\"Enjoy unlimited free video creation in Non-Peak Mode—no credits required.\"},\"aiTemplate\":{\"title\":\"Templates for Everyone\",\"description\":\"Use Vidu's templates to create fun, viral videos—whether it's kissing, hugging, blossom effects, AI outfits, and more.\",\"exploreMore\":\"Create Now\"},\"scene\":{\"title\":\"Create Videos with Vidu for\",\"anime\":\"Anime\",\"advertising\":\"Advertising\",\"socialMedia\":\"Social Media\",\"graphicDesign\":\"Graphic Design\",\"cultureTourism\":\"Culture \u0026 Tourism\",\"film\":\"Film\"},\"joinOur\":{\"title\":\"Join Our\",\"subTitle\":\"Community\",\"description\":\"Millions of anime fans, AI video creators, and short video makers use Vidu. Join the Vidu community to explore more creations and get inspired by others.\",\"joinDiscord\":\"Join Discord\",\"joinWechat\":\"加入微信群\",\"applyForCPP\":\"Apply for CPP\"},\"creators\":{\"title\":\"What Do Creators Say\",\"subTitle\":\"About Vidu AI\"},\"questions\":{\"title\":\"Frequently Asked Questions\",\"description\":\"Find answers to common questions about Vidu AI, including its features, usage, pricing, safety, and how to get support.\",\"question1\":\"What is Vidu?\",\"answer1\":{\"item1\":\"Vidu is a cutting-edge AI video generator that transforms text and images into high-quality videos, supporting multiple creation modes: Text to Video, Image to Video, and Reference to Video. Designed for independent creators and teams, Vidu simplifies the production of high-quality videos, 2D animations, and diverse artistic styles, empowering users to bring their creative visions to life effortlessly.\",\"item2\":\"With robust semantic understanding and fast generation speed, Vidu eliminates production complexities, allowing creators to focus solely on their ideas. From low resolution to stunning 1080p outputs, Vidu offers unmatched flexibility and efficiency, providing a broader canvas for creativity.\"},\"question2\":\"What is the use of Vidu AI?\",\"answer2\":{\"item1\":\"Vidu AI is a powerful tool for creating high-quality AI-generated videos with exceptional consistency and fast generation speed. It is widely used across various industries, from social media content creation to professional video production and commercial advertising. \",\"item2\":\"Many creators use Vidu AI to produce viral videos like kissing, hugging, or fighting clips.\",\"item3\":\"Film studios and animation teams leverage it for studio-level 2D animations and cinematic content. \",\"item4\":\"Businesses also use Vidu AI to enhance marketing videos, such as image-to-video to animate product images or reference-to-video to change ad backgrounds, making video advertisements more dynamic and engaging.\",\"item5\":\"With its advanced AI capabilities, Vidu AI streamlines video production for creators, studios, and businesses.\"},\"question3\":\"What's the difference between Vidu's Reference to Video and Image to Video?\",\"answer3\":{\"item1\":\"Image to Video:\",\"item2\":\"Vidu's Image-to-Video feature allows users to create AI-generated videos from a static image, bringing them to life with motion and animation. Users can also set the first and last frames of their AI video. It streamlines the video or animation creation process—often leading to surprising and creative results.\",\"item3\":\"Reference to Video:\",\"item4\":\"Reference to Video lets users upload three or more images of an object, character, or scene as references, and Vidu can combine elements into a seamless video based on a prompt. Vidu's Reference to Video also supports uploading different angles of a character or object to ensure consistency. Vidu also offers the My References feature, allowing users to save characters, props, and scenes for effortless reuse, enhancing both creative efficiency and video quality. This feature is ideal for maintaining consistency and seamlessly generating videos that blend multiple visual references.\"},\"question4\":\"Is Vidu AI free to use?\",\"answer4\":{\"item1\":\"All users receive a set amount of free credits to generate videos at no cost.\"},\"question5\":\"Is Vidu AI safe to use?\",\"answer5\":{\"item1\":\"Yes, Vidu AI is completely safe to use. We prioritize user data security and privacy, ensuring all uploaded content remains confidential. Vidu does not use user-uploaded data for AI training, nor do we share or leak personal information. Our system is designed with robust security measures to protect your data at all times.\"},\"question6\":\"How can I reach out if I have more questions about Vidu?\",\"answer6\":{\"item1\":\"If you have additional questions about Vidu, you can:\",\"item2\":\"Join our Discord community at \u003clink\u003ehttps://discord.gg/3pDU8fmQ8Y\u003c/link\u003e to connect with our team and other users for real-time support and updates.\",\"item3\":\"Visit our \u003cspan\u003eHelp Center\u003c/span\u003e for answers and support.\"}},\"footer\":{\"title\":\"What you imagine is what Vidu.\",\"buttonTip\":\"Free Your Creativity\",\"button\":\"Try it now\",\"function\":{\"title\":\"GET STARTED\",\"reference\":\"Reference to Video\",\"image\":\"Image to Video\",\"text\":\"Text to Video\"},\"tools\":{\"title\":\"AI TOOLS\",\"ai-video-generator\":\"AI Video Generator\",\"ai-animation-generator\":\"AI Animation Generator\",\"ai-image-animator\":\"AI Image Animator\",\"ai-ad-generator\":\"AI Video Ad Generator\",\"ai-hug-generator\":\"AI Hug Generator\",\"ai-kissing-generator\":\"AI Kissing Generator\",\"viewAll\":\"View All\"},\"product\":{\"title\":\"PRODUCT\",\"api\":\"API\",\"help\":\"Help Center\",\"blog\":\"Blog\",\"cpp\":\"Creative Partner Program\"},\"enterprise\":{\"title\":\"For Enterprise\",\"api\":\"API\"},\"company\":{\"title\":\"COMPANY\",\"about\":\"About Us\",\"contact\":\"Contact Us: support@vidu.com\",\"creative\":\"Creative Partner Program\"},\"contact\":{\"title\":\"\"},\"support\":{\"title\":\"Support\",\"help\":\"Help Center\",\"tutorial\":\"Tutorials\"},\"privacy\":\"Privacy Policy\",\"terms\":\"Terms of Use\",\"copyright\":\"Copyright © 2025 Vidu®\"}},\"home\":{\"create_entry\":{\"reference\":{\"title\":\"Reference to Video\",\"description\":\"Generate videos with multi-reference consistency\",\"button\":\"Try it now\"},\"image\":{\"title\":\"Image to Video\",\"description\":\"Transform static images into vibrant videos\",\"button\":\"Create\"},\"text\":{\"title\":\"Text to Video\",\"description\":\"Type ideas and bring them to life\",\"button\":\"Create\"},\"audio\":{\"title\":\"AI Sound Effect\",\"description\":\"Exact control over duration, timing, and multiple sound overlaps\",\"tag\":\"Beta\"}},\"inspiration\":{\"title\":\"Inspiration\"},\"short_film\":{\"title\":\"Short Films\"},\"explore\":{\"title\":\"Explore\",\"templateButton\":\"Use Template\",\"promptButton\":\"Recreate\",\"empty\":\"Nothing to show here... yet!\"},\"tutorials\":{\"title\":\"Tutorials\"},\"more\":\"More\",\"submit\":\"Submit\",\"templates\":{\"title\":\"Templates\"}},\"templates\":{\"title\":\"Templates\",\"button\":\"Create\",\"inviteFriends\":\"Earn Credits by Invite Friends\"},\"text2audio\":{\"title\":\"AI Sound Effects\",\"userGuide\":\"User Guide\",\"description\":\"Exact control over duration, timing, and multiple sound overlaps\",\"timestampTextArea\":{\"placeholder\":\"Think it, time it, hear it! 🎧 Just tell us the sound and when—like [1s-4s] Raindrops on rooftop. We’ll handle the rest!\",\"timestamp\":\"Timestamp\",\"sample\":\"Sample\",\"timestampTip\":\"Timestamps: Control each sound’s start, end, and duration to the second.\",\"invalidCharacter\":\"Symbols are not supported for now~\",\"segmentLimitExceeded\":\"Shorter prompts work better.Keep it under {limit} characters.\",\"totalLimitExceeded\":\"Shorter prompts work better.Keep it under {limit} characters.\",\"timestampLimit\":\"Timing is limited to {limit} seconds for now!\",\"startTimeLaterEndTime\":\"The start time cannot be later than the end time.\",\"endTimeOverEarlierTime\":\"The end time cannot be earlier than the start time.\",\"startTimeOverDuration\":\"Keep the start time under {limit} seconds.\",\"endTimeEqualZero\":\"The end time should be at least 1 second longer.\"},\"timelineEditor\":{\"title\":\"Sets total duration\",\"fillPrompt\":\"Add a timestamp track\",\"intervalTooShort\":\"Better results with intervals over {limit}s\"},\"create\":{\"noPrompt\":\"Please input prompt\",\"timestampOutOfRange\":\"Please keep the timestamps within the total duration.\",\"timestampOverTip\":\"The number of timestamps may be too high. Around 5 is ideal.\",\"timeTagNoPrompt\":\"Some timestamps are missing prompts. Please add prompts or remove the timestamps.\",\"promptNoTimeTag\":\"Please match each prompt a timestamp for better result, e.g., 01s-04s: raining.\"}},\"popup\":{\"dialog\":{\"delete\":{\"creation\":{\"title\":\"Delete video\",\"text2audioTitle\":\"Delete audio\",\"content\":\"Permanently delete this result? This action cannot be undone.\",\"text2audioContent\":\"Permanently delete this audio? This action cannot be undone.\"},\"task\":{\"title\":\"Delete task\",\"content\":\"Permanently delete this task? This action cannot be undone.\"},\"confirm\":\"Delete\",\"cancel\":\"Cancel\"},\"deleteUser\":{\"title\":\"We are sorry to see you go :(\",\"description\":\"All creations and data associated with this account will be deleted, and there is no way to recover, would you like to proceed?\",\"confirm\":\"Confirm Delete\",\"cancel\":\"Cancel\"},\"feedback\":{\"title\":\"Feedback\",\"optionPoor\":\"Poor video quality\",\"optionInaccurate\":\"Inaccurate semantic understanding\",\"optionUncomfortable\":\"The generated video makes people uncomfortable\",\"optionUnnatural\":\"Actions in the video are unnatural\",\"placeholder\":\"Please describe the issue. (You can click the button above for quick entry.)\",\"confirm\":\"Submit\",\"cancel\":\"Cancel\"},\"share\":{\"title\":\"Share Video\",\"text2audioTitle\":\"Share Audio\",\"content\":\"Anyone with this \u003clink\u003elink\u003c/link\u003e will be able to view your video and input.\",\"text2audioContent\":\"Anyone with this \u003clink\u003elink\u003c/link\u003e will be able to view your audio and input.\",\"shareUrlFailed\":\"Failed to get share link, please try again later\",\"copy\":\"Copy link\",\"cancel\":\"Cancel\",\"ok\":\"Okay\"},\"upscale\":{\"title\":\"Upscale\",\"content\":\"Are you sure you want to upgrade the video quality?\",\"confirm\":\"Confirm\",\"cancel\":\"Cancel\"},\"purchaseCredits\":{\"myCredits\":\"My Credits\",\"title\":\"Credits Purchase\",\"empty\":\"Oops! No available products\",\"credits\":\"Credits\",\"total\":\"Total\",\"symbol\":\"$$\",\"pay\":\"Pay Now\",\"description\":\"* Credits are valid for 2 years from purchase\\n* They cannnot be redeemed for membership, transferred, withdrawn, returned, or converted to real-world currencies.\"},\"error\":{\"confirm\":\"Okay\",\"checkPlan\":\"Check Plans\",\"unknownError\":{\"title\":\"Error\",\"content\":\"An unknown error occurred. Please try again later.\"},\"creditsInsufficient\":{\"title\":\"Credits Exhausted\",\"content\":\"You've used all your monthly credits on this plan.\\nIt’s great to see you’ve enjoyed using our product and found it useful! Would you be open to considering an upgrade?\\n\\nHere’s what comes with an upgrade:\\n\u003cul\u003e\u003cli\u003eA lot more credits monthly\u003c/li\u003e\u003cli\u003eHigh-resolution video generation\u003c/li\u003e\u003cli\u003e8s video generation\u003c/li\u003e\u003cli\u003ePriority processing\u003c/li\u003e\u003cli\u003eNo more watermarks\u003c/li\u003e\u003c/ul\u003e\"},\"creditsInsufficientForSubs\":{\"title\":\"Insufficient Credits\",\"content\":\"Your credits are insufficient at the moment. Please purchase more credits.\"},\"SubsplanNotSupportedForTask\":{\"title\":\"Upgrade Needed\",\"content\":\"{feature} video generation is not available in the free plan. Would you be open to considering an upgrade?\\n\\nHere’s what comes with an upgrade:\\n\u003cul\u003e\u003cli\u003e800+ credits monthly\u003c/li\u003e\u003cli\u003eHigh-resolution video generation\u003c/li\u003e\u003cli\u003e8s video generation\u003c/li\u003e\u003cli\u003ePriority processing\u003c/li\u003e\u003cli\u003eNo more watermarks\u003c/li\u003e\u003c/ul\u003e\"},\"SubsplanNotSupportedForTaskForSubs\":{\"title\":\"Feature Not Included\",\"content\":\"{feature} video generation is not included in your current subscription plan.\"},\"checkFailed\":{\"title\":\"Review Failed\",\"content\":\"This input may violate our content policy. Please revise and try again.\"},\"checkFailedExceeded\":{\"title\":\"Failed to pass review\",\"content\":\"Multiple violations of our content policy detected. Please try again {time}.\"},\"checkFailedExceededForSubs\":{\"title\":\"Failed to pass review\",\"content\":\"Multiple violations of our content policy detected.  If you continue to break the rules, your subscription will be cancelled, and you will be unable to use your remaining credits. Please try again {time}.\"},\"extendCountExceeded\":{\"title\":\"Extend Limit Exceeded\",\"content\":\"The video cannot be extended for over 5 minutes.\"},\"system\":{\"title\":\"System Error\",\"content\":\"Our engineers are upgrading the system. Please try again later.\"},\"systemThrottlingForSubs\":{\"title\":\"Task Limit Exceeded\",\"content\":\"Sorry, the product is extremely popular, the server load has reached its limit. Please try again later.\"},\"systemThrottling\":{\"title\":\"Server Overload for Free Users\",\"content\":\"We’re growing faster than ever, and our servers are struggling to keep up. As a startup, we regret that continuing to add servers is not financially sustainable.\\n\\nTo skip the wait, you can subscribe to a paid plan. Here’s what you’ll get:\\n\u003cul\u003e\u003cli\u003eInstant generation\u003c/li\u003e\u003cli\u003e800+ credits monthly\u003c/li\u003e\u003cli\u003e8-second videos\u003c/li\u003e\u003cli\u003eNo more watermarks\u003c/li\u003e\u003c/ul\u003e\"},\"shouldUpgrade\":{\"mode\":{\"title\":\"Upgrade Needed\",\"content\":\"High-resolution generation is not available in the free plan. Would you be open to considering an upgrade?\\n\\nHere’s what comes with an upgrade:\\n\u003cul\u003e\u003cli\u003eHigh-resolution video generation\u003c/li\u003e\u003cli\u003e8s video generation\u003c/li\u003e\u003cli\u003ePriority processing\u003c/li\u003e\u003cli\u003e800+ credits monthly\u003c/li\u003e\u003cli\u003eNo more watermarks\u003c/li\u003e\u003c/ul\u003e\"},\"resolution\":{\"title\":\"Upgrade Needed\",\"content\":\"High-resolution generation is not available in the free plan. Would you be open to considering an upgrade?\\n\\nHere’s what comes with an upgrade:\\n\u003cul\u003e\u003cli\u003eHigh-resolution video generation\u003c/li\u003e\u003cli\u003e8s video generation\u003c/li\u003e\u003cli\u003ePriority processing\u003c/li\u003e\u003cli\u003e800+ credits monthly\u003c/li\u003e\u003cli\u003eNo more watermarks\u003c/li\u003e\u003c/ul\u003e\"},\"duration\":{\"title\":\"Upgrade Needed\",\"content\":\"8s video generation is not available in the free plan. Would you be open to considering an upgrade?\\n\\nHere’s what comes with an upgrade:\\n\u003cul\u003e\u003cli\u003e8s video generation\u003c/li\u003e\u003cli\u003ePriority processing\u003c/li\u003e\u003cli\u003eHigh-resolution video generation\u003c/li\u003e\u003cli\u003e800+ credits monthly\u003c/li\u003e\u003cli\u003eNo more watermarks\u003c/li\u003e\u003c/ul\u003e\"}},\"freeTrialEnd\":{\"title\":\"Your Limited Trial Has Ended!\",\"content\":\"Thank you for trying our 720p HD video generation model. Your trial opportunities have been used up. Ready to continue creating high-quality videos?\\n\\nUpgrade now and unlock these features:\\n\u003cul\u003e\u003cli\u003eHigh-resolution video generation\u003c/li\u003e\u003cli\u003e8s video creation\u003c/li\u003e\u003cli\u003ePriority processing\u003c/li\u003e\u003cli\u003e800+ monthly credits\u003c/li\u003e\u003cli\u003eNo watermarks\u003c/li\u003e\u003c/ul\u003e\"},\"fieldInvalid\":{\"title\":\"Invalid Input\",\"content\":\"Please check your input and try again.\"},\"elementDeleted\":{\"title\":\"Reference Deleted\",\"content\":\"Reference deleted. Its information is no longer available.\"}},\"notifications\":{\"ok\":\"Got it\"},\"referenceDialog\":{\"title\":\"Introducing My References\",\"description\":\"Save characters, props, and scenes in My References for effortless reuse, enhancing both your creative efficiency and video quality\",\"button\":\"Try Now\"},\"apiDialog\":{\"title\":\"Vidu \u003chighlight\u003eAPI\u003c/highlight\u003e Platform Officially Launched!\",\"description\":\"\u003cp\u003eDear Vidu Creators, \u003c/p\u003e\u003cp\u003eThe Vidu API is now live! With our fastest and most creative video generation model, endless possibilities await for your product development:\u003c/p\u003e\u003cul\u003e\u003cli\u003eSupports all models, including Vidu 2.0.\u003c/li\u003e\u003cli\u003eOffers a variety of specially optimized template APIs, including AI Hug, Valentine's Day effects, and more.\u003c/li\u003e\u003c/ul\u003e\",\"building\":\"Start Building\"},\"posts\":{\"title\":\"Submit\",\"confirm\":\"Confirm\",\"cancel\":\"Cancel\",\"inspiration\":\"Inspiration\",\"shortFilm\":\"Short Film\",\"creations\":\"Creations\",\"favorite\":\"Favorites\",\"inspirationPlaceholder\":\"Add a description\",\"socialMediaLink\":\"If published on social media, youcan paste the link\",\"shortFilmTitle\":\"Enter a title\",\"shortFilmPlaceholder\":\"Add a description\",\"clickToUpload\":\"Click to upload your video\",\"uploadTip\":\"MP4, up to {durationLimit} min, max {sizeLimit}MB\",\"uploading\":\"Uploading...\",\"success\":\"Submission successful! Waiting for review. Approved submissions may be featured in Explore.\",\"failed\":\"System failed. Please try again later.\",\"notAvailable\":\"No creations to submit at the moment\",\"notFavorite\":\"No favorite creations yet\",\"uploadCover\":\"Upload cover\",\"uploadCoverTip\":\"JPG, PNG, WEBP, max {sizeLimit}MB\",\"error\":{\"default\":\"Submission failed. Please try again later.\",\"workDuplicateSubmission\":\"You have already submitted this work. Please try again with a different work.\",\"activityNotAllowSubmit\":\"The activity is not allowed to submit. Please try again later.\"}}},\"toast\":{\"networkError\":\"Network error.\",\"abortError\":\"Request was unexpectedly interrupted, please try again later.\",\"fetchError\":\"Failed to fetch data.\",\"taskNotFound\":\"Task not found.\",\"creationNotFound\":\"Creation not found.\",\"subscriptionNotFound\":\"Subscription not found.\",\"systemError\":\"System error, please try again later\",\"deleteSuccess\":\"Deleted successfully\",\"deleteFailed\":\"Failed to deleted, please try again later\",\"cancelSuccess\":\"The task has been canceled, and the credits have been returned.\",\"cancelFailedDueToProcessing\":\"Task cancellation failed. Video generation is in progress.\",\"cancelFailedOther\":\"Task cancellation failed.\",\"feedbackSuccess\":\"Submitted successfully. Thanks for your feedback.\",\"feedbackFailed\":\"Failed to submit, please try again later\",\"copySuccess\":\"Copied successfully\",\"copyFailed\":\"Failed to copy, please try again later\",\"wrongTaskType\":\"Invalid task type\",\"signOutError\":\"Something went wrong with sign out\",\"deleteUserError\":\"Something went wrong with delete user\",\"uploadingError\":\"Uploading failed, please try again later\",\"operationFailed\":\"Operation failed, please try again later\",\"taskCountExceeded\":\"You’ve reached the maximum number of concurrent tasks. Please complete  existing tasks before submitting a new one.\",\"tooManyRequests\":\"The beta test is booming! Give it another shot later. 🚀🔥\",\"invalidSetting\":\"Some options aren't in your plan. We've switched to available ones\",\"captchaError\":\"Captcha verification failed, please try again later.\",\"textUnPassed\":\"Text not approved. Please enter a new one.\",\"imgUnPassed\":\"Image not approved. Please upload a different one.\",\"textAndImgUnPassed\":\"Both text and image not approved. Please try again with new content.\",\"submitCountLimit\":\"Requests too frequent. Please try again later.\",\"inspirationNotFound\":\"Inspiration not found.\",\"inspirationHadSubmitted\":\"Inspiration had submitted.\",\"updateOverLimit\":\"You’ve reached the limit (3 times in 7 days). Try again later.\",\"profileUpdateClosed\":\"Modifications are not supported yet. Please try again later.\"}},\"creation\":{\"action