    <style media="(max-width: 1024px)">
        @media screen and (max-width: 1024px) {
            .header::before {
                display: none;
            }

            .base-block {
                margin-top: 32px;
                padding: 0px 32px;
            }

            .header {
                position: fixed;
                left: 0;
                top: 0;
                min-height: 56px;
                padding: 0px 8px;
            }

            .header-mobile-buttons-wrapper {
                display: flex;
                gap: 0 20px;
            }

            .header-wrapper {
                position: relative;
                height: 56px;
            }

            .header-logo {
                height: 24px;
            }

            .header-logo img {
                height: 24px;
                width: 158px;
            }

            .header-burger-button {
                display: flex;
                position: relative;
                width: 40px;
                height: 40px;
                justify-content: center;
                align-items: center;
