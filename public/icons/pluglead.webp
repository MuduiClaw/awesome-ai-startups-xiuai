    <script type="text/javascript">
  var acc = document.getElementsByClassName("accordion");
var i;

for (i = 0; i < acc.length; i++) {
  acc[i].addEventListener("click", function() {
    this.classList.toggle("active");
    var panel = this.nextElementSibling;
    if (panel.style.maxHeight) {
      panel.style.maxHeight = null;
    } else {
      panel.style.maxHeight = panel.scrollHeight + "px";
    }
  });
}
</script>

<script>
function myFunction() {
  var x = document.getElementById("myDIV");
  if (x.style.display === "block") {
    x.style.display = "none";
  } else {
    x.style.display = "block";
  }
}
</script>
    <style>
      /* Style the buttons that are used to open and close the accordion panel */
#rd-text-lvmw9exk{
font-weight:900 !important;   
}
.accordion {
  background-color: #031827;
  color: #fff;
  font-size:18px;
  cursor: pointer;
  padding: 24px;
  width: 100%;
  text-align: left;
  border: none;
  outline: none;
  transition: 0.4s;
  border-radius:16px;
}

/* Add a background color to the button if it is clicked on (add the .active class with JS), and when you move the mouse over it (hover) */
.active, .accordion:hover {
  background-color: #062e4a;
}

/* Style the accordion panel. Note: hidden by default */
.panel {
  margin-top:16px;
  text-align:right;
  padding: 0 40px;
  background-color: #786cf8;
  color:#fff;
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.2s ease-out;
  border-radius:16px;
}

.accordion:after {
  content: '\02795'; /* Unicode character for "plus" sign (+) */
  font-size: 14px;
  color: #0b4f7e !important;
  float: right;
  margin-left: 5px;
}

.active:after {
  content: "\2796"; /* Unicode character for "minus" sign (-) */
}

/* Table */
.features {
  margin: 0 auto;
  border-collapse: collapse;
  font-family: sans-serif;
}

.features__cell {
  background-color: #fff;
  max-width: 640px;
  font-size: 0.9em;
  font-weight: normal;
  padding: 1em 1em;
  color: #000;
  border-bottom: 1px solid #e5edfb;
  line-height: 2;
  text-align: left;
  font-size: 16px;
}

.features__cell--bold {
  font-weight: bold;
}

.features__cell--shaded {
  background: #e5edfb;
}

.features__cell--large {
  font-size: 1.25em;
}

.features__cell--center {
  text-align: center;
}

.features__tick::after {
  content: "\2714";
  font-size: 1.5em;
  color: blueviolet;
}

button{
  margin: auto;
  display: block;
  background-color:#e5edfb;
  padding: 1em 1em;
  border-radius: 8px;
  font-size:18px;
  border:none; margin: 0 auto;
  font-family: 'Cabin';
  font-size: 18px;
}

#myDIV {
  width: 100%;
  padding: 50px 0;
  text-align: center;
  margin-top: 20px;
  display:none;
}
