        // JavaScript function to validate the input as the user types
        function validateInput1() {
            var password = document.getElementById("password1").value;
            var confirmPassword = document.getElementById("cpassword1").value;
            var submitButton = document.getElementById("submitBtn");
            if (password !== confirmPassword) {
                //alert("Password and Confirm Password do not match!");
                $('#paymentResponse').html('Password and Confirm Password do not match!');
                submitButton.disabled = true;
                return false;
                
                
            }
            else{
                submitButton.disabled = false;
                $('#paymentResponse').html('');
            }
            return true;
        }
        </script>
