ic%2Fmedia%2Ftestimonial-mserro27.defa6f11.png&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Ftestimonial-mserro27.defa6f11.png&amp;w=96&amp;q=75"/></div><div><div class="text-sm font-medium text-base-content">Marie S.</div><div class="mt-1 text-sm text-base-content-secondary">@<!-- -->mserro27</div></div></figcaption></figure></li></ul><ul role="list" class="flex flex-col gap-y-6 sm:gap-y-8"><li><figure class="relative h-full p-6 bg-base-100 rounded-lg"><blockquote class="relative"><p class="text-sm text-base-content-secondary">I used it for 3 months now, and it does bring the convenience of building a nice looking landing page easier. It operates faster than the conventional WordPress.</p></blockquote><figcaption class="relative flex items-center justify-start gap-4 pt-4 mt-4 border-t border-base-content/10"><div class="overflow-hidden rounded-full bg-base-300 shrink-0"><img alt="Crypto Boba&#x27;s testimonial for MakeLanding" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="w-10 h-10 rounded-full object-cover" style="color:transparent" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Ftestimonial-crypto.7f829faf.jpeg&amp;w=48&amp;q=75 1x, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Ftestimonial-crypto.7f829faf.jpeg&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Ftestimonial-crypto.7f829faf.jpeg&amp;w=96&amp;q=75"/></div><div class="w-full flex items-end justify-between gap-2"><div><div class="text-sm font-medium text-base-content">Crypto Boba</div><div class="mt-0.5 text-sm text-base-content-secondary">@<!-- -->crypto_boba</div></div><a href="https://www.producthunt.com/products/landing-ai?comment=2398332#landing-ai" target="_blank" class="shrink-0 " aria-label="See user review on Product Hunt"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 26.245 26.256" class="w-[18px] h-[18px]"><path d="M26.254 13.128c0 7.253-5.875 13.128-13.128 13.128S-.003 20.382-.003 13.128 5.872 0 13.125 0