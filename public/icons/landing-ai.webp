 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/80"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path></svg><span>150 pages per month</span></li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/80"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path></svg><span>∞ logos</span></li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/80"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path></svg><span>∞ illustrations</span></li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/80"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path></svg><span>∞ copywriting</span></li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/80"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path></svg><span>Link to share</span></li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/80"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path></svg><span><p><span class="flex items-center" data-tooltip-id="tooltip" data-tooltip-content="Edit all the content: text, images, colors, fonts, etc. You can also add new sections, generate illustrations with AI, but much simpler!">Site editor<!-- --> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/60 hover:text-base-content m-0.5"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd"></path></svg></span></p></span></li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/80"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path></svg><span>Analytics</span></li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/80"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path></svg><span><p><span class="flex items-center" data-tooltip-id="tooltip" data-tooltip-content="Generate the landing pages hosted on makelanding using our public API programmatically instead of doing manually using the user interface. Create the API key and get started!">API Access<!-- --> <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/60 hover:text-base-content m-0.5"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd"></path></svg></span></p></span></li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/80"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path></svg><span>Custom Domain</span></li><li class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 text-base-content-secondary/80"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"></path></svg><span>Customer Support</span></li></ul><div class="space-y-2"><a class="btn btn-block whitespace-nowrap btn-gradient-cold" href="/app/new">Make landing page now</a><p class="text-xs text-center text-base-content-secondary/80 font-medium">Cancel anytime.</p></div></div></div></div></section><section class="bg-base-200" id="faq"><div class="py-24 px-5 max-w-7xl mx-auto flex flex-col md:flex-row gap-12 md:gap-16"><div class="flex flex-col text-left basis-1/2"><p class="inline-block font-medium text-gradient-warm mb-4">FAQ</p><p class="sm:text-4xl text-3xl font-medium text-base-content">Frequently Asked Questions</p></div><ul class="basis-1/2"><li><button class="relative flex gap-2 items-center w-full py-5 text-base font-medium text-left border-t md:text-lg border-base-content/10" aria-expanded="false"><span class="flex-1 text-base-content ">What do I do get exactly?</span><svg class="flex-shrink-0 w-4 h-4 ml-auto fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><rect y="7" width="16" height="2" rx="1" class="transform origin-center transition duration-200 ease-out false"></rect><rect y="7" width="16" height="2" rx="1" class="transform origin-center rotate-90 transition duration-200 ease-out false"></rect></svg></button><div class="transition-all duration-300 ease-in-out text-base-content-secondary overflow-hidden" style="max-height:0;opacity:0"><div class="pb-5 leading-relaxed"><div><p>You get a fully functional landing page with a logo, favicon, illustrations, buttons and copy that sells.</p><p>You can edit the landing page. Edits include changing the copy, buttons, links, illustations. You can also add &amp; remove sections on the page.</p><p>You can have custom domain for your landing page, or use our public API to generate landing pages instead of using user interface</p><p>Once ready, you can share the MakeLanding link to your site.</p><p>Here are some sites made with MakeLanding:<!-- --> <a class="link" target="_blank" href="https://salesleadershiphacks.com/" rel="noreferrer">here</a>,<!-- --> <a class="link" target="_blank" href="https://zolamedia.nl/" rel="noreferrer">here</a>, and<!-- --> <a class="link" target="_blank" href="https://usdbong.com/" rel="noreferrer">here</a></p></div></div></div></li><li><button class="relative flex gap-2 items-center w-full py-5 text-base font-medium text-left border-t md:text-lg border-base-content/10" aria-expanded="false"><span class="flex-1 text-base-content ">I don&#x27;t want to pay upfront, can I try it first?</span><svg class="flex-shrink-0 w-4 h-4 ml-auto fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><rect y="7" width="16" height="2" rx="1" class="transform origin-center transition duration-200 ease-out false"></rect><rect y="7" width="16" height="2" rx="1" class="transform origin-center rotate-90 transition duration-200 ease-out false"></rect></svg></button><div class="transition-all duration-300 ease-in-out text-base-content-secondary overflow-hidden" style="max-height:0;opacity:0"><div class="pb-5 leading-relaxed"><div>Generative AI costs money to run. We don&#x27;t do free previews, but with the Editor Plan, you can refine the copy, upload new pictures, add/remove sections, change colors, fonts, etc... So you can build your perfect landing page!</div></div></div></li><li><button class="relative flex gap-2 items-center w-full py-5 text-base font-medium text-left border-t md:text-lg border-base-content/10" aria-expanded="false"><span class="flex-1 text-base-content ">Can I get a refund if I&#x27;m not satisfied?</span><svg class="flex-shrink-0 w-4 h-4 ml-auto fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><rect y="7" width="16" height="2" rx="1" class="transform origin-center transition duration-200 ease-out false"></rect><rect y="7" width="16" height="2" rx="1" class="transform origin-center rotate-90 transition duration-200 ease-out false"></rect></svg></button><div class="transition-all duration-300 ease-in-out text-base-content-secondary overflow-hidden" style="max-height:0;opacity:0"><div class="pb-5 leading-relaxed"><div><p>Generative AI costs money to run. We don&#x27;t offer refunds, but we happily offer credits so you can try again.</p><p>Also, you can refine the copy, upload new pictures, add/remove sections, change colors, fonts, have custom domain for your landing page, use our public API to generate landing pages, etc... So you can build your perfect landing page!</p></div></div></div></li><li><button class="relative flex gap-2 items-center w-full py-5 text-base font-medium text-left border-t md:text-lg border-base-content/10" aria-expanded="false"><span class="flex-1 text-base-content ">Can I still keep my landing pages and access them after I cancel the subscription?</span><svg class="flex-shrink-0 w-4 h-4 ml-auto fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><rect y="7" width="16" height="2" rx="1" class="transform origin-center transition duration-200 ease-out false"></rect><rect y="7" width="16" height="2" rx="1" class="transform origin-center rotate-90 transition duration-200 ease-out false"></rect></svg></button><div class="transition-all duration-300 ease-in-out text-base-content-secondary overflow-hidden" style="max-height:0;opacity:0"><div class="pb-5 leading-relaxed"><div><p> You can keep your landing pages, the landing pages won&#x27;t be deleted or anything, we&#x27;ll keep the data related to your landing pages, but you or anyone else won&#x27;t be able to access them after you cancel the subscription.</p></div></div></div></li><li><button class="relative flex gap-2 items-center w-full py-5 text-base font-medium text-left border-t md:text-lg border-base-content/10" aria-expanded="false"><span class="flex-1 text-base-content ">What language is supported?</span><svg class="flex-shrink-0 w-4 h-4 ml-auto fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><rect y="7" width="16" height="2" rx="1" class="transform origin-center transition duration-200 ease-out false"></rect><rect y="7" width="16" height="2" rx="1" class="transform origin-center rotate-90 transition duration-200 ease-out false"></rect></svg></button><div class="transition-all duration-300 ease-in-out text-base-content-secondary overflow-hidden" style="max-height:0;opacity:0"><div class="pb-5 leading-relaxed">Our Artificial Intelligence writes headlines in 50+ languages including 🇺🇸 English, 🇪🇸 Spanish, 🇨🇳 Chinese and 🇮🇳 Hindi</div></div></li><li><button class="relative flex gap-2 items-center w-full py-5 text-base font-medium text-left border-t md:text-lg border-base-content/10" aria-expanded="false"><span class="flex-1 text-base-content ">How long does it take?</span><svg class="flex-shrink-0 w-4 h-4 ml-auto fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><rect y="7" width="16" height="2" rx="1" class="transform origin-center transition duration-200 ease-out false"></rect><rect y="7" width="16" height="2" rx="1" class="transform origin-center rotate-90 transition duration-200 ease-out false"></rect></svg></button><div class="transition-all duration-300 ease-in-out text-base-content-secondary overflow-hidden" style="max-height:0;opacity:0"><div class="pb-5 leading-relaxed">Up to a minute to generate the landing page and the logo.</div></div></li><li><button class="relative flex gap-2 items-center w-full py-5 text-base font-medium text-left border-t md:text-lg border-base-content/10" aria-expanded="false"><span class="flex-1 text-base-content ">Can I reuse the content?</span><svg class="flex-shrink-0 w-4 h-4 ml-auto fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><rect y="7" width="16" height="2" rx="1" class="transform origin-center transition duration-200 ease-out false"></rect><rect y="7" width="16" height="2" rx="1" class="transform origin-center rotate-90 transition duration-200 ease-out false"></rect></svg></button><div class="transition-all duration-300 ease-in-out text-base-content-secondary overflow-hidden" style="max-height:0;opacity:0"><div class="pb-5 leading-relaxed">You have full ownership of the landing page &amp; the images generated with AI. You can even resell them.</div></div></li><li><button class="relative flex gap-2 items-center w-full py-5 text-base font-medium text-left border-t md:text-lg border-base-content/10" aria-expanded="false"><span class="flex-1 text-base-content ">What language is used for the code?</span><svg class="flex-shrink-0 w-4 h-4 ml-auto fill-current" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><rect y="7" width="16" height="2" rx="1" class="transform origin-center transition duration-200 ease-out false"></rect><rect y="7" width="16" height="2" rx="1" class="transform origin-center rotate-90 transition duration-200 ease-out false"></rect></svg></button><div class="transition-all duration-300 ease-in-out text-base-content-secondary overflow-hidden" style="max-height:0;opacity:0"><div class="pb-5 leading-relaxed">HTML, CSS (with Tailwind classes + DaisyUI) and JavaScript.</div></div></li></ul></div></section><section class="py-24 bg-base-100  sm:px-4"><div class="w-full max-w-7xl mx-auto bg-neutral sm:rounded-lg"><div class="flex flex-col justify-center items-center p-8 md:p-16 gap-8 md:gap-16"><div class="text-center"><h2 class="text-2xl md:text-3xl font-medium text-neutral-content mb-6">Launch your<!-- --> <!-- -->project<!-- --> <!-- -->today!</h2><h3 class="text-sm md:text-base text-neutral-content/80 leading-relaxed">Just write about your idea to get an entire<!-- --> <!-- --> landing page generated</h3></div><div class="w-full max-w-xl"><form class="relative w-full bg-base-transparent group"><span class="absolute inset-1 bg-gradient opacity-40 group-focus-within:opacity-80 group-focus-within:inset-0 group-hover:opacity-80 group-hover:inset-0 blur-lg duration-300 -z-1"></span><div class="relative bg-base-100 p-3 rounded-3xl outline outline-base-content/0 group-focus-within:outline-gray-300/50"><div class="flex item-center"><div class="flex-1"><input class="input input-sm md:input-md !pl-2 md:!pl-4 w-full focus:outline-none" placeholder="" required="" minLength="10" maxLength="1000" value=""/></div><button class="btn btn-sm md:btn-md btn-gradient !animate-none group-focus-within:!animate-shimmer rounded-xl shadow group-hover:shadow-lg group-focus-within:shadow-lg gap-1"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="hidden md:inline w-[18px] h-[18px]" title="Create new landing page"><path d="M15.98 1.804a1 1 0 00-1.96 0l-.24 1.192a1 1 0 01-.784.785l-1.192.238a1 1 0 000 1.962l1.192.238a1 1 0 01.785.785l.238 1.192a1 1 0 001.962 0l.238-1.192a1 1