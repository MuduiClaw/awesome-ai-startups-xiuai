#hero-emailInput:focus ~ #hero-emailForm {
    border-color: #6a00ff; /* Cambia il colore del bordo del form */
}

.widget_nav_menu{margin:0!important}

p{font-size:unset!important}

#hero-emailForm {
	transition: all 0.4s cubic-bezier(.215, .61, .355, 1);
	border:solid 2px #fff;
	border-radius:16px;
   box-shadow:
  1.9px 3.2px 5.7px rgba(90, 24, 118, 0.061),
  6.5px 10.7px 19.2px rgba(90, 24, 118, 0.089),
  29px 48px 86px rgba(90, 24, 118, 0.15)
;
}

#hero-emailForm:hover{	border:solid 2px #B692F6;}


/*  image carousel logo */


.brand-carousel .swiper-wrapper{
  -webkit-transition-timing-function: linear !important;
  transition-timing-function: linear !important; 
}


/* ELEMENTOR TAB tool section*/
/* Stile per la lista di tabs */
.custom-tabs-list .custom-tab-item {
    padding: 15px;
    cursor: pointer;
    border-left: 3px solid transparent;
    transition: all 0.3s ease;
}

/* Stile per il tab attivo *//* Stile per la lista di tabs */
.custom-tabs-list .custom-tab-item {
    padding: 15px;
    cursor: pointer;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent; /* Aggiunto per il bordo destro */
    transition: all 0.3s ease;
}

/* Stile per il tab attivo */
.custom-tabs-list .custom-tab-item.active {
    border-left: 3px solid #5D3FD3; /* Colore viola simile all'immagine */
    border-right: 3px solid #5D3FD3; /* Colore viola per il bordo destro */
    background-color: #f8f8f8;
}
.custom-tab-content {
    display: none;
}

.custom-tab-content.active {
    display: block;
}

