pacity-50 text-white hover:bg-[#7C5DFA]/90 h-10 bg-gradient-to-r from-[#7C5DFA] to-[#4A6CF7] hover:opacity-90 text-lg py-6 px-8 shadow-md">Get Started</button></a></div></div></div><a class="text-[#7C5DFA] font-semibold hover:text-[#4A6CF7] transition-colors inline-flex items-center" href="/pricing">View all pricing plans<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="w-5 h-5 ml-2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path></svg></a></div></div></section><section class="py-24 bg-neutral-50"><div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"><div class="text-center mb-16" style="opacity:0;transform:translateY(20px)"><h2 class="text-h2 text-neutral-800 mb-6">Built for those whose business is<br/>other businesses</h2><p class="text-body-lg text-neutral-600 max-w-3xl mx-auto">Whether you&#x27;re selling, sourcing, advising, or building –<br/>Kuration finds and enriches the companies that matter to your business. Faster than anything else.</p></div><div class="relative"><div class="overflow-hidden"><div class="flex transition-transform duration-500 ease-in-out"><div class="flex gap-6 min-w-full"><div class="w-[calc(33.333%-1rem)] flex-shrink-0" style="opacity:0;transform:translateY(20px)"><div class="h-full bg-white rounded-2xl shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden group relative"><div class="absolute inset-0 opacity-[0.15]" style="background-image:radial-gradient(circle at center, #705CF6 1.5px, transparent 1.5px);background-size:24px 24px"></div><div class="bg-gradient-to-br from-primary/5 to-primary/10 p-8 h-full flex flex-col relative z-10"><div class="bg-white/10 w-12 h-12 rounded-xl flex items-center justify-center mb-6"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" cl