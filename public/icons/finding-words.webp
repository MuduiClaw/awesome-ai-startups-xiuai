roup-last:from-plum-8"></div><div class="w-1 h-full bg-plum-8 absolute left-5 md:hidden group-last:hidden"></div><div class="ml-4 md:ml-4 md:mt-10 text-body-standard font-medium md:mr-14 mr-4 flex-1 ">Get immediate help with administrative tasks</div></div><div class="flex flex-row md:flex-col relative group pb-10 md:pb-0 group"><div class="bg-[#EC8270] relative text-body-standard group-hover:font-semibold z-10 rounded-full self-start w-10 h-10 flex items-center content-center justify-center group-hover:scale-150 transition-all">3</div><div class="h-1 absolute top-5 w-full hidden md:block group-last:bg-gradient-to-r bg-plum-8 group-last:bg-transparent group-last:from-plum-8"></div><div class="w-1 h-full bg-plum-8 absolute left-5 md:hidden group-last:hidden"></div><div class="ml-4 md:ml-4 md:mt-10 text-body-standard font-medium md:mr-14 mr-4 flex-1 ">Receive a personalized Care Plan tailored to your needs</div></div><div class="flex flex-row md:flex-col relative group pb-10 md:pb-0 group"><div class="bg-[#E7634C] relative text-body-standard group-hover:font-semibold z-10 rounded-full self-start w-10 h-10 flex items-center content-center justify-center group-hover:scale-150 transition-all">4</div><div class="h-1 absolute top-5 w-full hidden md:block group-last:bg-gradient-to-r bg-plum-8 group-last:bg-transparent group-last:from-plum-8"></div><div class="w-1 h-full bg-plum-8 absolute left-5 md:hidden group-last:hidden"></div><div class="ml-4 md:ml-4 md:mt-10 text-body-standard font-medium md:mr-14 mr-4 flex-1 ">Access ongoing support for emotional and logistical hurdles</div></div></div></div></div><div id="" class="relative pt-8 md:pt-12 pb-8 md:pb-12 bg-white text-plum"><div class="absolute bottom-0 w-full box-content h-1/2 bg-forest text-white"></div><div class="relative mx-auto max-w-7xl px-4 lg:px-4"><div class="rounded-2xl py-14 px-4 bg-white relative flex flex-1 overflow-hidden !px-0 !py-0 text-left text-white bg-transparent"><div class="flex w-full min-h-full f