2f0c959581fbc7aa878a30f829848e5de964897-6318x4212-png","_type":"reference"}}},{"image":{"asset":{"_ref":"image-047935a01efe5e2e561290b5f4c8d1b9b318f8b2-6318x4212-png","_type":"reference"},"_type":"image"},"_type":"logo","name":"Lemonade","_key":"dc5144ee-331e-4845-b30c-b0bfa86ee29a"},{"image":{"_type":"image","asset":{"_ref":"image-0a052eba7e05fb63611199c305e956cba5206041-360x240-png","_type":"reference"}},"_type":"logo","applyGrayscale":true,"name":"Lincoln","_key":"bd4b7c54-69ab-48bb-aa13-72aa20f1a1c0"},{"applyGrayscale":false,"name":"Aflac Logo","_key":"42fabc0a-afff-4420-b02b-f13b9bf678d8","image":{"_type":"image","asset":{"_ref":"image-5c12757ee48bdcf8eea9cde22ca0d188fe923f83-6318x4212-png","_type":"reference"}},"_type":"logo"},{"_key":"7ebbc6a9-6c03-481b-8cfa-2c3bd9945025","image":{"_type":"image","asset":{"_ref":"image-7cca6816a9b1ac4a26da7dd525e5ea29ee1947a8-360x240-png","_type":"reference"}},"_type":"logo","applyGrayscale":true,"name":"HIG"},{"name":"Voya","_key":"75e80b7c-cd91-43ca-b023-bb624db27096","image":{"_type":"image","asset":{"_type":"reference","_ref":"image-da62e816afd3120ef3802919a252e5734a5c0a30-6318x4212-png"}},"_type":"logo","applyGrayscale":false},{"name":"Securian","_key":"809ca0d6-22a9-4e5e-b395-804859718da5","image":{"_type":"image","asset":{"_type":"reference","_ref":"image-3edd7c702c5c58b74251e7b3ffea7978aaee44a4-6318x4212-png"}},"_type":"logo","applyGrayscale":false},{"_key":"e77ffa9b-c655-4034-9a0c-f290a518ad86","image":{"_type":"image","asset":{"_type":"reference","_ref":"image-776b6a61311b430cd12f626913a7f626f641b0f7-360x240-png"}},"_type":"logo","applyGrayscale":true,"name":"CarMax"}]},{"_key":"a02b112c-035e-424d-adef-1f6052dfeedb","title":"Human care, enhanced by technology","preheader":"YOUR SUPPORT SYSTEM","slides":[{"_key":"ad17acc7-c339-45ea-a382-2ca2a1310871","title":"Get your bearings—and a plan","image":{"asset":{"_ref":"image-c8a28b697d654c781e823ba439c8728bf95c7401-1200x1080-png","_type":"reference"},"_type":"image"},"widget":"care-plan","_type":"product_scroll_slide","alt":"Woman packing a box","description":"We'll create a personalized Care Plan, tailored to your family's most urgent needs, to help you face the challenges of loss."},{"_type":"product_scroll_slide","alt":"Man holding baby and working on computer","description":"Use our time-saving tools to get the benefits you deserve and cancel accounts and subscriptions. ","_key":"db51f64e-09f6-4b38-9e54-c0305709e141","title":"Finish your tasks faster","image":{"_type":"image","asset":{"_ref":"image-6750b9eb1adfb633729f4e4474b2d29011b869c0-1200x1080-png","_type":"reference"}},"widget":"closing-accounts"},{"title":"Get grief support anytime","image":{"_type":"image","asset":{"_ref":"image-d210595d1474112fcb7e5f7c0a8a10b134c83f29-1200x1080-png","_type":"reference"}},"widget":"grief","_type":"product_scroll_slide","alt":"Older woman with grandson","description":"Whenever, wherever you need them: audio companions, meditations, breathing exercises, journal exercises, and expert content. ","_key":"943ee233-3de1-40d6-8d11-df91ef9b70b0"},{"_type":"product_scroll_slide","alt":"Woman on phone","description":"You'll have a dedicated Care Manager throughout this experience—and they're backed up by a whole team who's here for you around the clock.","_key":"39f2758b-25ec-4ad9-a2c3-7be1a59deedd","title":"Work with a partner ","image":{"_type":"image","asset":{"_ref":"image-0ca4336b7d8a04a30fe1ce0b5752d85d0fed1538-1200x1080-png","_type":"reference"}},"widget":"care-manager"},{"_key":"8a29e383-1c67-49d0-bd48-4bb8c7d48305","title":"Tackle probate with confidence","image":{"_type":"image","asset":{"_ref":"image-389eecb68f72388dd9f10db5b82c281c9a906ffe-1200x1080-png","_type":"reference"}},"widget":"probate","_type":"product_scroll_slide","alt":"Woman playing with child","description":"We'll help you navigate your state's probate process, and find any documents or resources you need."}],"section_id":"","_type":"section_product_scroll","sectionVariant":"tall","bgClassName":"bg-white text-plum"},{"bgClassName":"bg-white text-plum","_key":"ebf11a2d-68bf-4965-a848-83a03b825f32","title":"How it works","steps":["Answer a few questions to get matched with a Care Manager","Get immediate help with administrative tasks","Receive a personalized Care Plan tailored to your needs","Access ongoing support for emotional and logistical hurdles"],"section_id":"","_type":"section_how_it_works_narrow","sectionVariant":"normal"},{"title":"Reducing Stress and Financial Burden","bgClassName":"bg-white text-plum","metrics":[{"_key":"fb0d4c91-d42c-49a5-8079-cbc1f4e07c2c","title":"average rating","value":"4.8/5","symbol":"⭑","_type":"statistic","description":"average user rating following Care Team session"},{"_type":"statistic","description":"hours on average saved for each family","_key":"9022682b-42a0-48d1-89a1-e6910d0ba8dc","title":"average rating","value":"189"},{"_type":"statistic","description":"average cost savings per family","_key":"b58d8b82-458e-4a59-ac5a-6564e51cc8a7","title":"average rating","value":"$3,007"}],"_key":"fb68d1e2-a71c-4cf1-a63e-a362ff55e530","section_id":"","_type":"section_care_stories_hero","sectionVariant":"normal","careStories":[{"quote":"My mother passed away suddenly. Empathy was there to help immediately with her obituary and funeral, and later with probate and much more.","by":"","_type":"care_story_card","_key":"3df0f1d7-7a26-4dd1-ac33-ef2451f45692","image":{"_type":"image","asset":{"_type":"reference","_ref":"image-4e35b559e607bbc62920b1684beb6a475a89a6c1-3744x2400-png"}}},{"quote":"I was in my 20s when my mom passed away. I knew nothing. Empathy helped me settle her estate and even figure out next steps in my own life.","by":"","_type":"care_story_card","_key":"3b7f52a6-8b6c-48df-9faa-731ba42370e9","image":{"_type":"image","asset":{"_ref":"image-e7fe26ff9a08c29be3df8cd4d0e151e8d09651e2-2496x1600-png","_type":"reference"}}},{"image":{"_type":"image","asset":{"_ref":"image-f0a640b81e0c93c4839985b7cac146de4fa53fac-3744x2400-png","_type":"reference"}},"quote":"I struggled after losing both my brother and mother. He was the beneficiary of her trust, and Empathy helped me settle it. I am so grateful.","by":"","_type":"care_story_card","_key":"82aae769-8c13-4383-876c-0b77835f4b00"},{"_key":"d095e97e-bc86-4935-950b-4401a62fd8c2","image":{"_type":"image","asset":{"_ref":"image-6d5ea1e1b241e7cb821c18282b3ffc53fbb233a9-2496x1600-png","_type":"reference"}},"quote":"As the executor of my husband’s estate, I felt clueless. My Care Manager explained it all so I could continue with ease and peace of mind.","by":"","_type":"care_story_card"},{"_key":"94f244b2-273c-437f-98ce-4b63edcaec63","image":{"asset":{"_ref":"image-ae39dcee01effc6607dc6a3eac1b456e3a60a3d3-2496x1600-png","_type":"reference"},"_type":"image"},"quote":"While my family was preparing for my father’s passing, Empathy was always there for us, helping us decide how to fulfill his final wishes. ","by":"","_type":"care_story_card"}],"bottomClassName":"bg-forest text-white"},{"bgClassName":"bg-forest text-white","items":[{"description":"Support your beneficiaries beyond the claim","linkText":"Learn more","href":"/life-insurance","_key":"33e94c99-de29-4ecf-9f9a-9d7f39e49a7a","title":"For Life Insurance","_type":"navigation_card"},{"linkText":"Learn more","href":"/consultants","_key":"ac7a6761-85c1-4e7d-95da-c3fcb0591d47","title":"For Consultants","_type":"navigation_card","description":"Support your clients with meaningful benefits"},{"_type":"navigation_card","description":"Show up for your employees when they need you most","linkText":"Learn more","href":"/employers","_key":"d51efed0-ae74-49a1-bbf2-205697bbcfac","title":"For Employers"}],"titleAlignment":"left","preheader":"Explore our Business Solutions","_key":"70891517-edd5-4630-8afe-01e88f59f835","isEyebrow":true,"section_id":"","_type":"section_navigation_cards","sectionVariant":"normal"},{"title":"Empathy Stories","items":[{"_type":"video","alt":"Watch Eva's S