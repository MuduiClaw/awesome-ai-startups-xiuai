<script>
document.getElementById('paymentSwitch').addEventListener('change', function() {
    const isChecked = this.checked;
    const monthlyPlans = document.getElementById('monthly-plans');
    const oneTimePlan = document.getElementById('one-time-plan');

    if (isChecked) {
        monthlyPlans.classList.remove('hidden');
        oneTimePlan.classList.add('hidden');
    } else {
        monthlyPlans.classList.add('hidden');
        oneTimePlan.classList.remove('hidden');
    }
});
</script>

<style>
/* Styling for the switch */
.toggle-path {
    transition: background-color 0.3s ease-in-out;
}
.toggle-circle {
    transition: transform 0.3s ease-in-out;
}
input:checked + .toggle-path {
    background-color: #4c51bf;
}
input:checked + .toggle-path + .toggle-circle {
    transform: translateX(1.25rem);
}
</style>


