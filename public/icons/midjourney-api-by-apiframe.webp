<script>
    let showMobileMegaMenu = false;

    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    let isMobileMenuOpen = !mobileMenu.classList.contains('hidden');



    const mobileMegaMenu = document.querySelector('#mobile-menu .mega-menu');
    const mobileMegaMenuButton = document.querySelector('#mobile-menu .mega-hover');



    mobileMenuButton.addEventListener('click', () => {
        mobileMenu.classList.toggle('hidden');
        isMobileMenuOpen = !isMobileMenuOpen;

        if (!isMobileMenuOpen) {
            showMobileMegaMenu = false;
            toggleMobileMegaMenu();
        }
    });

    function toggleMobileMegaMenu() {
        if (showMobileMegaMenu) {
            mobileMegaMenu.classList.remove('h-0');
            mobileMegaMenu.classList.remove('opacity-0');
            mobileMegaMenu.classList.add('h-fit');
            mobileMegaMenu.classList.add('opacity-100');
            mobileMegaMenuButton.classList.add('active-mobile-mega-menu');
        } else {
            mobileMegaMenu.classList.remove('h-fit');
            mobileMegaMenu.classList.add('h-0');
            mobileMegaMenu.classList.add('opacity-0');
            mobileMegaMenu.classList.remove('opacity-100');
            mobileMegaMenuButton.classList.remove('active-mobile-mega-menu');
        }
    }

    mobileMegaMenuButton.addEventListener('click', () => {
        showMobileMegaMenu = !showMobileMegaMenu;

        toggleMobileMegaMenu();
    });
</script>
