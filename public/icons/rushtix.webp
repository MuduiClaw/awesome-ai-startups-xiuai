  /////////////////////////////
  function open_tip_box(){
    jq(".tip-view").each(function(){
      jq(this).addClass("hide");
    });
    jq(".cust-amount").val('');
    jq("#cust-tip-btn").addClass("hide");
    jq(".tip-amounts.tip-view").removeClass("hide");
    jq(".stripe-tip-box").slideDown(500);
    jq(".right-side.column-right").css("z-index",1000);
  }
  function add_card_form_coin(){
    jq(".stripe-tip-box-coin .tip-view").each(function(){
		jq(this).addClass("hide");});
    jq(".stripe-tip-box-coin .add-credit-card.tip-view").removeClass("hide");
    jq(".stripe-tip-box-coin #card-errors").addClass("hide").text('');

	jq.getScript("https://js.stripe.com/v3/", function(){
      stripe = Stripe('pk_live_p04TOPO8hnie95c02hMztUH0');
      // Create an instance of Elements.
      var elements = stripe.elements();
      var fs=jq(window).width()<600?14:18;
      const style={base:{iconColor:"#666ee8",color:"#31325f",fontWeight:400,fontFamily:'-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif',fontSmoothing:"antialiased", fontSize:fs+"px", "::placeholder":{color:"#aab7c4"},":-webkit-autofill": {color:"#666ee8"}}};
      cardtip = elements.create('card', {style: style});
      cardtip.mount('#card-element-coin');
      jq(".stripe-tip-box-coin .tip-loader").addClass("hide");
      jq(".stripe-tip-box-coin #add-card-tip-coin").text("Add Card");
    });//jq.getScript
  }

  jq("body").on("click",".opentransactions",function(){
      jq(".stripe_transactions").show();

	  ////

	  var userid = '0';

	  db_rt_studio_points.child('points/'+userid+'/purchase_history').get().then((sn)=>{
	  var point_val=sn.val();

	  jq('#tblbody').html('');

	  jq.each(point_val, function(index, value) {

		 jq('#tblbody').append('<tr><td>'+value.coins+'</td><td>'+value.card_last4+'</td><td>$'+value.amount+'</td><td>'+value.datetime+'</td><td>'+value.trx_id+'</td><td>Complete</td></tr>');

	  });

	  jq(".trnloader").hide();
	  jq("#transaction_table").show();

	  });

  });


  jq("body").on("click",".open-stripe-tip-box, .top-half .back-btn, .mobile-send-tip-btn",function(){
      jq(".profile-popup").hide();
      open_tip_box();
      return false;
  });
  jq("body").on("click",".back-btn-1",function(){
    jq(".tip-view").each(function(){jq(this).addClass("hide");});
      jq(".tip-inc-message").removeClass("hide");
      return false;
  });

  jq("body").on("click",".stripe-tip-box .close",function(){
    jq(".stripe-tip-box").slideUp(500);
    jq(".right-side.column-right").css("z-index",998);
    return false;
  });
  jq("body").on("click","#more-cards",function(){
    jq(".tip-view").each(function(){
      jq(this).addClass("hide");
    });
    jq(".choose-credit-card.tip-view").removeClass("hide");
    return false;
  });
  jq("body").on("keyup",".cust-amount",function(){
    var bn=jq("#cust-tip-btn");
    var v=parseInt(jq(this).val());
    if(v>0){
      bn.removeClass("hide");
      bn.data("price", v);
      bn.text("Contribute $"+v);
    } else{
        bn.addClass("hide");
    }
  });
  jq("body").on("keyup change",".bottom-half textarea",function(){
    var v=jq(this).val();
    var v1=v.substring(0, 280);
    var l=v.length;
    jq(this).val(v1);
  });
  jq("body").on("click",".openboxnow",function(){
    jQuery('#points-box').toggle();
	  jq('.stripe_payment_popup').show();
    var amount=jq(this).data("price");
	var coins=jq(this).data("coins");

	jq('#bitcoins').val(coins);
	jq('#bitsprice').val(amount);

	 jq('.paymentsuccess').hide();

    jq(".stripe-tip-box-coin .tip-amounts").addClass("hide");
    jq(".stripe-tip-box-coin .tip-loader").removeClass("hide");
    jq("#direct-tip-amount-mc").val(amount);
    jq(".stripe-tip-box-coin .tip-inc-message #pay-for-tip-coin").data("amount", amount);
    //jq(".stripe-tip-box-coin .tip-inc-message #pay-for-tip-coin").text("Buy now $"+amount);
	jq(".stripe-tip-box-coin .tip-inc-message #pay-for-tip-coin").text("Buy Now");
    jq(".stripe-tip-box-coin .tip-amount-display .amount").text(amount);

	jq(".stripe-tip-box-coin .totcoins").text(coins);

    jq(".stripe-tip-box-coin .bottom-half textarea").val('');
	jq(".stripe-tip-box-coin .add-credit-card").addClass("hide");;


	jq.post("wp-admin/admin-ajax.html", {
      action: "get_saved_credit_cards_coins"},
          function(ret){
            var cards=JSON.parse(ret);
            if(cards.length>0){
              var dc=cards[0];
              jq(".stripe-tip-box-coin #selected-card-coin").val(dc.id);
              jq(".stripe-tip-box-coin .tip-loader").addClass("hide");
              jq(".stripe-tip-box-coin .top-half .card-brand").text(dc.brand);
              jq(".stripe-tip-box-coin .top-half .card-last4").text(dc.last4);
              jq(".stripe-tip-box-coin .tip-inc-message").removeClass("hide");
                jq(".stripe-tip-box-coin .choose-credit-card").html('<a href="#" class="back-btn-1"><i class="fas fa-long-arrow-alt-left"></i></a><h3>Select Payment Card</h3>');
              jq.each(cards,function(i,card){
                //card_logo(card.brand)
                var sel=i==0?'sel':'';
                card_html='<div class="card-sel '+sel+'" data-cid="'+card.id+'"><div class="card-cont"><span class="card-brand"> '+card.brand+' </span><span class="card-last4"> '+card.last4+' </span></div></div>';
                jq(".stripe-tip-box-coin .choose-credit-card").append(card_html);
              });
              jq(".stripe-tip-box-coin .choose-credit-card").append('<div class="clr"></div><div class="card-sel add" ><div class="card-cont"><span>Add Card</span></div></div>');

			  jq(".choose-credit-card").addClass("hide");

              //jq(".back-btn-1").removeClass("hide");
            }//if(cards.length>0){
            else{
              add_card_form_coin();
              jq(".back-btn-1").addClass("hide");
            }
          });

    return false;
  });
