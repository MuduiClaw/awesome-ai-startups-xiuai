  jq("body").on("click", "#pay-for-tip-coin", function() {
    var pft=jq(this).data();
    jq(this).css("background", "#ff4d58").text("Processing...");

    jq('.butpurhtmltxt').html("Payment Processing. Your order will be completed soon.");
    jq('.buypoitc').removeClass('buypointsucbk');
    jq('.buypoitc').addClass('buypointinibk');
    jq('.stripe_payment_popup').hide();
    jq('.acc_buypointspop').hide();

    jq('.buypoitc').show();

    var card_id=jq(".stripe-tip-box-coin #selected-card-coin").val();
    var stripePrice=pft.amount;
    db_livestream_sessions=rtdb.ref("livestream-sessions");
	var userid = '0';
	//////////////
	var pointslabel = '';
	db_rt_studio_points.child('points_label').get().then((sn)=>{
	  var point_val=sn.val();
	  pointslabel = point_val;
	});


			   var c_balance = existbal = newbalance = pointsexists = '';
				db_rt_studio_points.child("points/"+userid).get().then((sn)=>{
					if(!sn.exists())
					{
						pointsexists = 1;
						newbalance = 0;
						existbal = 0;
					}else {

						var scene2=sn.val();
						c_balance = scene2.balance;

						//alert(c_balance);
						if(typeof c_balance == 'undefined') {
							existbal = 0;
						}else{
							existbal = c_balance;
						}

					}
					//alert(scene2.balance)
				});

	////////////// stripe description
          var totalcoins = jq('#bitcoins').val();
			    var bitcoinslabel = jq('#bitcoinslabel').val();

    jq.ajax({
       method: "POST",
       url : "https://rushtix.com/wp-admin/admin-ajax.php",
       data : {action: "existingCardWithPaymentCoins", stripePrice : stripePrice, cardSourceId : card_id,
       coins:totalcoins, plabel:bitcoinslabel
      },
       success: function(resp) {
         if(resp.length > 0) {
           resp=JSON.parse(resp);
           if(resp.error) {
             alert("Error: "+resp.error+" Maybe try a different payment method.");
             jq("#pay-for-tip-coin").text("Contribute $"+stripePrice);
         }
           else{
			  //alert(existbal);
             if(resp.payment && resp.payment=="done"){

               var amnt = stripePrice;
			   var tranid = '';
			   tranid = resp.tran_id;

			  // alert(443);

			   var coinsu = parseInt(jq('#bitcoins').val());
			   var amount = parseFloat(jq('#bitsprice').val());

			   var bitcoinslabel = jq('#bitcoinslabel').val();

               var msg=jq(".bottom-half textarea").val();
               var tippee=jq("#direct-tip-amount-mc").data("tippee");

         jq('.tip-view').addClass('hide');
			   jq('.paymentsuccess').show();

			   jq('.paymentsuccess').removeClass('hide');

			   newbalance = parseInt(existbal)+parseInt(coinsu);

			   //var tip_msg='You have '+newbalance+' '+pointslabel+'s<br><strong>Use '+pointslabel+'s to Support Creators</strong><br>When you gift ('+pointslabel+'s), RushTix rewards the Creator and you create an exciting moment.';

			   //var tip_msg='You recharged '+coinsu+' '+bitcoinslabel+'s to your account. You can use '+bitcoinslabel+'s to send virtual gifts to creators.';
         var tip_msg= coinsu+' '+bitcoinslabel+'s have been added to your balance! Your total is '+newbalance+' '+pointslabel+'s. Your receipt will be sent to your email.';

			   //jq('#paymentsuccmsg').html(tip_msg);
         jq('.butpurhtmltxt').html(tip_msg);
         jq('.stripe_payment_popup').hide();
         jq('.buypoitc').removeClass('buypointinibk');
         jq('.buypoitc').addClass('buypointsucbk');
         jq('.buypoitc').show();

        setTimeout(function(){
          jq('.buypoitc').hide();
        }, 10000);

			   var cardlast4 = jq('.stripe-tip-box-coin .card-last4').html();

         db_rt_studio_points.child("points/"+userid+"/purchase_history").push({amount: amount.toFixed(2), datetime: '01/29/25', desc: 'Points purchase using credit card via stripe', trx_id: tranid, type: 'stripe_buy', card_last4: cardlast4, coins:coinsu});

			  //alert(userid);
			  //db_rt_studio_points.child("points/"+userid).update({['balance']: newbalance});

			//alert(newbalance);

			//db_rt_studio_points.child("points/"+userid+"/balance").set(newbalance);

			if(existbal==0){
				db_rt_studio_points.child("points/"+userid+"/balance").set(newbalance);
			}else{
				db_rt_studio_points.child("points/"+userid).update({['balance']: newbalance});
			}
			////

			////

			  jq('.totalpoints').html(newbalance);
			  jq('.pointslabel').html(pointslabel+'s');
        if(typeof livestream_session_id!="undefined" && livestream_session_id){
        db_livestream_sessions.child(livestream_session_id+"/totals/purchased").set(firebase.database.ServerValue.increment(parseInt(coinsu)));
        db_livestream_sessions.child(livestream_session_id+"/users/"+firebase_params.user_name+"/purchased").set(firebase.database.ServerValue.increment(parseInt(coinsu)));
      }
      if(current_ai_session_id){
        db_ai_sessions.child(current_ai_session_id+"/totals/purchased").set(firebase.database.ServerValue.increment(parseInt(coinsu)));
        db_ai_sessions.child(current_ai_session_id+"/users/"+firebase_params.user_name+"/purchased").set(firebase.database.ServerValue.increment(parseInt(coinsu)));
      }
       // alert(amount);
       var cur_seconds = Math.round(new Date().getTime() / 1000);
       var layeridd = 'BUYPOINTS';
       ////////////////////////////
       //GA_Old
        window.dataLayer.push({
                'event': 'transaction',
                'ecommerce': {
                  'purchase': {
                    'actionField': {
                      'id': layeridd,
                      'revenue': amount/coinsu,
                      'service_fee':'1',
                      'coupon': '1'
                    },
                    'products': [{
                      'name': 'Buy Points',
                      'id': layeridd,
                      'price': amount/coinsu,
                      'brand': 'RushTix',
                      'quantity': coinsu,
                      'coupon': '1'
                    }]
                  }
                }
              });
//GA_4
dataLayer.push({
  'event': 'purchase',
  'ecommerce': {
      'transaction_id': layeridd,// Required and unique for each purchase
      'affiliation': 'RushTix_Event', //Required, depends on where purchase was made
      ////////////////////////////
      'value':  amount/coinsu,
      'currency': 'USD',
      'coupon': '',
      'items': [{
        'item_name': "Buy Points",
        'item_id': layeridd,
        'price': amount/coinsu,
        'item_brand': 'RushTix',
        'quantity': coinsu
      }]
  }
});
              ///////////////////////////


			   //sendMessage(tip_msg, true, amnt);
               jq(".stripe-tip-box").slideUp(500);
               jq(".right-side.column-right").css("z-index",998);
             } else{
             //jQuery("#popup-stripe-elements .js-modal-close").click();
             jQuery(".direct-tip-mc").click();
             jq(".stripe-tip-box").slideUp();
             jq(".right-side.column-right").css("z-index",998);
             //jq("#popup-stripe-elements .balance-amount").text("$0");
              }
           }
         }
       },
       error: function(resp){
         alert("There was an issue in processing your payment.");
         jq("#pay-for-tip-coin").text("Contribute $"+stripePrice);
       }
    });
    return false;
  });

  jq("body").on("click", ".card-sel", function() {
    if(jq(this).hasClass("add")){
      add_card_form_coin();
      return false;
    }
    jq(".card-sel").removeClass("sel");
    jq(this).addClass("sel");
    var cid=jq(this).data("cid");
    jq(".stripe-tip-box-coin #selected-card-coin").val(cid);
    jq(".tip-view").each(function(){jq(this).addClass("hide");});
    jq(".tip-inc-message").removeClass("hide");
    brand=jq(this).find(".card-brand").text();
    last4=jq(this).find(".card-last4").text();
    jq(".top-half .card-brand").text(brand);
    jq(".top-half .card-last4").text(last4);
  });

  jq("body").on("click", "#add-card-tip-coin", function() {
    var ths=jq(this);
    stripe.createSource(cardtip).then(function(result) {

      if (result.error) {
        jq("#card-errors").removeClass("hide").text(result.error.message);
      }
      else{
        ths.css("background", "#ff4d58").text("Processing...");

          jq("#card-errors").addClass("hide").text('');
          jq.post("wp-admin/admin-ajax.html", { action: "add_new_credit_card_coins", source: result.source},
                function(ret){
                  var crd=JSON.parse(ret);
if(crd.error){
  jq("#card-errors").removeClass("hide").html(crd.error);
  jq("#add-card-tip-coin").text("Add Card");
  return false;
}
				  var cardbrnd = '';
				  cardbrnd = crd.card.brand;
				  if(cardbrnd=='MasterCard'){
				  	cardbrnd = 'Mastercard';
				  }else{
					cardbrnd = cardbrnd;
				  }

                  var crd_html='<div class="card-sel card-'+crd.id+'" data-cid="'+crd.id+'"><div class="card-cont"><span class="card-brand"> '+cardbrnd+' </span><span class="card-last4"> '+crd.card.last4+' </span></div></div>';
                  jq(".choose-credit-card").append(crd_html);
                  jq(".card-sel.add").remove();
                  jq(".choose-credit-card").append('<div class="clr"></div><div class="card-sel add"><div class="card-cont"><span>Add Card</span></div></div>');
                  jq(".card-sel.card-"+crd.id).click();
                });
      }
    });
  } );

  jq('body').on("click", ".direct-tip-mc", function(){
    if(!jq('body').hasClass('logged-in')){
        jq(".lwa-login-link").click();
        return false;
      }
    jq(this).val("Sending");
    var non_login=jq(".balance-amount").text().length;
    if(non_login<=0) location.reload();
    var data=jq(this).data();
    var amount=jq("#direct-tip-amount-mc").val();
    var ukey=localStorage.ukey?localStorage.ukey:false;

    jq.post("/wp-json/payments/send_mc_tip", {
      amount: amount,
      page: data.page,
      page_id: data.page_id,
      mc_ref: '',
      rec_name: '',
      sen_name:'',
      ukey:ukey
    }, function(resp){
      if(resp.status=="insufficient_balance"){
        open_tip_box();
        return false;
      }//<-insufficient_balance

      else if(resp.status=="success") {
        sendTipPubNub();
        jq("#direct-tip-amount-mc").val(0);
        jq(".bottom-half textarea").val('');
      }
      else rt_alert(resp.error);
      //$("#popup3 .js-modal-close").click();
      //$(".mycred-submit-transfer").click();
    });

    return false;
  });


    jq("body").on("click", ".change-pm", function(){
      var ths=jq(this);
      ths.addClass("close-change-pm").removeClass("change-pm");
      ths.html('Back');
      jq(".chosen-cc").hide();
      jq(".all-cc").slideDown(300);
      return false;
    });
    jq("body").on("click", ".close-change-pm", function(){
      var ths=jq(this);
      ths.addClass("change-pm").removeClass("close-change-pm");
      ths.html('Change');
      jq(".all-cc").hide();
      jq(".chosen-cc").slideDown(300);
      return false;
    });
    /*jq(".mobile-send-tip-btn").click(function(){
      jq(this).toggleClass("active");
      jq(".send-tip-div.mobile").toggle();
    });*/

