-->


.page-template-channel-with-booking.agora-feature #btn-buy-point {
	display: block;
}
.fa-chevron-down::before {
  content: "\f078";
}

 /* ######## Buy Points Section ######## */
 .user-menu{
	 display: flex;
	align-items: center;
	margin: 0;
	justify-content: space-between;
	gap: 10px;
 }

.buy-points-box .btn-buy-point{    background-color: #a6a6a6;
        padding: 5px 8px;
    border-radius: 3px;
    font-weight: 500;
    margin-right: 1em;
    margin-top: 0px;
    font-size: 14px; font-family:'Poppins',sans-serif !important}

.buy-points-box .btn-buy-point:hover{ background-color:grey}

.space-20{padding:10px 20px;}

.points-container{display:table;}
.points{width:100%;float:left;display:flex;padding:8px 15px;border-bottom:1px solid #eee; height:60px;}
.bits-points{width:68%;}
.bits-buttons{width:32%;font-size:13px;}
.buy-points-box .c{text-align:center;}
.line-clear{width:100%;height:1px;background-color:#eee;clear:both;}
span.bit-icon {
    background-repeat: no-repeat;
}

.topbox .bits-points{ padding-top:10px; }
.topbox .bits-buttons{ padding-top:9px; }

.party-icon{background-image:url("images/party-icon.html");padding: 5px 14px;background-position: 0px;}
.dark-bit{background-image:url("images/dark-bit.html")}
.blue-bit{background-image:url("images/blue-bit.html")}
.green-bit{background-image:url("images/green-bit.html")}
.dimond-bit{background-image:url("images/dimond-bit.html")}
.star-bit{background-image:url("images/star-bit.html")}
.bits-points .bit-icon{
	padding:6px 13px;
    float: inherit;
	background-size:22px;
	}
.btn-bits{
	background-color: #9047ff;
    border: 1px solid #9047ff;
    border-radius: 4px;
    padding: 4px 10px;
	width:75%;
	color:white !important;
	}

span.bit-icon.blue-bit.small {
    background-size: 12px;
    background-position: 0;
	padding: 8px;
}
	#points-box.shine{
		position: fixed;
		bottom: 90px;
		top: unset;
		height: 318px;
    right: 30px;
		display: none;
		visibility: hidden;
		opacity: 0;
	}
	@media(max-width: 600px) {
		#points-box.shine{
		left: 50%;
		margin-left: -165px;
    right: unset;
		}
	}

.buy-points-box .modal {
  display: none;
  position: absolute;
  z-index: 1;
  /*padding-top:32px;*/
  right: 0;
  top: 36px;
  width:330px;
  height: 600px;
  overflow: auto;
  z-index:999;
}

.buy-points-box .modal-content {
  background-color: #fefefe;
  /*margin:auto 1em auto auto;*/
  margin:auto 0 auto auto;
  border: 1px solid #888;
  width: 100%;
  font-size:14px;
  border-radius:10px;
}

.buy-points-box .close {
	float: right;
    font-size: 28px;
    margin-right: 0px;
	}

.buy-points-box .close:hover,
.buy-points-box .close:focus {
  color: #000;
  text-decoration: none;
  cursor: pointer;
}
.points-container .pointslabel{
	text-transform:capitalize;
}
/* ######## Buy Points Section ######## */

/*
/* Popup box BEGIN */
.hover_bkgr_fricc{
    background:rgba(0,0,0,.4);
    cursor:pointer;
    display:none;
    height:100%;
    position:fixed;
    text-align:center;
    top:0;
    width:100%;
    z-index:10000;
}
.hover_bkgr_fricc .helper{
    display:inline-block;
    height:100%;
    vertical-align:middle;
}
.hover_bkgr_fricc > div {
    background-color: #fff;
    box-shadow: 10px 10px 60px #555;
    display: inline-block;
    height: auto;
    max-width: 700px;
    min-height: 100px;
    vertical-align: middle;
    width: 60%;
    position: relative;
    border-radius: 8px;
    padding: 15px;
}
.popupCloseButton {
    background-color: #fff;
    border: 3px solid #999;
    border-radius: 50px;
    cursor: pointer;
    display: inline-block;
    font-family: arial;
    font-weight: bold;
    position: absolute;
    top: 0px;
    right: 0px;
    font-size: 25px;
    line-height: 28px;
    width: 30px;
    height: 30px;
    text-align: center;
}
.popupCloseButton:hover {
    background-color: #ccc;
}
.trigger_popup_fricc {
    cursor: pointer;
    font-size: 20px;
    margin: 20px;
    display: inline-block;
    font-weight: bold;
}
@media (max-width:640px) {
	.hover_bkgr_fricc > div {
		width: 90%;
	}
}
/* Popup box BEGIN */
/** */
/* Popup box BEGIN */
.hover_bkgr_fricc_prompt{
    background:rgba(0,0,0,.4);
    cursor:pointer;
    display:none;
    height:100%;
    position:fixed;
    text-align:center;
    top:0;
    width:100%;
    z-index:10000;
}
.hover_bkgr_fricc_prompt .helper{
    display:inline-block;
    height:100%;
    vertical-align:middle;
}
.hover_bkgr_fricc_prompt > div {
    background-color: #fff;
    box-shadow: 10px 10px 60px #555;
    display: inline-block;
    height: auto;
    max-width: 551px;
    min-height: 100px;
    vertical-align: middle;
    width: 60%;
    position: relative;
    border-radius: 8px;
    padding: 15px 5%;
}

.trigger_popup_fricc {
    cursor: pointer;
    font-size: 20px;
    margin: 20px;
    display: inline-block;
    font-weight: bold;
}
@media (max-width:640px) {
	.hover_bkgr_fricc > div {
		width: 90%;
	}
}</style><link rel="icon" href="https://cdn.rushtix.com/wp-content/uploads/2025/02/favicon-32x32-2.png" sizes="32x32" /><link rel="icon" href="https://cdn.rushtix.com/wp-content/uploads/2025/02/favicon-32x32-2.png" sizes="192x192" /><link rel="apple-touch-icon" href="https://cdn.rushtix.com/wp-content/uploads/2025/02/favicon-32x32-2.png" /><meta name="msapplication-TileImage" content="https://cdn.rushtix.com/wp-content/uploads/2025/02/favicon-32x32-2.png" /><style type="text/css" id="wp-custom-css">body.agora-feature .bottom-area{
	z-index: 9;
}

#primary.flex-box{
	height:100%;
}

#message-input:focus .flex-left{
	display: none;
}

body.page-template-channel-with-booking{
	height: 100%;
	min-height: 100%;
}
.popout-chat-wrap{ display: none; }

 .pic1 .open-profile img{
  display: none;
}

