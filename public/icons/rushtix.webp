  jq("body").on("click", ".backarrowsbg", function() {
    jq('.backarrowsbg').remove();
    jq('.skinstopcont').show();
    jq('.colldetails').html('');
  });

  jq("body").on("click", ".purchasecollection2", function() {

      skinpoint = jq(this).data('coins');
      url = jq(this).data('url');
      skin = jq(this).data('skin');

      existbal = jq('.mainpointsdiv .totalpoints').html();
