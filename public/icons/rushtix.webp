jq('body').on("click", ".selectskinpoints", function() {
    var skinpoint = jq(this).data("points");
    var url     = jq('.skinsdiv.selected').data("url");
    var skin    = jq('.skinsdiv.selected').data("skin");
    //alert(points+"-"+url+"-"+skin);

    existbal = jq('.mainpointsdiv .totalpoints').html();
    existbal = parseInt(existbal);
    skinpoint = parseInt(skinpoint);
    if(existbal<skinpoint){
      //alert("You need more points for this. Please recharge.");
      jq('.skinstopcont').after('<div class="pointserror topbox" style="padding-top:40px;"><div style="text-align: center;color: red;padding-top:40px">You need more points for this.<br> Please recharge.</div></div>');
      setTimeout(function() {
        jq('.pointserror').remove();
        jq('.maincollectionsdiv').hide();
        jq('.mainpointsdiv').show();

      }, 2000);

      return false;
    }

    var newbalance = existbal-skinpoint;

    var userid = '0';
    db_rt_studio_points.child("points/"+userid+"/balance").set(newbalance);

    db_rt_studio_points.child("points/"+userid+"/collections").push({collection_avatar: url, purchase_amount:skinpoint, purchase_date: '1738112600', skinid:skin});
    db_rt_studio_points.child("points/"+userid+"/collections_totals").update({[skin]: {"points":firebase.database.ServerValue.increment(skinpoint),"time":Date.now()/1000 }});

    //jq(".myusercollections").slick('destroy')
    //jq('.myusercollections').html('Please wait...');
    //jq('.myusercollections').hide();
    load_collections(userid);

    setTimeout(function() {
      //jq('.myusercollections').show();
      //jq('.myusercollections').slick();
      //jq('.myusercollections').slick({ slidesToShow: 2, slidesToScroll: 1});

      jq('.succpurloader').show();
      setTimeout(function() {

        jq('.myusercollections3 .left-arrow').trigger('click');

        jq('.succpurloader').hide();
      }, 4000);


    }, 700);

    jq('.backarrowsbg').remove();
    jq('.skinstopcont').show();
    jq('.colldetails').html('');
});

