 right: 15px; top: 15px;"><svg class="times" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path d="M23 20.168l-8.185-8.187 8.185-8.174-2.832-2.807-8.182 8.179-8.176-8.179-2.81 2.81 8.186 8.196-8.186 8.184 2.81 2.81 8.203-8.192 8.18 8.192z"></path></svg></button> <svg class="tip-loader loader hide" viewBox="0 0 40 40" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" style="display: block;opacity: 1;position: absolute;left: 50%;width:30px;height:30px;"> <defs><linearGradient x1="50%" y1="7.52257671%" x2="50%" y2="100%" id="linearGradient-11"><stop stop-color="currentColor" stop-opacity="0.5" offset="0%"></stop><stop stop-color="currentColor" stop-opacity="0" offset="100%"></stop></linearGradient><linearGradient x1="50%" y1="7.70206696%" x2="50%" y2="100%" id="linearGradient-21"><stop stop-color="currentColor" stop-opacity="0.5" offset="0%"></stop><stop stop-color="currentColor" offset="100%"></stop></linearGradient></defs><g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><g><path d="M20,0 C31.045695,0 40,8.954305 40,20 C40,31.045695 31.045695,40 20,40 L20,38 C29.9411255,38 38,29.9411255 38,20 C38,10.0588745 29.9411255,2 20,2 L20,0 Z" id="Oval-1" fill="url(#linearGradient-11)"></path> <path d="M20,0 C8.954305,0 0,8.954305 0,20 C0,31.045695 8.954305,40 20,40 L20,38 C10.0588745,38 2,29.9411255 2,20 C2,10.0588745 10.0588745,2 20,2 L20,0 Z" id="Oval-1-Copy" fill="url(#linearGradient-21)"></path></g></g> </svg><div class="tip-amounts tip-view"><h3></h3><div class="tip-options"> <a href="#" data-price="1"><span>$1</span></a> <a href="#" data-price="5"><span>$5</span></a> <a href="#" data-price="10"><span>$10</span></a> <a href="#" data-price="15"><span>$15</span></a> <a href="#" data-price="20"><span>$20</span></a> <a href="#" data-price="25"><span>$25</span></a><div class="custom-tip-option"> <span>$</span> <input type="number" class="cust-amount" onkeypress="if (!window.__cfRLUnblockHandlers) return false; return !(event.charCode == 46)" placeholder="Custom" min="0" max="1000000" data-cf-modified-4925da8b37484ff42c9dd6eb-="" /></div></div> <a href="#" data-price="10" id="cust-tip-btn" class="hide">Contribute $10</a></div><div class="tip-inc-message hide tip-view"> <input type="hidden" id="selected-card-coin" value="" /><div class="top-half"> <a href="#" class="hide back-btn"><i class="fas fa-long-arrow-alt-left"></i></a><div id="more-cards" class="card-name"> <span class="card-brand"></span> <span class="card-last4"></span> <svg version="1.1" id="Layer_112" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewBox="0 0 386.257 386.257" style="enable-background:new 0 0 386.257 386.257; width:16px;" xml:space="preserve"><polygon points="0,96.879 193.129,289.379 386.257,96.879 "/></svg></div><div class="tip-amount-display"> <sup class="dollar">$</sup> <span class="amount">1</span></div><div>For <span class="totcoins"></span> <span class="pointslabel"></span></div></div><div class="bottom-half"><textarea placeholder="Add a message" style="display:none;"></textarea><button type="submit" id="pay-for-tip-coin" data-amount="10" data-receiver="">Contribute $10</button></div></div><div class="choose-credit-card tip-view"></div><div class="add-credit-card tip-view"> <a href="#" class="back-btn-1"><i class="fas fa-long-arrow-alt-left"></i></a><h3>Add a Payment Method</h3><div id="card-errors" class="hide"></div><div id="card-element-coin"></div> <button type="submit" id="add-card-tip-coin" data-amount="0">Add Card</button></div><div class="paymentsuccess tip-view"><h3 style="margin-top:-10px;">Payment Success</h3><div id="paymentsuccmsg" style="text-align:left;">You recharged 350 [coins] to your account. You can use [coins] to send virtual gifts to creators.</div></div></div> <script type="4925da8b37484ff42c9dd6eb-text/javascript">jq=jQuery;
var cardtip;
jq(function(){
  ///Temporary triggers, Remove before submitting PRs
  //open_tip_box();
