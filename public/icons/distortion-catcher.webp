<svg width="300" height="300" xmlns="http://www.w3.org/2000/svg">
 <!-- Define gradient -->
 <defs>
  <linearGradient y2="100%" x2="100%" y1="0%" x1="0%" id="bgGradient">
   <stop stop-color=" #7C7DC7" offset="0%"/>
   <stop stop-color=" #FF69B4" offset="100%"/>
  </linearGradient>
 </defs>
 <!-- Background with gradient and rounded corners -->
 <!-- Centered text -->
 <g>
  <title>Layer 1</title>
  <rect id="svg_1" fill="url(#bgGradient)" ry="50" rx="50" height="300" width="300" y="0" x="0"/>
  <text id="svg_2" fill="#FFFFFF" font-size="120" font-weight="bold" font-family="sans-serif" text-anchor="middle" dominant-baseline="middle" y="159.6875" x="150">DC</text>
 </g>
</svg>
