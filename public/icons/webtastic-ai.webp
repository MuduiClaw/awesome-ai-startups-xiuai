36-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div></div><blockquote class="text-md prose font-base mt-3 leading-8 tracking-tight text-gray-600 sm:text-lg sm:leading-7"><p>“<!-- -->With Cara’s help, we generated a pipeline of ICP-aligned companies, researched their job openings for Out-Of-Home advertising roles, and leveraged that as an icebreaker, booking our first meetings in just 3 days.<!-- -->”</p></blockquote><figcaption class="mt-4 flex items-center gap-x-4"><img alt="Pieter Vonk" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" class="h-10 w-10 rounded-full bg-gray-50" style="color:transparent" srcSet="/_next/image?url=%2Fcustomers%2Fcustomer15.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fcustomers%2Fcustomer15.png&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2Fcustomers%2Fcustomer15.png&amp;w=96&amp;q=75"/><div class="text-sm leading-6"><div class="font-semibold text-gray-900">Pieter Vonk</div><div class="mt- text-gray-600">Quantes</div></div></figcaption></figure></div></div></section></div></div></div><div class="pt-4 lg:pt-32" id="features"><div class="relative mx-auto max-w-7xl py-12" style="opacity:0;transform:translateY(50px)"><div class="rounded-4xl absolute -inset-0 bottom-0 mx-auto hidden w-full sm:max-w-[1400px] lg:block overflow-hidden bg-[linear-gradient(115deg,var(--tw-gradient-stops))] from-stone-100/40 from-[28%] via-stone-200/10 via-[70%] to-stone-100/40 sm:bg-[linear-gradient(145deg,var(--tw-gradient-stops))]"><div class="absolute inset-0 bg-[url(&#x27;https://grainy-gradients.vercel.app/noise.svg&#x27;)] opacity-10" style="mix-blend-mode:overlay"></div></div><div class="relative px-4 lg:px-12"><div class="grid grid-cols-1 gap-x-4 gap-y-16 sm:gap-y-20 lg:grid-cols-2 lg:items-start"><div class=""><div class="mx-auto max-w-2xl pr-4 lg:mx-0"><h2 class="flex items-center text-xs/5 font-bold uppercase tracking-widest text-gray-500 data-[dark]:text-gray-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wand-sparkles mr-2 inline-block h-4 w-4 text-pink-600"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"></path><path d="m14 7 3 3"></path><path d="M5 6v4"></path><path d="M19 14v4"></path><path d="M10 2v2"></path><path d="M7 8H3"></path><path d="M21 16h-4"></path><path d="M11 3H9"></path></svg><span class="bg-gradient-to-r from-[#d6008e] from-[28%] via-[#c7008f] via-[70%] to-[#8109B8] bg-clip-text text-transparent">MAGIC PIPELINE</span></h2><h2 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">Your sales pipeline, in seconds</h2><p class="mt-6 text-lg leading-8 text-gray-600">A strong go-to-market strategy starts with the right list. Cara works her magic in multiple ways to help you build that ideal sales pipeline.</p><dl class="mt-6 max-w-xl space-y-4 text-base leading-7 text-gray-600 lg:max-w-none"><div class="relative pl-9"><dt class="inline font-semibold text-gray-900"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-database-zap absolute left-1 top-1 h-5 w-5 text-pink-600" aria-hidden="true"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 15 21.84"></path><path d="M21 5V8"></path><path d="M21 12L18 17H22L19 22"></path><path d="M3 12A9 3 0 0 0 14.59 14.87"></path></svg>Integrated B2B data sources</dt> <dd class="inline">Cara taps into your trusted B2B data sources, including LinkedIn and Apollo, without the need for any additional subscriptions.</dd></div><div class="relative pl-9"><dt class="inline font-semibold text-gray-900"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-between-vertical-start absolute left-1 top-1 h-5 w-5 text-pink-600" aria-hidden="true"><rect width="7" height="13" x="3" y="8" rx="1"></rect><path d="m15 2-3 3-3-3"></path><rect width="7" height="13" x="14" y="8" rx="1"></rect></svg>CRM import</dt> <dd class="inline">Cara lets you integrate your existing CRM data to either start, enrich or expand your sales pipeline.</dd></div><div class="relative pl-9"><dt class="inline font-semibold text-gray-900"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-upload absolute left-1 top-1 h-5 w-5 text-pink-600" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>CSV Uploads</dt> <dd class="inline">Handover  CSV files to build or enrich your pipeline with relevant data for lead qualification and personalition,</dd></div></dl></div></div><div class="sm:px-6 lg:px-0"><div class="relative isolate overflow-hidden rounded-3xl bg-[linear-gradient(115deg,var(--tw-gradient-stops))] from-slate-800 from-[28%] via-slate-700 via-[70%] to-slate-900 px-6 pt-8 sm:mx-auto sm:max-w-2xl sm:bg-[linear-gradient(145deg,var(--tw-gradient-stops))] sm:pl-10 sm:pr-0 sm:pt-10 lg:mx-0 lg:max-w-none"><div class="mx-auto max-w-2xl sm:mx-0 sm:max-w-none"><div style="--width:1161;--height:760" class="-mb-24 w-[52rem] max-w-none rounded-tl-xl bg-gray-800 ring-1 ring-white/10 relative aspect-[var(--width)/var(--height)] [--radius:theme(borderRadius.xl)]"><div class="absolute -inset-[var(--padding)] rounded-[calc(var(--radius)+var(--padding))] shadow-sm ring-1 ring-black/5 [--padding:theme(spacing.2)]"></div><img alt="Product screenshot pipeline features" fetchPriority="high" width="1161" height="760" decoding="async" data-nimg="1" class="h-full rounded-[var(--radius)] bg-white shadow-2xl ring-1 ring-black/10" style="color:transparent" srcSet="/_next/image?url=%2Fscreenshots%2Fpipeline5.png&amp;w=1200&amp;q=90 1x, /_next/image?url=%2Fscreenshots%2Fpipeline5.png&amp;w=3840&amp;q=90 2x" src="/_next/image?url=%2Fscreenshots%2Fpipeline5.png&amp;w=3840&amp;q=90"/></div></div><div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-black/10 sm:rounded-3xl" aria-hidden="true"></div></div></div></div></div></div></div><div class="hidden pt-24 lg:block"><section class="px-4 lg:px-0"><figure class="mx-auto max-w-5xl"><p class="sr-only">5<!-- --> out of 5 stars</p><div class="flex gap-x-1 text-yellow-400"><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div></div><blockquote class="prose mt-2 text-xl leading-8 tracking-tight text-gray-600 sm:text-xl sm:leading-9"><p class="relative"><span>Cara <b>built my sales pipeline</b> by listing companies in the Netherlands with part-time job openings and scanning all 10K+ websites to find those likely to hire candidates aged 65 and older. What would have taken me weeks, Cara <b>completed in minutes</b>.</span></p></blockquote><figcaption class="mt-1 flex items-center justify-end gap-x-4"><img alt="Pauline de Bruijn" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-12 w-12 rounded-full bg-gray-50 object-cover" style="color:transparent" srcSet="/_next/image?url=%2Fcustomers%2Fcustomer12.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fcustomers%2Fcustomer12.png&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2Fcustomers%2Fcustomer12.png&amp;w=96&amp;q=75"/><div class="text-sm leading-6"><div class="font-semibold text-gray-600">Pauline de Bruijn</div><div class="text-gray-400">CEO at Proudies.nl</div></div></figcaption></figure></section></div><div class="pt-8 lg:pt-24"><div class="relative mx-auto max-w-7xl py-12" style="opacity:0;transform:translateY(50px)"><div class="rounded-4xl absolute -inset-0 bottom-0 mx-auto hidden w-full sm:max-w-[1400px] lg:block overflow-hidden bg-[linear-gradient(115deg,var(--tw-gradient-stops))] from-stone-100/40 from-[28%] via-stone-200/10 via-[70%] to-stone-100/40 sm:bg-[linear-gradient(145deg,var(--tw-gradient-stops))]"><div class="absolute inset-0 bg-[url(&#x27;https://grainy-gradients.vercel.app/noise.svg&#x27;)] opacity-10" style="mix-blend-mode:overlay"></div></div><div class="relative px-4 lg:px-12"><div class="grid grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:grid-cols-2 lg:items-center"><div class="hidden sm:px-6 lg:block lg:px-0"><div class="relative isolate overflow-hidden rounded-3xl bg-[linear-gradient(115deg,var(--tw-gradient-stops))] from-slate-800 from-[28%] via-slate-700 via-[70%] to-slate-900 px-6 pt-8 sm:mx-auto sm:max-w-2xl sm:bg-[linear-gradient(145deg,var(--tw-gradient-stops))] sm:pl-10 sm:pr-0 sm:pt-10 lg:mx-0 lg:max-w-none"><div class="mx-auto max-w-2xl sm:mx-0 sm:max-w-none"><div style="--width:1161;--height:760" class="-mb-24 w-[52rem] max-w-none rounded-tl-xl bg-gray-800 ring-1 ring-white/10 relative aspect-[var(--width)/var(--height)] [--radius:theme(borderRadius.xl)]"><div class="absolute -inset-[var(--padding)] rounded-[calc(var(--radius)+var(--padding))] shadow-sm ring-1 ring-black/5 [--padding:theme(spacing.2)]"></div><img alt="Product screenshot pipeline" fetchPriority="high" width="1161" height="760" decoding="async" data-nimg="1" class="h-full rounded-[var(--radius)] bg-white shadow-2xl ring-1 ring-black/10" style="color:transparent" srcSet="/_next/image?url=%2Fscreenshots%2Fpipeline1.png&amp;w=1200&amp;q=90 1x, /_next/image?url=%2Fscreenshots%2Fpipeline1.png&amp;w=3840&amp;q=90 2x" src="/_next/image?url=%2Fscreenshots%2Fpipeline1.png&amp;w=3840&amp;q=90"/></div></div><div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-black/10 sm:rounded-3xl" aria-hidden="true"></div></div></div><div class=""><div class="mx-auto max-w-2xl pl-0 lg:mx-0 lg:pl-2"><h2 class="flex items-center text-xs/5 font-bold uppercase tracking-widest text-gray-500 data-[dark]:text-gray-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-orbit mr-2 inline-block h-4 w-4 text-pink-600"><circle cx="12" cy="12" r="3"></circle><circle cx="19" cy="5" r="2"></circle><circle cx="5" cy="19" r="2"></circle><path d="M10.4 21.9a10 10 0 0 0 9.941-15.416"></path><path d="M13.5 2.1a10 10 0 0 0-9.841 15.416"></path></svg><span class="bg-gradient-to-r from-[#d6008e] from-[28%] via-[#c7008f] via-[70%] to-[#8109B8] bg-clip-text text-transparent">AI palantir</span></h2><h2 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">Real-time lead research</h2><p class="mt-4 text-lg leading-8 text-gray-600">Let Cara automate all the complex manual research tasks to uncover and cross-check buying signals from the web, news, and social media.</p><dl class="mt-6 max-w-xl space-y-4 text-base leading-7 text-gray-600 lg:max-w-none"><div class="relative pl-9"><dt class="inline font-semibold text-gray-900"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scan-search absolute left-1 top-1 h-5 w-5 text-pink-600" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><circle cx="12" cy="12" r="3"></circle><path d="m16 16-1.9-1.9"></path></svg>Deep AI Web Research</dt> <dd class="inline">Cara reads, analyzes, and processes information from all your leads&#x27; company websites.</dd></div><div class="relative pl-9"><dt class="inline font-semibold text-gray-900"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-rss absolute left-1 top-1 h-5 w-5 text-pink-600" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>News Items Covered</dt> <dd class="inline">Cara accesses any public news, from product launches to hiring news and regulatory changes.</dd></div><div class="relative pl-9"><dt class="inline font-semibold text-gray-900"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-hash absolute left-1 top-1 h-5 w-5 text-pink-600" aria-hidden="true"><line x1="4" x2="20" y1="9" y2="9"></line><line x1="4" x2="20" y1="15" y2="15"></line><line x1="10" x2="8" y1="3" y2="21"></line><line x1="16" x2="14" y1="3" y2="21"></line></svg>Social media profiles, posts and engagement</dt> <dd class="inline">Cara analyzes social media data, including profiles, posts, and engagement on LinkedIn and X.</dd></div></dl></div></div></div></div></div></div><div class="hidden pb-8 pt-24 lg:block"><section class="px-4 lg:px-0"><figure class="mx-auto max-w-5xl"><p class="sr-only">5<!-- --> out of 5 stars</p><div class="flex gap-x-1 text-yellow-400"><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div><div style="opacity:0;transform:scale(0.5)"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon" class="h-5 w-5 flex-none"><path fill-rule="evenodd" d="M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z" clip-rule="evenodd"></path></svg></div></div><blockquote class="prose mt-2 text-xl leading-8 tracking-tight text-gray-600 sm:text-xl sm:leading-9"><p class="relative"><span>Cara has <b>transformed our research process</b>! She automates everything, from analyzing company websites to finding buying signals in news and social media, helping us find the perfect timing and hook for outreach. We no longer waste time manually tracking leads. It's like <b>magic for our sales team</b>!</span></p></blockquote><figcaption class="mt-1 flex items-center justify-end gap-x-4"><img alt="Phyllis Rush" loading="lazy" width="48" height="48" decoding="async" data-nimg="1" class="h-12 w-12 rounded-full bg-gray-50 object-cover" style="color:transparent" srcSet="/_next/image?url=%2Fcustomers%2Fcustomer17.png&amp;w=48&amp;q=75 1x, /_next/image?url=%2Fcustomers%2Fcustomer17.png&amp;w=96&amp;q=75 2x" src="/_next/image?url=%2Fcustomers%2Fcustomer17.png&amp;w=96&amp;q=75"/><div class="text-sm leading-6"><div class="font-semibold text-gray-600">Phyllis Rush</div><div class="text-gray-400">GTM lead at Finch.com</div></div></figcaption></figure></section></div><div class="pt-8 lg:pt-24"><div class="relative mx-auto max-w-7xl py-12" style="opacity:0;transform:translateY(50px)"><div class="rounded-4xl absolute -inset-0 bottom-0 mx-auto hidden w-full sm:max-w-[1400px] lg:block overflow-hidden bg-[linear-gradient(115deg,var(--tw-gradient-stops))] from-stone-100/40 from-[28%] via-stone-200/10 via-[70%] to-stone-100/40 sm:bg-[linear-gradient(145deg,var(--tw-gradient-stops))]"><div class="absolute inset-0 bg-[url(&#x27;https://grainy-gradients.vercel.app/noise.svg&#x27;)] opacity-10" style="mix-blend-mode:overlay"></div></div><div class="relative px-4 lg:px-12"><div class="grid grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:grid-cols-2 lg:items-center"><div class=""><div class="mx-auto max-w-2xl pr-4 lg:mx-0"><h2 class="flex items-center text-xs/5 font-bold uppercase tracking-widest text-gray-500 data-[dark]:text-gray-400"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-mail mr-2 inline-block h-4 w-4 text-pink-600"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg><span class="bg-gradient-to-r from-[#d6008e] from-[28%] via-[#c7008f] via-[70%] to-[#8109B8] bg-clip-text text-transparent">Contextual Precision</span></h2><h2 class="font-display mt-4 text-3xl font-extrabold tracking-tight text-gray-900 sm:text-4xl">Superhuman campaigns</h2><p class="mt-4 text-lg leading-8 text-gray-600">Cara crafts and executes campaign messaging, sequences and workflows for the right contacts at the right time.</p><dl class="mt-6 max-w-xl space-y-4 text-base leading-7 text-gray-600 lg:max-w-none"><div class="relative pl-9"><dt class="inline font-semibold text-gray-900"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-brain absolute left-1 top-1 h-5 w-5 text-pink-600" aria-hidden="true"><path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"></path><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"></path><path d="M17.599 6.5a3 3 0 0 0 .399-1.375"></path><path d="M6.003 5.125A3 3 0 0 0 6.401 6.5"></path><path d="M3.477 10.896a4 4 0 0 1 .585-.396"></path><path d="M19.938 10.5a4 4 0 0 1 .585.396"></path><path d="M6 18a4 4 0 0 1-1.967-.516"></path><path d="M19.967 17.484A4 4 0 0 1 18 18"></path></svg>AI messaging and variables</dt> <dd class="inline">Cara can ghostwrite entire emails or specific sections using AI variables.</dd></div><div class="relative pl-9"><dt class="inline font-semibold text-gray-900"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-replace absolute left-1 top-1 h-5 w-5 text-pink-600" aria-hidden="true"><path d="M14 4a2 2 0 0 1 2-2"></path><path d="M16 10a2 2 0 0 1-2-2"></path><path d="M20 2a2 2 0 0 1 2 2"></path><path d="M22 8a2 2 0 0 1-2 2"></path><path d="m3 7 3 3 3-3"></path><path d="M6 10V5a3 3 0 0 1 3-3h1"></path><rect x="2" y="14" width="8" height="8" rx="2"></rect></svg>AI sequences and templates</dt> <dd class="inline">Choose a ready-made sequence template or have Cara create one for you.</dd></div><div class="relative pl-9"><dt class="inline font-semibold text-gray-900"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap absolute left-1 top-1 h-5 w-5 text-pink-600" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg>AI triggers with recurring enrichments</dt> <dd class="inline">Set your own triggers or let Cara suggest and create them.</dd></div></dl></div></div><div class="sm:px-6 lg:px-0"><div class="relative isolate overflow-hidden rounded-3xl bg-[linear-gradient(115deg,var(--tw-gradient-stops))] from-slate-800 from-[28%] via-slate-700 via-[70%] to-slate-900 px-6 pt-8 sm:mx-auto sm:max-w-2xl sm:bg-[linear-gradient(145deg,var(--tw-gradient-stops))] sm:pl-10 sm:pr-0 sm:pt-10 lg:mx-0 lg:max-w-none"><div class="mx-auto max-w-2xl sm:mx-0 sm:max-w-none"><div style="--width:1161;--height:760" class="-mb-24 w-[52rem] max-w-none rounded-tl-xl bg-gray-800 ring-1 ring-white/10 relative aspect-[var(--width)/var(--height)] [--radius:theme(borderRadius.xl)]"><div class="absolute -inset-[var(--padding)] rounded-[calc(var(--radius)+var(--padding))] shadow-sm ring-1 ring-black/5 [--padding:theme(spacing.2)]"></div><img alt="Product screenshot context" fetchPrior