-filters.jpg"},"311":{"url":"بيرسونا-انستغرام","head":"كيفية إنشاء بيرسونا انستغرام الخاصة بك","enCategory":"Social audience research;Persona generation","parent":"38","lang":"ar","desc":"في هذا المقال، نلقي نظرة على كيفية إنشاء بيرسونا مستخدمي انستغرام. استخدمها، مع بيرسونا العلامة التجارية، لتكون ملائمة وجذابة لجمهورك المستهدف","langNames":{"en":"English","ar":"Arabic","zh":"Chinese","nl":"Dutch","es":"Espanol","fr":"French","de":"German","he":"Hebrew","hi":"Hindi","id":"Indonesian","it":"Italian","ja":"Japanese","ko":"Korean","pt":"Portuguese","tr":"Turkish","vi":"Vietnamese"},"langUrls":{"en":"instagram-personas","ar":"بيرسونا-انستغرام","zh":"instagram佩尔索纳","nl":"instagram-personas-genereren","es":"persona-de-instagram","fr":"persona-instagram","de":"instagram-personas-erstellen","he":"פרסונת-אינסטגרם","hi":"इस्टाग्राम-पर्सोना","id":"membuat-persona-instagram","it":"personas-instagram-generare","ja":"instagramペルソナ","ko":"인스타그램-페르소나","pt":"persona-do-instagram","tr":"instagram-persona-olusturma","vi":"persona-instagram-tao"}},"312":{"url":"instagram佩尔索纳","head":"如何生成您的Instagram角色定位","enCategory":"Social audience research;Persona generation","parent":"38","lang":"zh","desc":"在本文中，我们将探讨如何生成您的Instagram用户佩尔索纳。将其与品牌佩尔索纳一起使用，以便与您的目标受众保持相关性和吸引力","langNames":{"en":"English","ar":"Arabic","zh":"Chinese","nl":"Dutch","es":"Espanol","fr":"French","de":"German","he":"Hebrew","hi":"Hindi","id":"Indonesian","it":"Italian","ja":"Japanese","ko":"Korean","pt":"Portuguese","tr":"Turkish","vi":"Vietnamese"},"langUrls":{"en":"instagram-personas","ar":"بيرسونا-انستغرام","zh":"instagram佩尔索纳","nl":"instagram-personas-genereren","es":"persona-de-instagram","fr":"persona-instagram","de":"instagram-personas-erstellen","he":"פרסונת-אינסטגרם","hi":"इस्टाग्राम-पर्सोना","id":"membuat-persona-instagram","it":"personas-instagram-generare","ja":"instagramペルソナ","ko":"인스타그램-페르소나","pt":"persona-do-instagram","tr":"instagram-persona-olusturma","vi":"persona-instagram-tao"}},"313":{"url":"instagram-p