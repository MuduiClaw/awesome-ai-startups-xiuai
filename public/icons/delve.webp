ls":{"en":"technographic-segmentation","ar":"التقسيم-التكنوغرافي","zh":"技术统计细分","nl":"technografische-segmentatie","es":"segmentacion-tecnografica","fr":"segmentation-technographique","de":"technografische-segmentierung","he":"סגמנטציה-טכנוגרפית","hi":"टेक्नोग्राफिक-सेगमेटेशन","id":"segmentasi-teknografis","it":"segmentazione-tecnografica","ja":"テクノグラフィック-セグメンテーション","ko":"기술통계-세분화","pt":"segmentacao-tecnografica","tr":"teknografik-segmentasyon","vi":"phan-khuc-technographic"}},"302":{"url":"टेक्नोग्राफिक-सेगमेटेशन","head":"टेक्नोग्राफिक सेगमेंटेशन क्या है और यह क्यों महत्वपूर्ण है?","enCategory":"Marketing segmentation","parent":"58","lang":"hi","desc":"टेक्नोग्राफिक सेगमेंटेशन आपके ग्राहकों को उनके प्रौद्योगिकी उपयोग और अपनाने की दर के आधार पर विभाजित करता है। जानें कैसे यह आपके B2B मार्केटिंग प्रयासों को बढ़ा सकता है और ग्राहक वृद्धि को बढ़ावा दे सकता है।","langNames":{"en":"English","ar":"Arabic","zh":"Chinese","nl":"Dutch","es":"Espanol","fr":"French","de":"German","he":"Hebrew","hi":"Hindi","id":"Indonesian","it":"Italian","ja":"Japanese","ko":"Korean","pt":"Portuguese","tr":"Turkish","vi":"Vietnamese"},"langUrls":{"en":"technographic-segmentation","ar":"التقسيم-التكنوغرافي","zh":"技术统计细分","nl":"technografische-segmentatie","es":"segmentacion-tecnografica","fr":"segmentation-technographique","de":"technografische-segmentierung","he":"סגמנטציה-טכנוגרפית","hi":"टेक्नोग्राफिक-सेगमेटेशन","id":"segmentasi-teknografis","it":"segmentazione-tecnografica","ja":"テクノグラフィック-セグメンテーション","ko":"기술통계-세분화","pt":"segmentacao-tecnografica","tr":"teknografik-segmentasyon","vi":"phan-khuc-technographic"}},"303":{"url":"segmentasi-teknografis","head":"Apa itu Segmentasi Teknografis dan Mengapa Itu Penting?","enCategory":"Marketing segmentation","parent":"58","lang":"id","desc":"Segmentasi teknografis membagi pelanggan Anda berdasarkan penggunaan teknologi dan tingkat adopsi mereka. Pelajari bagaimana ini dapat meningkatkan upaya pemasaran B2B Anda dan mendorong pertumbuhan pelanggan.","langNames":{"en":"English","ar":"Arabic","zh":"Chinese","nl":"Dutch","es":"Espanol","fr":"French","de":"German","he":"Hebrew","hi":"Hindi","id":"Indonesian","it":"Italian","ja":"Japanese","ko":"Korean","pt":"Portuguese","tr":"Turkish","vi":"Vietnamese"},"langUrls":{"en":"technographic-segmentation","ar":"التقسيم-التكنوغرافي","zh":"技术统计细分","nl":"technografische-segmentatie","es":"segmentacion-tecnografica","fr":"segmentation-technographique","de":"technografische-segmentierung","he":"סגמנטציה-טכנוגרפית","hi":"टेक्नोग्राफिक-सेगमेटेशन","id":"segmentasi-teknografis","it":"segmentazione-tecnografica","ja":"テクノグラフィック-セグメンテーション","ko":"기술통계-세분화","pt":"segmentacao-tecnografica","tr":"teknografik-segmentasyon","vi":"phan-khuc-technographic"}},"304":{"url":"segmentazione-tecnografica","head":"Cos'è la Segmentazione Tecnografica e Perché è Importante?","enCategory":"Marketing segmentation","parent":"58","lang":"it","desc":"La segmentazione tecnografica divide i tuoi clienti in base al loro utilizzo della tecnologia e ai tassi di adozione. Scopri come può migliorare le tue attività di marketing B2B e guidare la crescita dei clienti.","langNames":{"en":"English","ar":"Arabic","zh":"Chinese","nl":"Dutch","es":"Espanol","fr":"French","de":"German","he":"Hebrew","hi":"Hindi","id":"Indonesian","it":"Italian","ja":"Japanese","ko":"Korean","pt":"Portuguese","tr":"Turkish","vi":"Vietnamese"},"langUrls":{"en":"technographic-segmentation","ar":"التقسيم-التكنوغرافي","zh":"技术统计细分","nl":"technografische-segmentatie","es":"segmentacion-tecnografica","fr":"segmentation-technographique","de":"technografische-segmentierung","he":"סגמנטציה-טכנוגרפית","hi":"टेक्नोग्राफिक-सेगमेटेशन","id":"segmentasi-teknografis","it":"segmentazione-tecnografica","ja":"テクノグラフィック-セグメンテーション","ko":"기술통계-세분화","pt":"segmentacao-tecnografica","tr":"teknografik-segmentasyon","vi":"phan-khuc-technographic"}},"305":{"url":"テクノグラフィック-セグメンテーション","head":"テクノグラフィック・セグメンテーションとは何か、なぜ重要なのか？","enCategory":"Marketing segmentation","parent":"58","lang":"ja","desc":"テクノグラフィック・セグメンテーションは、技術の使用状況と採用率に基づいて顧客を分類します。B2Bマーケティング活動を強化し、顧客成長を促進する方法をご覧ください。","langNames":{"en":"English","ar":"Arabic","zh":"Chinese","nl":"Dutch","es":"Espanol","fr":"French","de":"German","he":"Hebrew","hi":"Hindi","id":"Indonesian","it":"Italian","ja":"Japanese","ko":"Korean","pt":"Portuguese","tr":"Turkish","vi":"Vietnamese"},"langUrls":{"en":"technographic-segmentation","ar":"التقسيم-التكنوغرافي","zh":"技术统计细分","nl":"technografische-segmentatie","es":"segmentacion-tecnografica","fr":"segmentation-technographique","de":"technografische-segmentierung","he":"סגמנטציה-טכנוגרפית","hi":"टेक्नोग्राफिक-सेगमेटेशन","id":"segmentasi-teknografis","it":"segmentazione-tecnografica","ja":"テクノグラフィック-セグメンテーション","ko":"기술통계-세분화","pt":"segmentacao-tecnografica","tr":"teknografik-segmentasyon","vi":"phan-khuc-technographic"}},"306":{"url":"기술통계-세분화","head":"기술통계 세분화란 무엇이며 왜 중요한가?","enCategory":"Marketing segmentation","parent":"58","lang":"ko","desc":"기술통계 세분화는 고객의 기술 사용 및 채택률에 따라 고객을 분류합니다. B2B 마케팅 노력을 향상시키고 고객 성장을 촉진하는 방법을 알아보세요.","langNames":{"en":"English","ar":"Arabic","zh":"Chinese","nl":"Dutch","es":"Espanol","fr":"French","de":"German","he":"Hebrew","hi":"Hindi","id":"Indonesian","it":"Italian","ja":"Japanese","ko":"Korean","pt":"Portuguese","tr":"Turkish","vi":"Vietnamese"},"langUrls":{"en":"technographic-segmentation","ar":"التقسيم-التكنوغرافي","zh":"技术统计细分","nl":"technografische-segmentatie","es":"segmentacion-tecnografica","fr":"segmentation-technographique","de":"technografische-segmentierung","he":"סגמנטציה-טכנוגרפית","hi":"टेक्नोग्राफिक-सेगमेटेशन","id":"segmentasi-teknografis","it":"segmentazione-tecnografica","ja":"テクノグラフィック-セグメンテーション","ko":"기술통계-세분화","pt":"segmentacao-tecnografica","tr":"teknografik-segmentasyon","vi":"phan-khuc-technographic"}},"307":{"url":"segmentacao-tecnografica","head":"O que é Segmentação Tecnográfica e Por Que é Importante?","enCategory":"Marketing segmentation","parent":"58","lang":"pt","desc":"A seg