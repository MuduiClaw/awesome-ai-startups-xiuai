55C7.95118 3.65829 7.95118 3.34171 8.14645 3.14645Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg></span></div></a></div></div><div class="mb-10"><h2 class="text-2xl font-semibold mb-6 text-center text-cyan-300">Why Choose FantasyDraw?</h2><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"><div class="bg-white bg-opacity-10 rounded-lg p-6 flex flex-col items-center text-center"><div class="mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trophy h-8 w-8 text-yellow-400"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"></path></svg></div><h3 class="text-xl font-semibold mb-2">Compete</h3><p class="text-sm text-gray-300">Our current competition has a $500 prize to the first place winner.</p></div><div class="bg-white bg-opacity-10 rounded-lg p-6 flex flex-col items-center text-center"><div class="mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-8 w-8 text-blue-400"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div><h3 class="text-xl font-semibold mb-2">Select</h3><p class="text-sm text-gray-300">Choose one QB per week. Each QB can be pickedonly once throughout the entire season.</p></div><div class="bg-white bg-opacity-10 rounded-lg p-6 flex flex-col items-center text-center"><div class="mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trending-up h-8 w-8 text-green-400"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg></div><h3 class="text-xl font-semibold mb-2">Strategize</h3><p class="text-sm text-gray-300">Advance if your QB has more passing yards than his real life counterpart. Last survivor wins!</p></div><div class="bg-white bg-opacity-10 rounded-lg p-6 flex flex-col items-center text-center"><div class="mb-4"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar h-8 w-8 text-pink-400"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg></div><h3 class="text-xl font-semibold mb-2">Weekly</h3><p class="text-sm text-gray-300">Enjoy weekly matchups with more competitions coming soon!</p></div></div></div><div class="grid md:grid-cols-2 gap-8"><div class="bg-gray-800 bg-opacity-50 rounded-xl p-6 shadow-lg backdrop-blur-sm"><h3 class="text-2xl font-semibold mb-4 text-cyan-300">Latest Updates</h3><div class="h-[320px] overflow-hidden"><div class="text-white"><div class="relative w-full p-6 rounded-lg border bg-background md:shadow-xl overflow-hidden"><div class="h-[500px] overflow-hidden"><div class="flex flex-col items-center undefined"><div class="mx-auto w-full" style="opacity:1;will-change:transform,opacity;transform:none;transform-origin:50% 0% 0"><figure class="relative mx-auto min-h-fit w-full max-w-[400px] cursor-pointer overflow-hidden rounded-2xl p-4 transition-all duration-200 ease-in-out hover:scale-[103%] bg-white/10 backdrop-blur-md transform-gpu dark:bg-white/5 dark:[border:1px_solid_rgba(255,255,255