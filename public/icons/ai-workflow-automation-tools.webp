4 flex flex-wrap gap-2" data-astro-cid-g5sewvjw>  </ul> <p class="text-xs text-stone-500 mt-4" data-astro-cid-g5sewvjw>Added on Aug 4, 2024</p> </a> </li> <li class="bg-white rounded-lg shadow-sm hover:bg-stone-50 transition-all duration-300 border border-stone-300 flex flex-col h-full" data-astro-cid-g5sewvjw> <a href="/tools/celonis" class="block p-6 text-stone-800 hover:text-stone-900 flex flex-col h-full" data-astro-cid-g5sewvjw> <div class="flex-grow" data-astro-cid-g5sewvjw> <div class="w-1/2 aspect-[3/2] mb-2" data-astro-cid-g5sewvjw> <img src="/_astro/celonis.Dngwaltb_Z1rCzNo.svg" alt="Celonis logo" class="logo-filter max-h-full" data-astro-cid-g5sewvjw width="117" height="50" loading="lazy" decoding="async"> </div> <h2 class="text-lg font-semibold group-hover:text-stone-900" data-astro-cid-g5sewvjw> Celonis </h2> <p class="text-sm text-stone-600 line-clamp-3 text-ellipsis overflow-hidden mb-2" data-astro-cid-g5sewvjw> The Celonis Process Intelligence Platform — powered by process mining — lets you reveal and realize the value opportunities hiding in your business processes - fast. Get started quickly and scale infinitely. </p> </div> <ul class="mt-4 flex flex-wrap gap-2" data-astro-cid-g5sewvjw>  </ul> <p class="text-xs text-stone-500 mt-4" data-astro-cid-g5sewvjw>Added on Aug 2, 2024</p> </a> </li> <li class="bg-white rounded-lg shadow-sm hover:bg-stone-50 transition-all duration-300 border border-stone-300 flex flex-col h-full" data-astro-cid-g5sewvjw> <a href="/tools/flokzu" class="block p-6 text-stone-800 hover:text-stone-900 flex flex-col h-full" data-astro-cid-g5sewvjw> <div class="flex-grow" data-astro-cid-g5sewvjw> <div class="w-1/2 aspect-[3/2] mb-2" data-astro-cid-g5sewvjw> <img src="/_astro/flokzu.Bjoq7uiW_TXqSE.webp" alt="Flokzu logo" class="logo-filter max-h-full" data-astro-cid-g5sewvjw width="641" height="181" loading="lazy" decoding="async"> </div> <h2 class="text-lg font-semibold group-hover:text-stone-900" data-astro-cid-g5sewvjw> Flokzu <