    <script type="application/ld+json">
        {
            "@context": "https://schema.org/",
            "@type": "WebApplication",
            "name": "Ink With AI | AI Tattoo Design Generator",
            "applicationCategory": "Ink With AI | AI Tattoo Design Generator",
            "image": "https://inkwithai.com/images/icon.png",
            "description": "Describe your unique dream tattoo and our Tattoo Design Generator will craft it into reality. Just choose your art style and let the AI do the rest!"
