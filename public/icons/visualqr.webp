    <style>



   .btn-primary {
       border: none;
       background: #ff0084;
       background: -webkit-linear-gradient(to right, #861ea3, #ff369e, #bc42de, #ff0084);
       background: linear-gradient(to right, #861ea3, #ff369e, #bc42de, #ff0084);
       background-size: 300% 300%;
       -webkit-animation: gradientAniMation 5 ease infinite;
       -moz-animation: gradientAniMation 5s ease infinite;
       animation: gradientAniMation 5s ease infinite;
  }
   .btn-primary:hover {
       border: none;
       background-color: #ff0084;
       background-color: #ff0084;
       filter: brightness(115%);
       color: white;
  }
   .btn:hover {
       border-color: #ff0084;
  }
   .btn-secondary {
       background-color: #383838;
       border-color: #383838;
  }
   .btn-secondary:hover {
       background-color: #383838;
       filter: brightness(110%);
  }

   .form-control-inline {
       border-top-right-radius: 0;
       border-bottom-right-radius: 0;
  }
   .btn-inline {
       border-top-left-radius: 0;
       border-bottom-left-radius: 0;
       height: calc(3.5rem + 2px);
  }
   .carousel-inner {
       left: 10%;
       right: 10%;
  }
   .carousel-control-next, .carousel-control-prev {
       filter: invert(100%);
  }

   .loading-img {
       animation-duration: 1.25s;
       animation-fill-mode: forwards;
       animation-iteration-count: infinite;
       animation-name: placeHolderShimmer;
       animation-timing-function: linear;
       background: darkgray;

        background: linear-gradient(to right, #eeeeee 10%, #dddddd 18%, #eeeeee 33%);


       background-size: 800px 104px;
       height: 100px;
       position: relative;
  }
   @media only screen and (max-width: 600px) {
       .carousel-inner {
           left: 0%;
           right: 0%;
      }
       .form-control-inline {
           border-top-right-radius: 0.5rem !important;
           border-bottom-right-radius: 0.5rem !important;
      }
       .btn-inline {
           border-top-left-radius: 0.5rem !important;
           border-bottom-left-radius: 0.5rem !important;
           height: calc(3.5rem + 2px);
      }

  }

   @keyframes gradientAniMation {
       0%{
          background-position:0% 50%
      }
       50%{
          background-position:100% 50%
      }
       100%{
          background-position:0% 50%
      }
  }

   @keyframes placeHolderShimmer{
       0%{
           background-position: -468px 0
      }
       100%{
           background-position: 468px 0
      }
  }
</style>
