		/* Background image with 30% visibility */
		.hero-pattern::before {
			content: "";
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			background-image: url('https://csv2.ai/bg.webp');
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
			opacity: 1; /* 30% visibility of the background image */
			z-index: 1;
		}

		/* Ensure content is above background */
		.hero-pattern > div {
			position: relative;
			z-index: 2;
		}

		/* Smooth animation for links */
		.footer-link, .social-icon {
			transition: all 0.2s ease-in-out;
		}

		/* Define darkest Tailwind green colors */
