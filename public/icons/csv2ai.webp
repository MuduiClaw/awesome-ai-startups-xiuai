			<!-- HERO CTA BUTTON - Minimal rounded corners -->
			<a href="#signup" class="btn inline-block bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-8 shadow-lg transition-colors text-lg" style="border-radius: 2px;">Join the Waitlist</a>
