/* Popup */
.model {
	display: none;
	position: fixed;
	z-index: 9999;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	overflow: auto;
	background-color: rgb(0, 0, 0);
	background-color: rgb(0 0 0 / 72%);
}
.modal {
	display: none;
	position: fixed;
	z-index: 9999;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	overflow: auto;
	background-color: rgb(0, 0, 0);
	background-color: rgb(0 0 0 / 72%);
}

.modal-content.yt-vide {
	background-color: #ffffff;
	margin: 5% auto;
	padding: 20px;
	border: 0px solid #888;
	width: 70%;
}

/* The Close Button */
.close {
	color: white;
	font-size: 30px;
	font-weight: bold;
	background: black;
