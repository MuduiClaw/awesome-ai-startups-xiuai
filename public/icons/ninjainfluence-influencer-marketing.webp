	.set.mb-3 img.modalButton {
		width: 100%!important;
	}
	.model-toggle {
		cursor: pointer;
	}
	.model, .modal1 {
		position: fixed;
		z-index: 10000; /* 1 */
		top: 0;
		left: 0;
		visibility: hidden;
		width: 100%;
		height: 100%;
	}

	.model.is-visible, .modal1.is-visible {
		visibility: visible;
		display: block;
	}

	.modal-overlay {
		position: fixed;
		z-index: 10;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: hsla(0, 0%, 0%, 0.5);
		visibility: hidden;
		opacity: 0;
		transition: visibility 0s linear 0.3s, opacity 0.3s;
	}

	.model.is-visible .modal-overlay, .modal1.is-visible .modal-overlay{
		opacity: 1;
		visibility: visible;
		transition-delay: 0s;
	}

	.modal-wrapper {
		position: absolute;
		z-index: 9999;
		top: 50%;
		left: 50%;
		width: 40em;
		margin-left: 0;
		background-color: transparent;
		box-shadow: unset;
		border-radius: 6px;
		transform: translate(-50%, -50%)!important;
	}

	.modal-transition {
		transition: all 0.3s 0.12s;
		transform: translateY(-10%);
		opacity: 0;
	}

	.model.is-visible .modal-transition, .modal1.is-visible .modal-transition {
		transform: translateY(0);
		opacity: 1;
	}

	.modal-content img {
		width: 100%;
	}
	.modal-content {
		background-color: white;
		padding: 20px;
		border: 0px solid #888;
		width: 100%;
		display: block;
		margin: auto;
	}
	button.modal-close.model-toggle {
		background: #000000eb!important;
		padding: 10px;
		width: 45px;
		height: 45px;
		border-radius: 50%;
		line-height: 15px;
		position: absolute;
		right: -20px;
		top: -20px;
		z-index: 1;
		color: white;
		cursor:pointer;
	}


	.yt-vide iframe {
		height: 100%;
		min-height: 500px;
	}
	section.modalWindow {
		display: none;
		position: fixed;
		top: 10%;
		left: 43%;
		z-index: 99999999999 !important;
		width: 40em;
		min-height: 200px;
		margin-left: -300px;
		background: #FFF;
		cursor: default;
		border-radius:6px;

	}
	section.modalWindow img {
		width: 100%;
	}
	section.modals.overlay {
		display: none;
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		min-height: 100%;
		background:#00000047!important;
		z-index: 997;
		cursor: pointer;
		z-index: 99999999;
	}
	img.modalButton {
		cursor: pointer;
	}
	section.modalWindow section.modalWrapper {
		margin: 20px;
		border: 1px solid #DADADA;
		text-align: left;
		line-height: 20px !important;
	}
	.closeBtn {
		position: absolute;
		right: 10px;
		top: 6px;
		cursor: pointer;
	}
	section a.closeBtn {
		background: #000000eb!important;
		padding: 9px 0 0 14px;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		line-height: 15px;
		position: absolute;
		right: -23px;
		top: -20px;
		z-index: 1;
		color: white!important;
		cursor: pointer;
		text-decoration: none!important;
		border: 3px solid black;
		font-size: 10px;
	}
	section a.closeBtn:hover{
		border-color:white;
	}


	canvas {
		width: 100%;
	}
	section.banner-sect {
		margin: 0;
	}
	.btn-animate {
		position: relative;
		width: 250px;
		height: 100px;
		font-size: 30px;
		outline: none;
		background-color: #d9ff03;
		border: none;
		cursor: pointer;
		text-align: center;
		z-index: 5;
		border-radius: 10px;
	}
	.bubbles {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
	}
	.bubbles .bubble {
		position: absolute;
		width: var(--startSize);
		height: var(--startSize);
		background-color: rgba(217, 255, 3, 0.87);
		top: 0;
		left: var(--left);
		border-radius: 50%;
		opacity: 0;
		z-index: 3;
	}
	.btn-animate:hover {
		box-shadow: inset 0 -10px 15px rgba(0, 0, 0, 0.6);
	}
	.bubbles .bubble {
		animation: bubbles var(--duration) cubic-bezier(0.5, 0.3, 0.5, 0.5) 1;
	}
	@keyframes bubbles {
		from {
			top: 5px;
			opacity: 1;
		}
		to {
			top: var(--randomHeight);
			opacity: 0;
			width: 1px;
			height: 1px;
		}
	}
	@media screen and (min-width: 320px) and (max-width: 767px) {
		section.modalWindow {
			width: 355px!important;
			margin-left: -150px!important;

		}
		section.accordian-985 .content {
			padding-left: 35px!important;

		}
		.modal-wrapper.modal-transition button.modal-close.model-toggle {
			top: -130px;
		}
		.content img {
			width: 100%;
		}
		section.modalWrapper img {
			width: 100%;
			height: 100%;
			object-fit: cover;
		}
		.modal-wrapper {
			width: 350px;
		}
		button.modal-close.modal-toggle {
			right: -15px;
			top: -134px;
		}
		.set.mb-3 .d-flex {
			display: block!important;
		}
		.set.mb-3 img.modalButton {
			width: 100%!important;
		}
		img.modalButton {
			margin-bottom: 12px!important;
		}
	}

</style>
