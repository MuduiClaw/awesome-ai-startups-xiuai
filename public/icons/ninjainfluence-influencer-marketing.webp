<script type>
	const animateBtn = document.querySelector('.btn-animate');
	const bubbles = 100;
	let timer;

	getRandomNumber = (min = 0, max) => { 
		return Math.floor(Math.random() * (max - min) + min);
	}

	addBubblesToBtn = () => {
		const animateBtnParent = animateBtn.parentNode;
		const animteBtnParentWidth = animateBtnParent.offsetWidth;
		const bubblesDiv = animateBtnParent.querySelector('.bubbles');
		clearTimeout(timer);

		while (bubblesDiv.firstChild) {
			bubblesDiv.removeChild(bubblesDiv.firstChild);
		}

		bubblesDiv.classList.add("start-animate");

		for (let i = 0; i < bubbles; i++) {
			const randomLeft = getRandomNumber(0, animteBtnParentWidth-10);
			const duration = getRandomNumber(500, 2000);
			const randomHeight = getRandomNumber(30, 250);
			const startSize = getRandomNumber(5, 12);
			const appNode = document.createElement("SPAN");
			appNode.classList.add('bubble');
			appNode.style.cssText = "--left: " + randomLeft + "px; --duration: " + duration + "ms; --randomHeight: -" + randomHeight + "px; --startSize: " + startSize + "px; --endSize: ";
			bubblesDiv.appendChild(appNode);
		}

		timer = setTimeout(() => {
			bubblesDiv.classList.remove("start-animate");
			while (bubblesDiv.firstChild) {
				bubblesDiv.removeChild(bubblesDiv.firstChild);
			}
		}, 2000);
	}

	animateBtn.addEventListener('click', function() {
		addBubblesToBtn();
	});

</script>
