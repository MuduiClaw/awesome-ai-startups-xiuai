<script>
	// bootstrap accordion start
	jQuery(document).ready(function () {
		// Add minus icon for collapse element which is open by default
		jQuery(".collapse.show").each(function () {
			jQuery(this).prev(".card-header").find(".fal").addClass("fa-chevron-up").removeClass(
				"fa-chevron-down");
		});
		// Toggle plus minus icon on show hide of collapse element
		jQuery(".collapse").on('show.bs.collapse', function () {
			jQuery(this).prev(".card-header").find(".fal").removeClass("fa-chevron-down").addClass(
				"fa-chevron-up");
		}).on('hide.bs.collapse', function () {
			jQuery(this).prev(".card-header").find(".fal").removeClass("fa-chevron-up").addClass(
				"fa-chevron-down");
		});
	});
	// bootstrap accordion end
</script>
