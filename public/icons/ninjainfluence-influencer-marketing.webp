.bubbly-button,
.influ-find-form button#wpforms-submit-1582 {
	font-family: "Montserrat";
	display: inline-block;
	font-size: 18px;
	padding: 15px 20px;
	margin-top: 0px;
	margin-bottom: 0px;
	-webkit-appearance: none;
	appearance: none;
	background-color: #fe3ca6;
	color: #fff;
	border-radius: 10px;
	border: none;
	cursor: pointer;
	position: relative;
	transition: transform ease-in 0.1s, box-shadow ease-in 0.25s;
	box-shadow: 0 2px 25px rgb(254 60 166 / 47%);
	text-transform: uppercase;
	font-weight: 500;
	letter-spacing: 0px;
	 z-index: 1;
}
.bubbly-button:hover,
.influ-find-form button#wpforms-submit-1582:hover {
	outline: 0;
	color: #fff;
	text-decoration: none;
}
.bubbly-button:focus,
.influ-find-form button#wpforms-submit-1582:focus {
	outline: 0;
}
.bubbly-button:before,
.bubbly-button:after,
.influ-find-form button#wpforms-submit-1582:after,
.influ-find-form button#wpforms-submit-1582:before {
	position: absolute;
	content: "";
	display: block;
	width: 140%;
	height: 100%;
	left: -20%;
	z-index: -1000;
	transition: all ease-in-out 0.5s;
	background-repeat: no-repeat;
}
.bubbly-button:before,
.influ-find-form button#wpforms-submit-1582:before {
	display: none;
	top: -75%;
	background-image: radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, transparent 20%, #ff0081 20%, transparent 30%),
		radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, transparent 10%, #ff0081 15%, transparent 20%),
		radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, #ff0081 20%, transparent 20%);
	background-size: 10% 10%, 20% 20%, 15% 15%, 20% 20%, 18% 18%, 10% 10%, 15% 15%,
		10% 10%, 18% 18%;
}
.bubbly-button:after,
.influ-find-form button#wpforms-submit-1582:after {
	display: none;
	bottom: -75%;
	background-image: radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, transparent 10%, #ff0081 15%, transparent 20%),
		radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, #ff0081 20%, transparent 20%),
		radial-gradient(circle, #ff0081 20%, transparent 20%);
	background-size: 15% 15%, 20% 20%, 18% 18%, 20% 20%, 15% 15%, 10% 10%, 20% 20%;
}
.content-slide-main-sect {
	margin-bottom: 0;
}
.bubbly-button:active,
.bubbly-button:focus {
	transform: scale(0.9);
	background-color: #e60074 !important;
	box-shadow: 0 2px 25px rgba(255, 0, 130, 0.2);
}
.mains.button-m-div {
	position: relative;
}
section.slider-logo {
