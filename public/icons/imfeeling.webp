tent="Tune into your emotions. Enter your emotion,and discover a soundtrack."/><meta property="og:image" content="https://assetnftimages.s3.amazonaws.com/commonassets/emotions_preview.png"/><meta name="twitter:card" content="summary_large_image"/><meta property="twitter:domain" content="muzify.com"/><meta property="twitter:url" content="https://muzify.com/imfeeling"/><meta name="twitter:title" content="ImFeeling - Music for your emotions"/><meta name="twitter:description" content="Tune into your emotions. Enter your emotion,and discover a soundtrack."/><meta property="twitter:image" content="https://assetnftimages.s3.amazonaws.com/commonassets/emotions_preview.png"/><style>@keyframes wave{0%,100%{transform:rotate(-10deg)}50%{transform:rotate(10deg)}}#emojiWave{display:inline-block;animation:wave 1.5s ease-in-out infinite}#shareModal{display:none;position:fixed;z-index:1000;left:0;top:0;width:100%;height:100%;background-color:rgba(0,0,0,.4)}#shareModal .modal-content{background:#0d1628;margin:15% auto;padding:20px;width:80%;max-width:350px;box-shadow:0 0 10px rgba(0,0,0,.5);border-radius:24px}.share-link{color:#007bff;text-decoration:none}.share-input{width:100%;padding:10px;margin:10px 0;border-radius:4px;cursor:pointer;background:rgba(255,255,255,.05)}.close-btn{float:right;color:#000;border:none;cursor:pointer;border-radius:4px;padding-left:36px;padding-bottom:50px;border-radius:50%;width:80px;height:80px;display:flex;flex-flow:column nowrap;justify-content:center;align-items:center;cursor:pointer;transition:all 150ms}#shareButton{position:fixed;bottom:25px;right:10px;padding:10px 20px;background-color:#0d1628;color:#fff;border:none;border-radius:1000rem;cursor:pointer;box-shadow:0 4px 6px rgba(0,0,0,.1)}.suggest-btn{padding:10px 20px;background-color:#063431;color:#fff;border:none;border-radius:1000rem;cursor:pointer;box-shadow:0 4px 6px rgba(0,0,0,.1)}</style><script defer="defer" src="/imfeeling/static/js/main.804b236b.js"></script><link href="/imfeeling/static/css/main.1cbb8022.css" rel="stylesheet"></head><body><noscript>You need to enable JavaScript to run this app.</noscript><div id="root"></div><script defer="defer" async>const wavingHandEmoji="👋",shareMessage="Hey 👋,\n\nI came across this site and thought you might find it interesting.\n\nEnter your emotion, and discover a soundtrack!\n\n";function waitForElm(e){return new Promise((t=>{if(document.querySelector(e))return t(document.querySelector(e));const n=new MutationObserver((o=>{document.querySelector(e)&&(t(document.querySelector(e)),n.disconnect())}));n.observe(document.body,{childList:!0,subtree:!0})}))}function toggleModal(){const e=document.getElementById("shareModal");e.style.display="none"===e.style.display||""===e.style.display?"block":"none"}document.addEventListener("DOMContentLoaded",(()=>{waitForElm("#shareButton").then((e=>{document.getElementById("shareButton").addEventListener("click",(function(){navigator.share?navigator.share({text:shareMessage+" "+window.location.href}).then((()=>console.log("Thanks for sharing!"))).catch(console.error):function(){document.getElementById("shareUrl").value=window.location.href;const e=encodeURIComponent(shareMessage),t=encodeURIComponent(window.location.href);document.getElementById("twitterShare").href=`https://twitter.com/intent/tweet?text=${e}&url=${t}`,document.getElementById("whatappShare").href=`https://api.whatsapp.com/send?text=${e}${t}`,toggleModal()}()})),document.getElementById("shareUrl").onclick=function(){this.setSelectionRange(0,this.value.length)}}))}))</script></body></html>