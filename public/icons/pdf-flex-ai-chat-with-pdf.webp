[0,&quot;2023-10-27T07:49:43.806Z&quot;],&quot;updatedAt&quot;:[0,&quot;2023-10-27T12:02:02.947Z&quot;],&quot;isUrlSigned&quot;:[0,true]}]}]}]}],[0,{&quot;id&quot;:[0,17],&quot;text&quot;:[0,&quot;Password protection&quot;],&quot;description&quot;:[0,&quot;If you want to prevent others from opening, editing, or printing your documents, you can lock them down and control access.&quot;],&quot;icon&quot;:[0,{&quot;data&quot;:[0,{&quot;id&quot;:[0,416],&quot;attributes&quot;:[0,{&quot;name&quot;:[0,&quot;password-protect-pdf.svg&quot;],&quot;alternativeText&quot;:[0,&quot;Password Protect PDF&quot;],&quot;caption&quot;:[0,null],&quot;width&quot;:[0,56],&quot;height&quot;:[0,56],&quot;formats&quot;:[0,null],&quot;hash&quot;:[0,&quot;password-protection&quot;],&quot;ext&quot;:[0,&quot;.svg&quot;],&quot;mime&quot;:[0,&quot;image/svg+xml&quot;],&quot;size&quot;:[0,1.3],&quot;url&quot;:[0,&quot;https://pdfguru.com/static/password-protection.svg&quot;],&quot;previewUrl&quot;:[0,null],&quot;provider&quot;:[0,&quot;aws-s3&quot;],&quot;provider_metadata&quot;:[0,null],&quot;createdAt&quot;:[0,&quot;2023-10-27T07:49:43.743Z&quot;],&quot;updatedAt&quot;:[0,&quot;2023-10-27T12:02:40.083Z&quot;],&quot;isUrlSigned&quot;:[0,true]}]}]}]}]]],&quot;lang&quot;:[0,&quot;en&quot;],&quot;context&quot;:[0,&quot;home&quot;]}" ssr="" client="idle" opts="{&quot;name&quot;:&quot;Section&quot;,&quot;value&quot;:true}" await-children=""><section class=""><div class="mg:pb-6 box-content mx-auto max-w-[1280px] px-4 text-[#1D1D1D] md:px-20 md:pt-16 md:pb-0"><h2 class="text-center text-2xl font-black md:text-4xl-max" id="what-we-have-to-offer-beyond-pdf-editing">What we have to offer beyond PDF editing</h2><ul class="mt-4 grid grid-cols-1 gap-4 pb-12 md:mt-12 md:mt-[64px] md:gap-6 md:pb-0 lg:grid-cols-3"><li class="flex flex-col rounded-[28px] bg-[#F3F2F3] p-8 text-base"><div class="flex flex-row items-center gap-4"><img class="aspect-square w-[3.5rem] object-contain" src="https://pdfguru.com/static/fast-conversion.svg" alt="fast pdf converter" width="56" height="56"/><h3 class="text-xl font-bold">Fast conversion</h3></div><div class="mt-5 text-base md:mt-4">It takes about 5 seconds on average to convert from PDF or vice versa. Upload your file now and see for yourself!</div></li><li class="flex flex-col rounded-[28px] bg-[#F3F2F3] p-8 text-base"><div class="flex flex-row items-center gap-4"><img class="aspect-square w-[3.5rem] object-contain" src="https://pdfguru.com/static/safe-secure.svg" alt="secure pdf" width="57" height="57"/><h3 class="text-xl font-bold">Tax forms database</h3></div><div class="mt-5 text-base md:mt-4">We&#x27;ve gathered hundreds of tax, insurance, and other forms in one place to help you find and edit them with ease.</div></li><li class="flex flex-col rounded-[28px] bg-[#F3F2F3] p-8 text-base"><div class="flex flex-row items-center gap-4"><img class="aspect-square w-[3.5rem] object-contain" src="https://pdfguru.com/static/high-quality-of-visual-elements.svg" alt="PDF high quality visual elements" width="56" height="56"/><h3 class="text-xl font-bold">Merge PDFs into one</h3></div><div class="mt-5 text-base md:mt-4">Easily merge your contracts, reports, or presentations into a single PDF to keep everything organized and accessible.</div></li><li class="flex flex-col rounded-[28px] bg-[#F3F2F3] p-8 text-base"><div class="flex flex-row items-center gap-4"><img class="aspect-square w-[3.5rem] object-contain" src="https://pdfguru.com/static/easy-to-use.svg" alt="easy to use pdf" width="56" height="56"/><h3 class="text-xl font-bold">Easy e-Signature</h3></div><div class="mt-5 text-base md:mt-4">We offer 3 ways to sign PDF documents. You can either draw, type, or upload your signature as an image.</div></li><li class="flex flex-col rounded-[28px] bg-[#F3F2F3] p-8 text-base"><div class="flex flex-row items-center gap-4"><img class="aspect-square w-[3.5rem] object-contain" src="https://pdfguru.com/static/no-setup-required.svg" alt="no setup required" width="56" height="56"/><h3 class="text-xl font-bold">Compress PDF file size</h3></div><div class="mt-5 text-base md:mt-4">PDF Guru optimizes your files to make them easier to share and store, all while maintaining their original quality.</div></li><li class="flex flex-col rounded-[28px] bg-[#F3F2F3] p-8 text-base"><div class="flex flex-row items-center gap-4"><img class="aspect-square w-[3.5rem] object-contain" src="https://pdfguru.com/static/password-protection.svg" alt="Password Protect PDF" width="56" height="56"/><h3 class="text-xl font-bold">Password protection</h3></div><div class="mt-5 text-base md:mt-4">If you want to prevent others from opening, editing, or printing your documents, you can lock them down and control access.</div></li></ul></div></section><!--astro:end--></astro-island>    <astro-island uid="ZDzcEL" prefix="r5" component-url="/_astro/sections.d7168961.js" component-export="Section" renderer-url="/_astro/client.af180e1a.js" props="{&quot;id&quot;:[0,1],&quot;__component&quot;:[0,&quot;sections.media-says&quot;],&quot;title&quot;:[0,&quot;Media&quot;],&quot;media_says&quot;:[0,{&quot;data&quot;:[0,{&quot;id&quot;:[0,39],&quot;attributes&quot;:[0,{&quot;title&quot;:[0,&quot;Media About Us&quot;],&quot;createdAt&quot;:[0,&quot;2024-09-02T15:32:43.197Z&quot;],&quot;updatedAt&quot;:[0,&quot;2024-09-04T13:44:03.773Z&quot;],&quot;publishedAt&quot;:[0,&quot;2024-09-02T15:32:44.359Z&quot;],&quot;locale&quot;:[0,&quot;en&quot;],&quot;sections&quot;:[1,[[0,{&quot;id&quot;:[0,1],&quot;__component&quot;:[0,&quot;components.media-about-us&quot;],&quot;title&quot;:[0,&quot;Media About Us&quot;],&quot;media_about_us&quot;:[0,{&quot;id&quot;:[0,2266],&quot;text&quot;:[0,&quot;PDF Guru in the media&quot;],&quot;icon&quot;:[0,{&quot;data&quot;:[0,{&quot;id&quot;:[0,2248],&quot;attributes&quot;:[0,{&quot;name&quot;:[0,&quot;media-about-us.png&quot;],&quot;alternativeText&quot;:[0,&quot;Media that is writing about PDF Guru: the Washington Post, the Guardian, 