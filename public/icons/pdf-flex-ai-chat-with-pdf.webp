4-09-14 4:50&quot;],&quot;author&quot;:[0,&quot;jiro.ami&quot;],&quot;title&quot;:[0,&quot;すごく簡単で分かりやすかったです&quot;],&quot;text&quot;:[0,&quot;すごく簡単で分かりやすかったです。&quot;],&quot;stars&quot;:[0,5],&quot;locale&quot;:[0,&quot;ja&quot;],&quot;slug&quot;:[0,&quot;&quot;]}],[0,{&quot;id&quot;:[0,&quot;66cbdc0912fc30be9e0eaa47&quot;],&quot;createdAt&quot;:[0,&quot;2024-08-26 3:36&quot;],&quot;author&quot;:[0,&quot;koichi&quot;],&quot;title&quot;:[0,&quot;ｐｄｆの変換&quot;],&quot;text&quot;:[0,&quot;パソコンが得意ではない者にとっては画期的でした。&quot;],&quot;stars&quot;:[0,5],&quot;locale&quot;:[0,&quot;ja&quot;],&quot;slug&quot;:[0,&quot;&quot;]}],[0,{&quot;id&quot;:[0,&quot;670092d91728014d783e2ecd&quot;],&quot;createdAt&quot;:[0,&quot;2024-10-05 3:14&quot;],&quot;author&quot;:[0,&quot;trinarobinsonmusic&quot;],&quot;title&quot;:[0,&quot;Εύκολο και βολικό&quot;],&quot;text&quot;:[0,&quot;Εύκολο και βολικό&quot;],&quot;stars&quot;:[0,5],&quot;locale&quot;:[0,&quot;el&quot;],&quot;slug&quot;:[0,&quot;&quot;]}],[0,{&quot;id&quot;:[0,&quot;66f26f324dee5e8865768f63&quot;],&quot;createdAt&quot;:[0,&quot;2024-09-24 9:50&quot;],&quot;author&quot;:[0,&quot;Aliaksandr Salauyou&quot;],&quot;title&quot;:[0,&quot;Το PDF Guru είναι το καλύτερο&quot;],&quot;text&quot;:[0,&quot;Ένα τεράστιο ευχαριστώ στο PDF Guru για το έργο του. Εξαιρετικό προϊόν και ακόμη καλύτερη εξυπηρέτηση πελατών. Πολύ ευχάριστοι και επαγγελματίες άνθρωποι για να συνεργαστείτε.&quot;],&quot;stars&quot;:[0,5],&quot;locale&quot;:[0,&quot;el&quot;],&quot;slug&quot;:[0,&quot;&quot;]}],[0,{&quot;id&quot;:[0,&quot;67011f250c0d2b99229e1096&quot;],&quot;createdAt&quot;:[0,&quot;2024-10-05 13:12&quot;],&quot;author&quot;:[0,&quot;Sue Lea&quot;],&quot;title&quot;:[0,&quot;Γρήγορη απάντηση στο ερώτημά μου&quot;],&quot;text&quot;:[0,&quot;Γρήγορη ανταπόκριση στο ερώτημά μου. Εξαιρετική.&quot;],&quot;stars&quot;:[0,5],&quot;locale&quot;:[0,&quot;el&quot;],&quot;slug&quot;:[0,&quot;&quot;]}],[0,{&quot;id&quot;:[0,&quot;66f6946c817da3c63d02385d&quot;],&quot;cre