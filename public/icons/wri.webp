<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WriCo - AI-Powered Writing Assistant</title>
    <meta itemprop="description" content="The AI-powered writing app designed to help you generate ideas, develop characters, outline plots, and organize scenes like a pro. Enhance your creativity with AI-driven suggestions and bring your story to life effortlessly.">
    <meta itemprop="keywords" content="writing, app, AI, story, planner, creativity, characters, plots, scenes, ideas, suggestions">
    <meta itemprop="author" content="TooflexDev">
    <met itemprop="image" content="https://writercopilot.app/logo.png">

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#c2a686',
                        secondary: '#8c7a61',
                        accent: '#e6d7c3',
                        dark: '#4a4139',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }
    </style>
</head>

<body class="bg-accent/10">
    <header class="bg-white shadow-md fixed w-full z-10">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
