="M48 64C21.5 64 0 85.5 0 112c0 15.1 7.1 29.3 19.2 38.4L236.8 313.6c11.4 8.5 27 8.5 38.4 0L492.8 150.4c12.1-9.1 19.2-23.3 19.2-38.4c0-26.5-21.5-48-48-48H48zM0 176V384c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V176L294.4 339.2c-22.8 17.1-54 17.1-76.8 0L0 176z"></path></svg></span></div><div class="dorik-wrapper dorik-heading-sab1e4uq-wrapper "><h5 class="dorik-heading dorik-heading-sab1e4uq "><span>Email Us</span></h5></div><div class="dorik-text dorik-text-4rctpzr4 ">Send us an email</div></div></div><div class="col-lg-1/3 col-md-1/3 "><div class="column-inner dorik-column-e550xlv4  1/3"><div class="dorik-icon-rnq0s014-wrapper  "><span class="dorik-icon dorik-icon-rnq0s014  "><svg aria-hidden="true" focusable="false" data-prefix="fas" data-icon="phone" class="svg-inline--fa fa-phone fa-fw icon " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" data-testid="icon-test"><path fill="currentColor" d="M164.9 24.6c-7.7-18.6-28-28.5-47.4-23.2l-88 24C12.1 30.2 0 46 0 64C0 311.4 200.6 512 448 512c18 0 33.8-12.1 38.6-29.5l24-88c5.3-19.4-4.6-39.7-23.2-47.4l-96-40c-16.3-6.8-35.2-2.1-46.3 11.6L304.7 368C234.3 334.7 177.3 277.7 144 207.3L193.3 167c13.7-11.2 18.4-30 11.6-46.3l-40-96z"></path></svg></span></div><div class="dorik-wrapper dorik-heading-kkrlu7sb-wrapper "><h5 class="dorik-heading dorik-heading-kkrlu7sb "><span>Call Us</span></h5></div><div class="dorik-text dorik-text-tth7u3fn ">Give us a ring</div></div></div><div class="col-lg-1/3 col-md-1/3 "><div class="column-inner dorik-column-g5sa94yv  1/3"><div class="dorik-icon-u2ms7dzf-wrapper  "><span class="dorik-icon dorik-icon-u2ms7dzf  "><svg aria-hidden="true" focusable="false" data-prefix="fab" data-icon="twitter" class="svg-inline--fa fa-twitter fa-fw icon " role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" data-testid="icon-test"><path fill="currentColor" d="M459.37 151.716c.325 4.548.325 9.097.325 13.645 0 138.72-105.583 298.558-298.558 298.558-59.452 0-114.68-17.219-161.137-4