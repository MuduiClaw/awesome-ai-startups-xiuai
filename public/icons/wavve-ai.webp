-between items-start md:px-[32px] mt-16 gap-x-[70px]"><div class="flex-1 flex flex-col justify-start items-start gap-y-12"><div class="flex flex-row justify-start items-start gap-x-6 w-full"><div class="min-w-12 min-h-12 rounded-full border-[5px] border-solid border-[#C0D0FF] bg-[#F1F5FF] flex flex-col justify-center items-center"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.5 9H15.5" stroke="#384B7D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 12H15.5" stroke="#384B7D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M9.5 15H12.5" stroke="#384B7D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M15.1906 20.25H5C4.80109 20.25 4.61032 20.171 4.46967 20.0303C4.32902 19.8897 4.25 19.6989 4.25 19.5V4.5C4.25 4.30109 4.32902 4.11032 4.46967 3.96967C4.61032 3.82902 4.80109 3.75 5 3.75H20C20.1989 3.75 20.3897 3.82902 20.5303 3.96967C20.671 4.11032 20.75 4.30109 20.75 4.5V14.6906C20.7503 14.788 20.7315 14.8845 20.6945 14.9746C20.6575 15.0647 20.6031 15.1466 20.5344 15.2156L15.7156 20.0344C15.6466 20.1031 15.5647 20.1575 15.4746 20.1945C15.3845 20.2315 15.288 20.2503 15.1906 20.25V20.25Z" stroke="#384B7D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M20.6844 15H15.5V20.1844" stroke="#384B7D" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div><div class="flex flex-col justify-start items-start gap-y-2"><p class="text-[#101828] font-semibold text-[20px] leading-[30px]">Long form Editor</p><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Whether you&#x27;re capturing audio notes or uploading files or
                writing content, Wavve will convert it into high quality text.</p></div></div><div class="flex flex-row justify-start items-start gap-x-6 w-full"><div class="min-w-12 min-h-12 rounded-full border-[5px] border-solid border-[#C0D0FF] bg-[#F1F5FF] flex flex-col justify-center items-center"><svg width="20" height="22" viewBox="0 0 20 22" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10.9325 1L2.02593 11.6879C1.67713 12.1064 1.50272 12.3157 1.50006 12.4925C1.49774 12.6461 1.56621 12.7923 1.68574 12.8889C1.82323 13 2.09566 13 2.64051 13H9.93248L8.93248 21L17.839 10.3121C18.1878 9.89358 18.3622 9.68429 18.3649 9.50754C18.3672 9.35388 18.2987 9.2077 18.1792 9.11111C18.0417 9 17.7693 9 17.2244 9H9.93248L10.9325 1Z" stroke="#384B7D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></div><div class="flex flex-col justify-start items-start gap-y-2"><p class="text-[#101828] font-semibold text-[20px] leading-[30px]">Instant Speech to Text</p><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Whether you&#x27;re capturing audio notes or uploading files or
                writing content, Wavve will convert it into high quality text.</p></div></div><div class="flex flex-row justify-start items-start gap-x-6 w-full"><div class="min-w-12 min-h-12 rounded-full border-[5px] border-solid border-[#C0D0FF] bg-[#F1F5FF] flex flex-col justify-center items-center"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M11.5 3H8.3C6.61984 3 5.77976 3 5.13803 3.32698C4.57354 3.6146 4.1146 4.07354 3.82698 4.63803C3.5 5.27976 3.5 6.11984 3.5 7.8V16.2C3.5 17.8802 3.5 18.7202 3.82698 19.362C4.1146 19.9265 4.57354 20.3854 5.13803 20.673C5.77976 21 6.61984 21 8.3 21H16.7C18.3802 21 19.2202 21 19.862 20.673C20.4265 20.3854 20.8854 19.9265 21.173 19.362C21.5 18.7202 21.5 17.8802 21.5 16.2V13M12.5 8H16.5V12M16 3.5V2M19.9393 4.56066L21 3.5M21.0103 8.5H22.5103M3.5 13.3471C4.15194 13.4478 4.81987 13.5 5.5 13.5C9.88636 13.5 13.7653 11.3276 16.1197 8" stroke="#384B7D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></div><div class="flex flex-col justify-start items-start gap-y-2"><p class="text-[#101828] font-semibold text-[20px] leading-[30px]">Export in various formats</p><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Whether you&#x27;re capturing audio notes or uploading files or
                writing content, Wavve will convert it into high quality text.</p></div></div></div><div class="flex-1 md:min-w-[576px] max-md:w-full max-md:scale-90 flex flex-col justify-start items-start py-9 bg-white border border-solid border-[#EAECF0] shadow-md rounded-2xl"><div class="flex flex-col md:flex-row gap-y-[32px] justify-between items-start md:items-center w-full px-8 pb-[32px] border-b-[1px] border-solid border-[#EAECF0]"><div class="flex flex-col justify-start items-start"><span class="flex flex-row justify-start items-center gap-x-2"><p class="text-[#101828] text-[24px] leading-[32px] font-semibold">Combo Plan</p><p class="px-[10px] py-0.5 bg-[#F3F6FF] rounded-full text-[#383B43] font-medium text-[14px] leading-[20px]">Popular</p></span><p class="text-[#475467] text-[16px] leading-[24px] mt-1">Listnr TTS + Wavve STT</p></div><span class="flex flex-row justify-start items-start gap-x-0.5"><p class="text-[#101828] font-semibold text-[36px] leading-[44px] pt-2">$</p><p class="text-[#101828] font-semibold text-[60px] leading-[72px]">10</p><p class="text-[#475467] text-[16px] leading-[24px] self-end pb-2">per month</p></span></div><div class="px-8 py-8 flex flex-col justify-start items-start border-b-[1px] border-solid border-[#EAECF0] w-full"><p class="text-[#101828] font-semibold text-[16px] leading-[24px]">FEATURES</p><div class="flex flex-col max-md:gap-y-4 md:flex-row justify-between items-start md:items-center mt-[24px] w-full gap-x-8"><div class="flex flex-col justify-start items-start gap-y-4"><span class="flex flex-row justify-start items-center gap-x-3"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="24" height="24" rx="12" fill="#D1FADF"></rect><path fill-rule="evenodd" clip-rule="evenodd" d="M17.5965 7.39016L10.4365 14.3002L8.5365 12.2702C8.1865 11.9402 7.6365 11.9202 7.2365 12.2002C6.8465 12.4902 6.7365 13.0002 6.9765 13.4102L9.2265 17.0702C9.4465 17.4102 9.8265 17.6202 10.2565 17.6202C10.6665 17.6202 11.0565 17.4102 11.2765 17.0702C11.6365 16.6002 18.5065 8.41016 18.5065 8.41016C19.4065 7.49016 18.3165 6.68016 17.5965 7.38016V7.39016Z" fill="#12B76A"></path></svg><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Human Text to Speech</p></span><span class="flex flex-row justify-start items-center gap-x-3"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="24" height="24" rx="12" fill="#D1FADF"></rect><path fill-rule="evenodd" clip-rule="evenodd" d="M17.5965 7.39016L10.4365 14.3002L8.5365 12.2702C8.1865 11.9402 7.6365 11.9202 7.2365 12.2002C6.8465 12.4902 6.7365 13.0002 6.9765 13.4102L9.2265 17.0702C9.4465 17.4102 9.8265 17.6202 10.2565 17.6202C10.6665 17.6202 11.0565 17.4102 11.2765 17.0702C11.6365 16.6002 18.5065 8.41016 18.5065 8.41016C19.4065 7.49016 18.3165 6.68016 17.5965 7.38016V7.39016Z" fill="#12B76A"></path></svg><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Export to any format</p></span><span class="flex flex-row justify-start items-center gap-x-3"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="24" height="24" rx="12" fill="#D1FADF"></rect><path fill-rule="evenodd" clip-rule="evenodd" d="M17.5965 7.39016L10.4365 14.3002L8.5365 12.2702C8.1865 11.9402 7.6365 11.9202 7.2365 12.2002C6.8465 12.4902 6.7365 13.0002 6.9765 13.4102L9.2265 17.0702C9.4465 17.4102 9.8265 17.6202 10.2565 17.6202C10.6665 17.6202 11.0565 17.4102 11.2765 17.0702C11.6365 16.6002 18.5065 8.41016 18.5065 8.41016C19.4065 7.49016 18.3165 6.68016 17.5965 7.38016V7.39016Z" fill="#12B76A"></path></svg><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Long form editor</p></span><span class="flex flex-row justify-start items-center gap-x-3"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="24" height="24" rx="12" fill="#D1FADF"></rect><path fill-rule="evenodd" clip-rule="evenodd" d="M17.5965 7.39016L10.4365 14.3002L8.5365 12.2702C8.1865 11.9402 7.6365 11.9202 7.2365 12.2002C6.8465 12.4902 6.7365 13.0002 6.9765 13.4102L9.2265 17.0702C9.4465 17.4102 9.8265 17.6202 10.2565 17.6202C10.6665 17.6202 11.0565 17.4102 11.2765 17.0702C11.6365 16.6002 18.5065 8.41016 18.5065 8.41016C19.4065 7.49016 18.3165 6.68016 17.5965 7.38016V7.39016Z" fill="#12B76A"></path></svg><p class="text-[#475467] font-normal text-[16px] leading-[24px]">2000 words/month</p></span><span class="flex flex-row justify-start items-center gap-x-3"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="24" height="24" rx="12" fill="#D1FADF"></rect><path fill-rule="evenodd" clip-rule="evenodd" d="M17.5965 7.39016L10.4365 14.3002L8.5365 12.2702C8.1865 11.9402 7.6365 11.9202 7.2365 12.2002C6.8465 12.4902 6.7365 13.0002 6.9765 13.4102L9.2265 17.0702C9.4465 17.4102 9.8265 17.6202 10.2565 17.6202C10.6665 17.6202 11.0565 17.4102 11.2765 17.0702C11.6365 16.6002 18.5065 8.41016 18.5065 8.41016C19.4065 7.49016 18.3165 6.68016 17.5965 7.38016V7.39016Z" fill="#12B76A"></path></svg><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Multiple Speakers</p></span></div><div class="flex-1 flex flex-col justify-start items-start gap-y-4"><span class="flex flex-row justify-start items-center gap-x-3"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="24" height="24" rx="12" fill="#D1FADF"></rect><path fill-rule="evenodd" clip-rule="evenodd" d="M17.5965 7.39016L10.4365 14.3002L8.5365 12.2702C8.1865 11.9402 7.6365 11.9202 7.2365 12.2002C6.8465 12.4902 6.7365 13.0002 6.9765 13.4102L9.2265 17.0702C9.4465 17.4102 9.8265 17.6202 10.2565 17.6202C10.6665 17.6202 11.0565 17.4102 11.2765 17.0702C11.6365 16.6002 18.5065 8.41016 18.5065 8.41016C19.4065 7.49016 18.3165 6.68016 17.5965 7.38016V7.39016Z" fill="#12B76A"></path></svg><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Adjust tones</p></span><span class="flex flex-row justify-start items-center gap-x-3"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="24" height="24" rx="12" fill="#D1FADF"></rect><path fill-rule="evenodd" clip-rule="evenodd" d="M17.5965 7.39016L10.4365 14.3002L8.5365 12.2702C8.1865 11.9402 7.6365 11.9202 7.2365 12.2002C6.8465 12.4902 6.7365 13.0002 6.9765 13.4102L9.2265 17.0702C9.4465 17.4102 9.8265 17.6202 10.2565 17.6202C10.6665 17.6202 11.0565 17.4102 11.2765 17.0702C11.6365 16.6002 18.5065 8.41016 18.5065 8.41016C19.4065 7.49016 18.3165 6.68016 17.5965 7.38016V7.39016Z" fill="#12B76A"></path></svg><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Adjust Emotions</p></span><span class="flex flex-row justify-start items-center gap-x-3"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="24" height="24" rx="12" fill="#D1FADF"></rect><path fill-rule="evenodd" clip-rule="evenodd" d="M17.5965 7.39016L10.4365 14.3002L8.5365 12.2702C8.1865 11.9402 7.6365 11.9202 7.2365 12.2002C6.8465 12.4902 6.7365 13.0002 6.9765 13.4102L9.2265 17.0702C9.4465 17.4102 9.8265 17.6202 10.2565 17.6202C10.6665 17.6202 11.0565 17.4102 11.2765 17.0702C11.6365 16.6002 18.5065 8.41016 18.5065 8.41016C19.4065 7.49016 18.3165 6.68016 17.5965 7.38016V7.39016Z" fill="#12B76A"></path></svg><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Text to Video</p></span><span class="flex flex-row justify-start items-center gap-x-3"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="24" height="24" rx="12" fill="#D1FADF"></rect><path fill-rule="evenodd" clip-rule="evenodd" d="M17.5965 7.39016L10.4365 14.3002L8.5365 12.2702C8.1865 11.9402 7.6365 11.9202 7.2365 12.2002C6.8465 12.4902 6.7365 13.0002 6.9765 13.4102L9.2265 17.0702C9.4465 17.4102 9.8265 17.6202 10.2565 17.6202C10.6665 17.6202 11.0565 17.4102 11.2765 17.0702C11.6365 16.6002 18.5065 8.41016 18.5065 8.41016C19.4065 7.49016 18.3165 6.68016 17.5965 7.38016V7.39016Z" fill="#12B76A"></path></svg><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Future Updates</p></span><span class="flex flex-row justify-start items-center gap-x-3"><svg width="25" height="24" viewBox="0 0 25 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="0.5" width="24" height="24" rx="12" fill="#D1FADF"></rect><path fill-rule="evenodd" clip-rule="evenodd" d="M17.5965 7.39016L10.4365 14.3002L8.5365 12.2702C8.1865 11.9402 7.6365 11.9202 7.2365 12.2002C6.8465 12.4902 6.7365 13.0002 6.9765 13.4102L9.2265 17.0702C9.4465 17.4102 9.8265 17.6202 10.2565 17.6202C10.6665 17.6202 11.0565 17.4102 11.2765 17.0702C11.6365 16.6002 18.5065 8.41016 18.5065 8.41016C19.4065 7.49016 18.3165 6.68016 17.5965 7.38016V7.39016Z" fill="#12B76A"></path></svg><p class="text-[#475467] font-normal text-[16px] leading-[24px]">Feature requests</p></span></div></div></div><span class="w-full pt-[32px] px-[32px]"><button class="w-full bg-[#4E8AF4] shadow-sm py-3 text-white font-semibold text-[16px] leading-[24px] rounded-[8px]">Get Started</button></span></div></div></div></div><div class="w-full flex flex-col justify-start items-center relative z-10 max-md:-mt-[300px] mb-[130px]"><div class="w-full max-w-[1510px] px-[30px] md:px-[60px] lg:px-[100px] xl:px-[320px] flex flex-col justify-start items-center mt-[176px] gap-y-[16px]"><p class="mb-[44px] text-[#353C44] font-inter text-[36px] font-bold tracking-[-1.4%]">Frequently Asked Questions</p><div class="w-full rounded-lg bg-[#EEF5FC]"><button class="flex justify-between items-center w-full py-5 px-6 text-left"><p class="font-medium text-gray-800">What should I do if the record button doesn&#x27;t work?</p><span class="text-[#353C44] font-inter text-[32px] font-semibold max-md:p-2">+</span></button><div class="overflow-hidden transition-max-height duration-200 max-h-0"><div class="px-6 pb-5 text-gray-600">No need to worry—we can resolve this. It&#x27;s likely that Wavve AI hasn&#x27;t been granted microphone access. For mobile users, enable microphone access in your browser settings. If using iOS, first download the web app via Safari, then navigate to Settings &gt; Safari &gt; Microphone &gt; Allow Access to avoid repeated permission requests. On a desktop, adjust your browser&#x27;s settings to allow microphone access.</div></div></div><div class="w-full rounded-lg bg-[#EEF5FC]"><button class="flex justify-between items-center w-full py-5 px-6 text-left"><p class="font-medium text-gray-800">What can I do if Wavve AI is slow to summarize?</p><span class="text-[#353C44] font-inter text-[32px] font-semibold max-md:p-2">+</span></button><div class="overflow-hidden transition-max-height duration-200 max-h-0"><div class="px-6 pb-5 text-gray-600">If the app is taking a long time to transcribe and summarize, try refreshing the page. Afterwards, click the account icon in the top left corner and select &#x27;Retry Transcription&#x27; for a new attempt.</div></div></div><div class="w-full rounded-lg bg-[#EEF5FC]"><button class="flex justify-between items-center w-full py-5 px-6 text-left"><p class="font-medium text-gray-800">How does Wavve AI work?</p><span class="text-[#353C44] font-inter text-[32px] font-semibold max-md:p-2">+</span></button><div class="overflow-hidden transition-max-height duration-200 max-h-0"><div class="px-6 pb-5 text-gray-600">Wavve AI uses cutting-edge AI technology, including OpenAI&#x27;s Whisper among other audio models, to efficiently and accurately transcribe, summarize, and process your recordings.</div></div></div><div class="w-full rounded-lg bg-[#EEF5FC]"><button class="flex justify-between items-center w-full py-5 px-6 text-left"><p class="font-medium text-gray-800">Can I record audio from multiple sources at once?</p><span class="text-[#353C44] font-inter text-[32px] font-semibold max-md:p-2">+</span></button><div class="overflow-hidden transition-max-height duration-200 max-h-0"><div class="px-6 pb-5 text-gray-600">Currently, Wavve AI only records audio directly through your device&#x27;s microphone. Recording from additional sources like speakers is not supported.</div></div></div><div class="w-full rounded-lg bg-[#EEF5FC]"><button class="flex justify-between items-center w-full py-5 px-6 text-left"><p class="font-medium text-gray-800">What are the limits on audio length in Wavve AI?</p><span class="text-[#353C44] font-inter text-[32px] font-semibold max-md:p-2">+</span></button><div class="overflow-hidden transition-max-height duration-200 max-h-0"><div class="px-6 pb-5 text-gray-600">Audio recording limits vary by subscription plan: the free plan allows up to 5 minutes per note, the basic plan up to 15 minutes per note, and the premium plan accommodates up to 60 minutes per note.</div></div></div><div class="w-full rounded-lg bg-[#EEF5FC]"><button class="flex justify-between items-center w-full py-5 px-6 text-left"><p class="font-medium text-gray-800">How much does Wavve AI cost?</p><span class="text-[#353C44] font-inter text-[32px] font-semibold max-md:p-2">+</span></button><div class="overflow-hidden transition-max-height duration-200 max-h-0"><div class="px-6 pb-5 text-gray-600">Wavve AI offers an Individual plan at $9 per month and a Pro plan at $19 per month. For a limited time, users can also take advantage of a lifetime deal priced at $169 for the Individual plan and $199 for the Pro plan.</div></div></div><div class="w-full rounded-lg bg-[#EEF5FC]"><button class="flex justify-between items-center w-full py-5 px-6 text-left"><p class="font-medium text-gray-800">How many languages does Wavve AI support?</p><span class="text-[#353C44] font-inter text-[32px] font-semibold max-md:p-2">+</span></button><div class="overflow-hidden transition-max-height duration-200 max-h-0"><div class="px-6 pb-5 text-gray-600">Wavve AI is versatile, supporting a total of 141 languages including English, French, Czech, Chinese, Hindi, and many more, ensuring broad accessibility and utility.</div></div></div><div class="w-full rounded-lg bg-[#EEF5FC]"><button class="flex justify-between items-center w-full py-5 px-6 text-left"><p class="font-medium text-gray-800">What is the Listnr + Wavve AI combo plan?</p><span class="text-[#353C44] font-inter text-[32px] font-semibold max-md:p-2">+</span></button><div class="overflow-hidden transition-max-height duration-200 max-h-0"><div class="px-6 pb-5 text-gray-600">Current users can subscribe to a bundled Listnr + Wavve AI subscription for just $10 per month for the Individual plan, billed annually. This offer combines the strengths of both services for an enhanced experience.</div></div></div><div class="w-full rounded-lg bg-[#EEF5FC]"><button class="flex justify-between items-center w-full py-5 px-6 text-left"><p class="font-medium text-gray-800">Is there a WhatsApp integration for Wavve AI?</p><span class="text-[#353C44] font-inter text-[32px] font-semibold max-md:p-2">+</span></button><div class="overflow-hidden transition-max-height duration-200 max-h-0"><div class="px-6 pb-5 text-gray-600">A WhatsApp integration for Wavve AI is currently under development and is expected to be released within the next two months.</div></div></div><div class="w-full rounded-lg bg-[#EEF5FC]"><button class="flex justify-between items-center w-full py-5 px-6 text-left"><p class="font-medium text-gray-800">How can I contact Wavve AI support?</p><span class="text-[#353C44] font-inter text-[32px] font-semibold max-md:p-2">+</span></button><div class="overflow-hidden transition-max-height duration-200 max-h-0"><div class="px-6 pb-5 text-gray-600"><p>For assistance, you can reach out to Wavve AI support at<!-- --> <a href="mailto:support@wavve.ai" class="text-blue-800 hover:text-blue-600 transition-colors duration-150">support@wavve.ai</a>. We strive to respond to all inquiries within 48 hours or sooner.</p></div></div></div></div></div><div class="w-full h-fit relative max-md:-mb-[97px]"><div class="w-full flex flex-col md:flex-row justify-center max-xl:px-[40px] items-center border-b-[3px] border-solid border-[#4E8AF4]" style="background:linear-gradient(180deg, #FFFFFF 0%, #EEF5FC 100%)"><div class="flex flex-col justify-start items-start md:-mr-[150px] pb-[105px]"><p class="font-semibold text-[48px] max-w-[462px] leading-[54px] tracking-[-2.2%] text-[#383B43]">The Power of Wavve. In the palm of your hand.</p><p class="text-[18px] leading-[24px] tracking-[-1.4%] text-black/50 mt-[24px]">Now available as a PWA.</p><button class="mt-[32px] bg-[#4E8AF4] rounded-lg shadow-sm font-semibold text-white text-[16px] px-[65px] py-[12px]">Download</button></div><img alt="" loading="lazy" width="1359" height="996" decoding="async" data-nimg="1" class="pointer-events-none select-none w-[600px] self-end" style="color:transparent" srcSet="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FPWA_Image.56f6c52a.png&amp;w=1920&amp;q=75 1x, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2FPWA_Image.56f6c52a.png&amp;w=3840&amp;q=75 2x" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FPWA_Image.56f6c52a.png&amp;w=3840&amp;q=75"/></div></div><div class="w-full flex flex-col lg:flex-row justify-between items-start px-6 md:px-[] lg:px-[] xl:px-[112px] lg:pt-[96px] py-[64px] gap-y-[32px] max-xl:mt-[96px] bg-[#EEF5FC]"><div class="w-fit max-w-[369px] flex flex-col justify-start items-start"><a href="/"><img alt="Wavve logo" loading="lazy" width="92" height="18" decoding="async" data-nimg="1" style="color:transparent" src="/_next/static/media/WavveLogoName.9be4d041.svg"/></a><h2 class="mt-[34px]"><a rel="noopener noreferrer" target="_blank" class="mt-[32px] text-[#858585] font-normal leading-[200%]" href="https://listnr.notion.site/Welcome-to-Wavve-tech-Help-Center-d69bce9638134568b77bfb326e652246">Knowledgebase</a></h2><h2><a class="text-[#858585] font-normal leading-[200%]" href="/languages">Supported Languages</a></h2><h2><a class="text-[#858585] font-normal leading-[200%]" href="/affiliate-program">Affiliate Programme</a></h2><h2><a rel="noopener noreferrer" target="_blank" class="text-[#858585] font-normal leading-[200%]" href="https://wavve.feedbear.com/roadmap">Roadmap</a></h2></div><div class="flex flex-col justify-start items-end w-full lg:w-[50%] xl:w-[40%]"><div class="w-full grid grid-flow-row grid-cols-2 lg:grid-cols-2 gap-y-[32px] gap-x-6"><div class="w-full md:hidden"><div class="flex flex-col justify-start items-start"><p class="text-black/50 font-inter text-[16px] tracking-[-1.3%] font-medium mb-[8px]">Comparisons</p><a class="text-black font-inter text-[16px] font-medium leading-[22px] mb-[8px]" href="/wavve-vs-audionotes">Wavve vs Audionotes</a><a class="text-black font-inter text-[16px] font-medium leading-[22px] mb-[8px]" href="/wavve-vs-otter">Wavve vs Otter</a><a class="text-black font-inter text-[16px] font-medium leading-[22px] mb-[8px]" href="/wavve-vs-descript">Wavve vs Descript</a><a class="text-black font-inter text-[16px] font-medium leading-[22px] mb-[8px]" href="/wavve-vs-firefliesai">Wavve vs Fireflies AI</a><a class="text-black font-inter text-[16px] font-medium leading-[22px] mb-[8px]" href="/alternatives">Alternatives</a></div></div><div class="w-full max-md:hidden"><div class="flex flex-col justify-start items-start"><p class="text-black/50 font-inter text-[16px] tracking-[-1.3%] font-medium mb-[8px]">Comparisons</p><a class="text-black font-inter text-[16px] font-medium leading-[22px] mb-[8px]" href="/wavve-vs-audionotes">Wavve vs Audionotes</a><a class="text-black font-inter text-[16px] font-medium leading-[22px] mb-[8px]" href="/wavve-vs-otter">Wavve vs Otter</a><a class="text-black font-inter text-[16px] font-medium leading-[22px] mb-[8px]" href="/wavve-vs-descript">Wavve vs Descript</a><a class="text-black font-inter text-[16px] font-medium leading-[22px] mb-[8px]" hr