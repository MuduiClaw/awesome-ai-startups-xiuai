14.1819 8.83336 14.2528 9.02797 14.2497H11.2498V21.3091C11.2501 21.3617 11.2393 21.4137 11.2182 21.4618C11.197 21.5099 11.166 21.5531 11.1271 21.5884C11.0882 21.6238 11.0423 21.6506 10.9924 21.6671C10.9425 21.6836 10.8897 21.6894 10.8373 21.6841C5.88735 21.0841 2.06235 16.781 2.25922 11.6341C2.36974 9.09233 3.4694 6.69443 5.32347 4.95225C7.17755 3.21007 9.63917 2.26162 12.1829 2.30933C14.7266 2.35705 17.1509 3.39716 18.9384 5.20766C20.7258 7.01815 21.7347 9.45559 21.7498 11.9997Z" fill="#353C44"></path></svg></a></div></div><div class="w-screen h-screen flex flex-col justify-center items-center bg-black/50 absolute top-0 left-0 z-[999] hidden"><div class="rounded-2xl bg-white px-[14.2px] py-[20px] flex justify-center items-center"><svg width="37" height="20" viewBox="0 0 37 20" fill="none" xmlns="http://www.w3.org/2000/svg" class=""><path d="M14.9443 16L8.39888 4" stroke="#4E8AF4" stroke-width="6.54545" stroke-linecap="round" stroke-linejoin="round" class="svg-elem-1"></path><path d="M25.0454 16L18.5 4" stroke="#4E8AF4" stroke-width="6.54545" stroke-linecap="round" stroke-linejoin="round" class="svg-elem-2"></path><path d="M28.601 4L28.6009 3.99991" stroke="#4E8AF4" stroke-width="6.54545" stroke-linecap="round" stroke-linejoin="round" class="svg-elem-3"></path></svg></div><p class="mt-3 bold text-white">Please Wait</p></div></main></div><script id="__NEXT_DATA__" type="application/json" crossorigin="">{"props":{"pageProps":{}},"page":"/","query":{},"buildId":"yt9XIlDtcpvXKfq4nNi2X","nextExport":true,"autoExport":true,"isFallback":false,"scriptLoader":[{"src":"https://www.googletagmanager.com/gtag/js?id=G-4PN5BXZHFJ","strategy":"afterInteractive"},{"id":"google-analytics","strategy":"afterInteractive","children":"\n            window.dataLayer = window.dataLayer || [];\n            function gtag(){dataLayer.push(arguments);}\n            gtag('js', new Date());\n            gtag('config', 'G-4PN5BXZHFJ');\n          "}]}</script></body></html>