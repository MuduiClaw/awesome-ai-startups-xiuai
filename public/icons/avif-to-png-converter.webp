<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.6.0/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<script>

// This for Search
function search() {
        var input = document.getElementById('searchInput').value;
        console.log("Input: " + input); // Debugging message
        var xmlhttp;
        if (input.length == 0) {
            document.getElementById("suggestions").innerHTML = "";
            return;
        }
        xmlhttp = new XMLHttpRequest();
        xmlhttp.onreadystatechange = function() {
            console.log("Ready state: " + this.readyState); // Debugging message
            console.log("Status: " + this.status); // Debugging message
            if (this.readyState == 4 && this.status == 200) {
                document.getElementById("suggestions").innerHTML = this.responseText;
            }
        };
        xmlhttp.open("GET", "search.php?q=" + input, true);
        xmlhttp.send();
    }
// The above code for search

    function convertAVIFtoPNG() {
        const input = document.getElementById('input');
        const preview = document.getElementById('preview');
        const downloadBtn = document.getElementById('downloadBtn');
        const loading = document.getElementById('loading');
        const info = document.getElementById('info');
        const files = input.files;
        if (!files.length) return;

        preview.innerHTML = '';
        loading.style.display = 'block';
        info.innerHTML = '';

        const zip = new JSZip();
        let conversionsCompleted = 0;

        Array.from(files).forEach(file => {
            const reader = new FileReader();
            reader.onload = function (event) {
                const avifData = event.target.result;
                const avifBase64 = avifData.split(',')[1];
                const pngBase64 = avifToPng(avifBase64);
                zip.file(file.name.replace('.avif', '.png'), pngBase64, { base64: true });
                const pngImg = new Image();
                pngImg.src = 'data:image/png;base64,' + pngBase64;
                pngImg.classList.add('converted-image');
                preview.appendChild(pngImg);
                conversionsCompleted++;
                if (conversionsCompleted === files.length) {
                    loading.style.display = 'none';
                    downloadBtn.style.display = 'inline-block';
                    resetButton.style.display = 'inline-block';
                    downloadBtn.onclick = () => {
                        loading.style.display = 'block';
                        downloadBtn.style.display = 'none';
                        zip.generateAsync({ type: 'blob' }, function updateCallback(metadata) {
                            const percent = Math.floor((metadata.percent || 0) * 100);
                            loading.innerHTML = `Preparing download... (${percent}%)<br>Can you please wait till 10 thousand percent?<br>
We are preparing to throw the converted images or files in zip folder onto your screen`;
                        }).then(blob => {
                            loading.style.display = 'none';
                            downloadBtn.style.display = 'inline-block';
                            saveAs(blob, 'converted_images.zip');
                        });
                    };

                    info.innerHTML += `<h2>File Information</h2>`;
                    const table = document.createElement('table');
                    table.style.width = '100%';
                    table.style.borderCollapse = 'collapse';
                    table.style.borderRadius = '8px';
                    table.style.overflow = 'hidden';
                    table.style.marginTop = '20px';
                    table.innerHTML = `<tr>
                                        <th>AVIF File Name</th>
                                        <th>AVIF File Size</th>
                                        <th>AVIF File Extension</th>
                                        <th>Converted PNG File Name</th>
                                        <th>Converted PNG File Size</th>
                                        <th>Converted PNG File Extension</th>
                                    </tr>`;
                    Array.from(files).forEach(file => {
                        const avifFileSize = formatBytes(file.size);
                        const avifExtension = file.name.split('.').pop();
                        const pngFileName = file.name.replace('.avif', '.png');
                        const pngExtension = 'png';
                        const pngFileSize = formatBytes(pngBase64.length);

                        const row = document.createElement('tr');
                        row.innerHTML = `<td>${file.name}</td>
                                     <td>${avifFileSize}</td>
                                     <td>${avifExtension}</td>
                                     <td>${pngFileName}</td>
                                     <td>${pngFileSize}</td>
                                     <td>${pngExtension}</td>`;
                        table.appendChild(row);
                    });
                    info.appendChild(table);
                }
            };
            reader.readAsDataURL(file);
        });
    }

    function avifToPng(avifBase64) {
        return avifBase64; // Placeholder for actual conversion logic
    }

    function formatBytes(bytes, decimals = 2) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const dm = decimals < 0 ? 0 : decimals;
        const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }
    
    function resetConverter() {
        location.reload(); // Reload the page to reset the converter
    }
    
