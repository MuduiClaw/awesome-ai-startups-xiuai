tatic/chunks/5797-cc4ca9edb5b22bb3.js\",\"5408:static/chunks/5408-11392aaa3bd120ad.js\",\"8288:static/chunks/app/(tools)/tool/insightjini-chat-with-your-data/(index)/layout-eec3445f23b44cb1.js\"],\"name\":\"\",\"async\":false}\n"])</script><script>self.__next_f.push([1,"12:I{\"id\":35597,\"chunks\":[\"2272:static/chunks/webpack-e02ba7ea2ce48b60.js\",\"2971:static/chunks/fd9d1056-c4df96f52262f37e.js\",\"554:static/chunks/554-ec98dee2940ab2a2.js\"],\"name\":\"default\",\"async\":false}\n"])</script><script>self.__next_f.push([1,"15:I{\"id\":20978,\"chunks\":[\"8447:static/chunks/00cbbcb7-aa09979869cadc04.js\",\"3712:static/chunks/3627521c-c095c01fd723098c.js\",\"6115:static/chunks/8dc5345f-c93676e6b407673e.js\",\"1209:static/chunks/1209-7eb55cd608ded4e8.js\",\"228:static/chunks/228-66bf9bdcdd65500a.js\",\"1968:static/chunks/1968-caba4abf1b5fbed1.js\",\"1320:static/chunks/1320-bdeef88dfe5a6e7d.js\",\"4642:static/chunks/4642-3b881532037db80c.js\",\"131:static/chunks/131-d79a28afd91907dd.js\",\"9490:static/chunks/9490-7e1f07b1246a4821.js\",\"2218:static/chunks/2218-a3fe1db42d1d4f11.js\",\"9284:static/chunks/9284-5efc36daaf0c749b.js\",\"3741:static/chunks/3741-735375ec085743cc.js\",\"236:static/chunks/236-d00eab60de616da5.js\",\"5712:static/chunks/5712-32fc3ffdd132b1ff.js\",\"1273:static/chunks/1273-d1e4536f4b3db0d3.js\",\"7292:static/chunks/7292-1f8f34dc12a07389.js\",\"8565:static/chunks/8565-2d9bbb9270c8828f.js\",\"7969:static/chunks/7969-1f94969a42a9bfe5.js\",\"4934:static/chunks/4934-f0f8b4b29faf7685.js\",\"9302:static/chunks/9302-85bc65e68222e00b.js\",\"3066:static/chunks/3066-deae5ff09e566949.js\",\"4280:static/chunks/4280-89f13a3d2e85521f.js\",\"5797:static/chunks/5797-cc4ca9edb5b22bb3.js\",\"2801:static/chunks/2801-b19276798da334c0.js\",\"3136:static/chunks/app/(tools)/tool/insightjini-chat-with-your-data/(index)/page-8e230e234ab9098f.js\"],\"name\":\"\",\"async\":false}\n"])</script><script>self.__next_f.push([1,"f:T564,"])</script><script>self.__next_f.push([1,"Don't forget to join our brand new \u003ca href='https://discord.gg/7GFkQzEcSk' target='_blank' rel='noopener noreferrer nofollow'\u003e\u003cb\u003eDiscord community\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href='#'\u003e\u003cpath d='M26.0015 6.9529C24.0021 6.03845 21.8787 5.37198 19.6623 5C19.3833 5.48048 19.0733 6.13144 18.8563 6.64292C16.4989 6.30193 14.1585 6.30193 11.8336 6.64292C11.6166 6.13144 11.2911 5.48048 11.0276 5C8.79575 5.37198 6.67235 6.03845 4.6869 6.9529C0.672601 12.8736 -0.41235 18.6548 0.130124 24.3585C2.79599 26.2959 5.36889 27.4739 7.89682 28.2489C8.51679 27.4119 9.07477 26.5129 9.55525 25.5675C8.64079 25.2265 7.77283 24.808 6.93587 24.312C7.15286 24.1571 7.36986 23.9866 7.57135 23.8161C12.6241 26.1255 18.0969 26.1255 23.0876 23.8161C23.3046 23.9866 23.5061 24.1571 23.7231 24.312C22.8861 24.808 22.0182 25.2265 21.1037 25.5675C21.5842 26.5129 22.1422 27.4119 22.7621 28.2489C25.2885 27.4739 27.8769 26.2959 30.5288 24.3585C31.1952 17.7559 29.4733 12.0212 26.0015 6.9529ZM10.2527 20.8402C8.73376 20.8402 7.49382 19.4608 7.49382 17.7714C7.49382 16.082 8.70276 14.7025 10.2527 14.7025C11.7871 14.7025 13.0425 16.082 13.0115 17.7714C13.0115 19.4608 11.7871 20.8402 10.2527 20.8402ZM20.4373 20.8402C18.9183 20.8402 17.6768 19.4608 17.6768 17.7714C17.6768 16.082 18.8873 14.7025 20.4373 14.7025C21.9717 14.7025 23.2271 16.082 23.1961 17.7714C23.1961 19.4608 21.9872 20.8402 20.4373 20.8402Z'\u003e\u003c/path\u003e\u003c/a\u003e"])</script><script>self.__next_f.push([1,"10:T4d2,"])</script><script>self.__next_f.push([1,"Traditional methods of data analysis, such as using Excel or writing code, often prove to be challenging and time-consuming. Excel, while widely used, has limitations in handling large datasets and performing complex calculations. Manipulating and extracting insights from data can become cumbersome, requiring extensive manual effort and formula-based operations. On the other hand, writing code for data analysis demands specialized programming skills and a deep understanding of statistical analysis techniques. \u003cbr/\u003e\u003cbr/\u003e InsightJini bridges this gap by providing a user-friendly alternative that requires no programming knowledge. Its intuitive interface and automated data processing eliminate the need for complex coding or formula-based operations. Users can focus on exploring and understanding their data rather than wrestling with technical complexities. \u003cbr/\u003e\u003cbr/\u003e Moreover, InsightJini takes data analysis to the next level by integrating with ChatGPT. This integration allows users to have conversational interactions with their data, making the exploration process even more intuitive and interactive. By simply asking questions or providing prompts, users can obtain instant responses and delve deeper into their data."])</script><script>self.__next_f.push([1,"13:T564,"])</script><script>self.__next_f.push([1,"Don't forget to join our brand new \u003ca href='https://discord.gg/7GFkQzEcSk' target='_blank' rel='noopener noreferrer nofollow'\u003e\u003cb\u003eDiscord community\u003c/b\u003e\u003c/a\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href='#'\u003e\u003cpath d='M26.0015 6.9529C24.0021 6.03845 21.8787 5.37198 19.6623 5C19.3833 5.48048 19.0733 6.13144 18.8563 6.64292C16.4989 6.30193 14.1585 6.30193 11.8336 6.64292C11.6166 6.13144 11.2911 5.48048 11.0276 5C8.79575 5.37198 6.67235 6.03845 4.6869 6.9529C0.672601 12.8736 -0.41235 18.6548 0.130124 24.3585C2.79599 26.2959 5.36889 27.4739 7.89682 28.2489C8.51679 27.4119 9.07477 26.5129 9.55525 25.5675C8.64079 25.2265 7.77283 24.808 6.93587 24.312C7.15286 24.1571 7.36986 23.9866 7.57135 23.8161C12.6241 26.1255 18.0969 26.1255 23.0876 23.8161C23.3046 23.9866 23.5061 24.1571 23.7231 24.312C22.8861 24.808 22.0182 25.2265 21.1037 25.5675C21.5842 26.5129 22.1422 27.4119 22.7621 28.2489C25.2885 27.4739 27.8769 26.2959 30.5288 24.3585C31.1952 17.7559 29.4733 12.0212 26.0015 6.9529ZM10.2527 20.8402C8.73376 20.8402 7.49382 19.4608 7.49382 17.7714C7.49382 16.082 8.70276 14.7025 10.2527 14.7025C11.7871 14.7025 13.0425 16.082 13.0115 17.7714C13.0115 19.4608 11.7871 20.8402 10.2527 20.8402ZM20.4373 20.8402C18.9183 20.8402 17.6768 19.4608 17.6768 17.7714C17.6768 16.082 18.8873 14.7025 20.4373 14.7025C21.9717 14.7025 23.2271 16.082 23.1961 17.7714C23.1961 19.4608 21.9872 20.8402 20.4373 20.8402Z'\u003e\u003c/path\u003e\u003c/a\u003e"])</script><script>self.__next_f.push([1,"14:T4d2,"])</script><script>self.__next_f.push([1,"Traditional methods of data analysis, such as using Excel or writing code, often prove to be challenging and time-consuming. Excel, while widely used, has limitations in handling large datasets and performing complex calculations. Manipulating and extracting insights from data can become cumbersome, requiring extensive manual effort and formula-based operations. On the other hand, writing code for data analysis demands specialized programming skills and a deep understanding of statistical analysis techniques. \u003cbr/\u003e\u003cbr/\u003e InsightJini bridges this gap by providing a user-friendly alternative that requires no programming knowledge. Its intuitive interface and automated data processing eliminate the need for complex coding or formula-based operations. Users can focus on exploring and understanding their data rather than wrestling with technical complexities. \u003cbr/\u003e\u003cbr/\u003e Moreover, InsightJini takes data analysis to the next level by integrating with ChatGPT. This integration allows users to have conversational interactions with their data, making the exploration process even more intuitive and interactive. By simply asking questions or providing prompts, users can obtain instant responses and delve deeper into their data."])</script><script>self.__next_f.push([1,"d:[\"$\",\"$Le\",null,{\"ssr_params\":{\"ssr\":true,\"locale\":{\"title_h1\":\"Magic Tool AI. The ultimate productivity hub for all your needs.\",\"tool_selector_header\":\"Today I would like to:\",\"tool_selector_placeholder\":\"Search in the list of tools below\",\"tool_selector_suggest_text\":\"Can't find what you are looking for?\",\"tool_selector_suggest_link\":\"Request a new Tool or Feature\",\"share_title\":\"Share\",\"share_copy_page\":\"Copy Page URL\",\"about_title\":\"About\",\"advertise_title\":\"Advertise\",\"blog_title\":\"Blog\",\"contact_us\":\"Contact Us\",\"about_content\":\"\u003cstrong\u003e\u003ci\u003e“Simply, we help you become more productive”\u003c/i\u003e\u003c/strong\u003e \u003cp\u003eWe provide Super AI tools designed for specific tasks to enhance your productivity. Additionally, we offer dozens of free productivity tools that are utilized by millions of individuals. \u003c/p\u003e \u003cp\u003eOur toolset is strategically crafted to streamline your tasks and empower you to achieve better results in a shorter period.\u003c/p\u003e \u003cp\u003e\u003cb\u003eOur History\u003c/b\u003e: Magictool.ai (formerly online-toolz.com) started in 2011 as a way to give back to the online community by offering free software. Since then, we have managed to help millions of people around the globe increase their productivity. In 2022 alone, three million users from 242 countries used magictool.ai to accomplish their tasks.\u003c/p\u003e\",\"support_cta\":\"Have any further questions? please send us an email at \",\"how_it_works\":\"How it works?\",\"more_about_the_tool\":\"More about the tool\",\"did_you_like_the_tool\":\"Did you like this page?\",\"all_tools\":\"All Tools\",\"listing_of_all\":\"Listing of all\",\"tools_title\":\"Tools\",\"follow_title\":\"Follow\",\"join_title\":\"Join\",\"faq_title\":\"FAQ\",\"you_need_to_create_an_account\":\"ℹ️ You need to Create an Account to use this tool, please click on the \u003cb\u003eSign-in\u003c/b\u003e button on the top left corner of the page. You will get initial trial credits to try out our paid tools.\",\"ai_words_consumed\":\"AI Words consumed\",\"what_is_an_ai_word\":\"What is an AI Word?\",\"what_is_an_ai_word_text\":\"The number you see here is the number of AI Words consumed from your credits in this conversation thread. AI Words are different from normal words, please refer to the FAQ in the Pricing page for more details.\",\"generic_technical_tool_error\":\"Unfortunately an unexpected error occurred, sorry for that :( \u003cbr/\u003ePlease try again and then report it to support@magictool.ai if the problem still exists.\",\"log_in_link_title\":\"Sign in\",\"log_out_link_title\":\"Sign out\",\"ai_tool_title\":\"AI Tool\",\"paid_tool_title\":\"Paid Tool\",\"account_title\":\"Account\",\"pricing_title\":\"Pricing\",\"upload_data\":\"Upload Data\",\"cleaning_your_data\":\"Cleaning your data\",\"request_a_new_feature_title\":\"Request a new feature\",\"request_a_new_feature_text\":\"\u003cp\u003eWe are always looking for ways to improve our tools and add new features. If you have a suggestion for a new Feature or Tool then please let us know via the page below:\u003cbr/\u003e\u003cbr/\u003e\u003ca href='https://Magictool.canny.io/feature-requests' target='_blank' rel='noopener noreferrer nofollow' \u003ehttps://Magictool.canny.io/feature-requests\u003c/a\u003e\u003c/p\u003e\",\"you_need_to_create_an_account_title\":\"Please Sign-in or Create an Account\",\"you_need_to_create_an_account_content\":\"You need to sign-in to use this tool, if you don't have an account you can create one for free. Once you create an account you will get free trial credits to try out the tool.\",\"your_credits_consumed\":\"Unfortunately, your credits have been fully consumed.\",\"your_credits_consumed_content_1\":\"Unlock your full potential and supercharge your productivity by subscribing to our SaaS tools today. With a single subscription, you'll gain access to a plethora of \u003ca href='/tool/category/AI' target='_blank' rel='noopner'\u003eAI-powered tools\u003c/a\u003e, saving you valuable time and effort.\",\"your_credits_consumed_content_2\":\" Subscribe today and don't miss out on this deal.\",\"new_tools\":\"New Tools\",\"also_in_other_langs\":\"Also in your language\",\"agree\":\"Agree\",\"disagree\":\"Disagree\",\"subscribe\":\"Subscribe\",\"subscribe_desc\":\"Unlock your monthly dose of new productivity tools by subscribing to our newsletter\",\"feature_coming_soon\":\"This feature is coming soon!\",\"related_tools\":\"Related Tools\",\"back_title\":\"Go Back\",\"send_us_feedback_title\":\"Send us feedback or suggestions\",\"copy_title\":\"Copy\",\"also_known_as\":\"Also known as\",\"migration_msg_title\":\"Important information\",\"migration_msg_text\":\"\u003cimg src='/images/online-toolz-logo-2023.png' alt='online tools logo' className='migration-ot-image'/\u003e\u003cbr/\u003eIs now called \u003cb\u003emagictool.ai\u003c/b\u003e\u003cbr/\u003e\u003cimg src='/images/magictool-logo-darkbg.svg' alt='magic tool logo'/\u003e\u003cbr/\u003eEverything else stays the same, we just changed the name.\",\"migration_msg_text_2\":\"$f\",\"close_title\":\"Close\",\"blog_index_h1_title\":\"Magictool.AI Tech Blog\",\"install_extension_area_title\":\"Install Magictool AI now via the Chrome Store\",\"page_title\":\"InsightJini: Chat with your Data and get Instant Insights!\",\"page_meta_desc\":\"Chat with your data and get Instant Insights using our AI powered tool. Upload your data, get automatic insights and chat with your data to get more.\",\"page_h1\":\"InsightJini ✨ Chat with your Data and get Instant Insights!\",\"description\":\"Upload your data to get Instant Insights and Visualizations using our AI tool powered by ChatGPT. Chat with your data to get even more insights.\",\"how_it_works_text\":\"\u003col\u003e\u003cli\u003eUpload your Excel or CSV file\u003c/li\u003e \u003cli\u003eReview the Data\u003c/li\u003e\u003cli\u003eExplore your Charts and Insights\u003c/li\u003e\u003cli\u003eChat with your data to explore more\u003c/li\u003e\u003c/ol\u003e\",\"more_about_the_tool_text\":\"$10\",\"faq_text\":\"\u003ch3\u003eWhat type of files do you accept and what is the max size?\u003c/h3\u003e \u003cp\u003e You can upload Excel and CSV files, max file size is 100MB \u003c/p\u003e \u003ch3\u003eHow long do you store my data\u003c/h3\u003e \u003cp\u003e You data will will be stored on our server for 24 hours, afterwards it will be deleted \u003c/p\u003e \u003ch3\u003eDo you use ChatGPT for the chat feature?\u003c/h3\u003e \u003cp\u003e Yes, we use ChatGPT 3.5 API for the chat feature \u003c/p\u003e \u003ch3\u003eDo you offer an API?\u003c/h3\u003e \u003cp\u003e No we don't offer an API at the moment \u003c/p\u003e \u003ch3\u003eHow much does it cost to use the tool\u003c/h3\u003e \u003cp\u003e Each file upload costs 1 Task credit, also the chatting feature consumes from your AI Words credit \u003c/p\u003e\",\"no_cols_found_in_data\":\"No columns have been found in your data\",\"chat_greeting_msg\":\"Hello, I am InsightJini ✨\\nI can help you answer questions about your data. You can ask me 'Draw a chart about X' or 'What is the Max of column Y'\",\"dims_cant_be_empty\":\"Dimensions can't be empty\",\"dims_cant_be_the_same\":\"Dimensions 1 and 2 can't be the same\",\"first_dim_cant_be_empty\":\"First dimension can't be empty\",\"no_categorial_found\":\"No categorical columns have been found in your data.\",\"no_numeric_found\":\"No numeric columns have been found in your data.\",\"data_file_name_title\":\"This is your data file name\",\"reupload_title\":\"Re-upload or change your data file\",\"instant_insights\":\"Instant Insights\",\"charts\":\"Charts\",\"chat\":\"Chat\",\"data\":\"Data\",\"settings\":\"Settings\",\"dimension_one\":\"Dimension One\",\"dimension_two\":\"Dimension Two\",\"measures\":\"Measures\",\"data_sample\":\"Data Sample\",\"data_sample_title\":\"Below you could see the first 5 rows of your data.\",\"column_profiling\":\"Column Profiling\",\"column_profiling_title\":\"Below you could see profiling information for each column in your data.\",\"setting1_group_values_title\":\"Group values occurring less than 5 times as '* Others'\",\"setting2_remove_empty_title\":\"Remove empty values\",\"setting3_remove_outliers_title\":\"Remove outliers\",\"setting4_show_vertical_bars\":\"Show vertical bars\",\"chat_input_label\":\"Your question\",\"chat_input_placeholder\":\"Example: What is the max age in the data?\",\"restart_chat\":\"↻ Restart chat\",\"restart_tooltip\":\"Restart and clear the current chat thread!\",\"delete_data\":\"Delete My Data Now\",\"delete_data_conf_title\":\"Delete your data\",\"delete_data_conf_dialog_content\":\"Are you sure you want to delete your uploaded data?\",\"data_deleted_successfully\":\"Your data has been deleted successfully\",\"data_sample_question\":\"Interested in testing the tool but don't have a file to use?\",\"download_data_sample\":\"Download sample data\",\"Text2HexTool_Intent\":\"Convert from Text to Hex\",\"Hex2TextTool_Intent\":\"Convert from Hex to Text\",\"EncryptTool_Intent\":\"Encrypt Text\",\"DecryptTool_Intent\":\"Decrypt Text\",\"ChatGPTTool_Intent\":\"Chat with ChatGPT\",\"ParaphraseTool_Intent\":\"Paraphrase text\",\"SummarizeTool_Intent\":\"Summarize text\",\"DecodeEncodeUnicodeTool_Intent\":\"Decode or Encode Unicode\",\"HTMLDecoderEncoderTool_Intent\":\"Decode or Encode HTML\",\"InsightJiniTool_Intent\":\"Analyze my Excel data with InsightJini ✨\",\"ChatWithPDFTool_Intent\":\"Chat with your PDFs and Documents\",\"AIImageGenerationTool_Intent\":\"Generate AI Images using Stable Diffusion\",\"MagicEditorTool_Intent\":\"Coming Soon: Write your Thesis or Assignments with the help of AI using MagicEditor✨\",\"GrammarCheckerTool_Intent\":\"Check my Grammar and Spelling\",\"AIEmojiFinderTool_Intent\":\"Find Emojis using AI\",\"SummarizeArticlesTool_Intent\":\"Summarize Articles \u0026 Webpages\",\"CharacterMapTool_Intent\":\"Search the Character Map\",\"XSLTTransformationTool_Intent\":\"Transform XML using XSLT\",\"RandomTextGeneratorTool_Intent\":\"Generate Random Text\",\"TimestampToDateTool_Intent\":\"Convert Timestamp to Date\",\"OnlineClipboardTool_Intent\":\"Share text and links between devices\",\"BinaryToTextTool_Intent\":\"Convert from Binary to Text and vice versa\",\"HexToBinaryTool_Intent\":\"Convert from Hex to Binary and vice versa\",\"Base64DecodeTool_Intent\":\"Convert from Base64 to Text and vice versa\",\"XPathTesterTool_Intent\":\"Test XPath queries against an XML file\",\"JSONBeautifierTool_Intent\":\"Beautify and format JSON data\",\"CommaSeparatorTool_Intent\":\"Separate lines of text by commas\",\"CaseConvertTool_Intent\":\"Convert strings to upper or lower case\",\"CharacterCounterTool_Intent\":\"Count the number of characters in your text\",\"WordCounterTool_Intent\":\"Count the number of words in your text\",\"OnlineNotepadTool_Intent\":\"Write text using our Online Notepad\",\"URLDecoderEncoderTool_Intent\":\"Encode or Decode URLs\",\"upload_your_data\":\"Upload your data\",\"drag_and_drop_files_or_click\":\" Drag \u0026 drop some files here, or Click to select files\",\"file_types_accepted_msg\":\"We only accept CSV and Excel files (.xlsx, .xlsm, .xls). Max size: 100MB\",\"review_your_data\":\"Review your data\",\"you_data_has_been_cleaned_please_review\":\"Your file has been loaded and cleaned, please review the data and click Continue\",\"Upload_again\":\"Upload again\",\"continue\":\"Continue\",\"sample_of_top_5_note\":\" * Sample of top 5 rows\",\"data_cleaning_details\":\"Data cleaning details\"}},\"children\":[\"$\",\"$Lb\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\",\"(tools)\",\"children\",\"tool\",\"children\",\"insightjini-chat-with-your-data\",\"children\",\"(index)\",\"children\"],\"loading\":\"$undefined\",\"loadingStyles\":\"$undefined\",\"hasLoading\":false,\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"template\":[\"$\",\"$Lc\",null,{}],\"templateStyles\":\"$undefined\",\"notFound\":\"$undefined\",\"notFoundStyles\":\"$undefined\",\"childProp\":{\"current\":[\"$L11\",[\"$\",\"$L12\",null,{\"propsForComponent\":{\"params\":{\"ssr\":true,\"locale\":{\"title_h1\":\"Magic Tool AI. The ultimate productivity hub for all your needs.\",\"tool_selector_header\":\"Today I would like to:\",\"tool_selector_placeholder\":\"Search in the list of tools below\",\"tool_selector_suggest_text\":\"Can't find what you are looking for?\",\"tool_selector_suggest_link\":\"Request a new Tool or Feature\",\"share_title\":\"Share\",\"share_copy_page\":\"Copy Page URL\",\"about_title\":\"About\",\"advertise_title\":\"Advertise\",\"blog_title\":\"Blog\",\"contact_us\":\"Contact Us\",\"about_content\":\"\u003cstrong\u003e\u003ci\u003e“Simply, we help you become more productive”\u003c/i\u003e\u003c/strong\u003e \u003cp\u003eWe provide Super AI tools designed for specific tasks to enhance your productivity. Additionally, we offer dozens of free productivity tools that are utilized by millions of individuals. \u003c/p\u003e \u003cp\u003eOur toolset is strategically crafted to streamline your tasks and empower you to achieve better results in a shorter period.\u003c/p\u003e \u003cp\u003e\u003cb\u003eOur History\u003c/b\u003e: Magictool.ai (formerly online-toolz.com) started in 2011 as a way to give back to the online community by offering free software. Since then, we have managed to help millions of people around the globe increase their productivity. In 2022 alone, three million users from 242 countries used magictool.ai to accomplish their tasks.\u003c/p\u003e\",\"support_cta\":\"Have any further questions? please send us an email at \",\"how_it_works\":\"How it works?\",\"more_about_the_tool\":\"More about the tool\",\"did_you_like_the_tool\":\"Did you like this page?\",\"all_tools\":\"All Tools\",\"listing_of_all\":\"Listing of all\",\"tools_title\":\"Tools\",\"follow_title\":\"Follow\",\"join_title\":\"Join\",\"faq_title\":\"FAQ\",\"you_need_to_create_an_account\":\"ℹ️ You need to Create an Account to use this tool, please click on the \u003cb\u003eSign-in\u003c/b\u003e button on the top left corner of the page. You will get initial trial credits to try out our paid tools.\",\"ai_words_consumed\":\"AI Words consumed\",\"what_is_an_ai_word\":\"What is an AI Word?\",\"what_is_an_ai_word_text\":\"The number you see here is the number of AI Words consumed from your credits in this conversation thread. AI Words are different from normal words, please refer to the FAQ in the Pricing page for more details.\",\"generic_technical_tool_error\":\"Unfortunately an unexpected error occurred, sorry for that :( \u003cbr/\u003ePlease try again and then report it to support@magictool.ai if the problem still exists.\",\"log_in_link_title\":\"Sign in\",\"log_out_link_title\":\"Sign out\",\"ai_tool_title\":\"AI Tool\",\"paid_tool_title\":\"Paid Tool\",\"account_title\":\"Account\",\"pricing_title\":\"Pricing\",\"upload_data\":\"Upload Data\",\"cleaning_your_data\":\"Cleaning your data\",\"request_a_new_feature_title\":\"Request a new feature\",\"request_a_new_feature_text\":\"\u003cp\u003eWe are always looking for ways to improve our tools and add new features. If you have a suggestion for a new Feature or Tool then please let us know via the page below:\u003cbr/\u003e\u003cbr/\u003e\u003ca href='https://Magictool.canny.io/feature-requests' target='_blank' rel='noopener noreferrer nofollow' \u003ehttps://Magictool.canny.io/feature-requests\u003c/a\u003e\u003c/p\u003e\",\"you_need_to_create_an_account_title\":\"Please Sign-in or Create an Account\",\"you_need_to_create_an_account_content\":\"You need to sign-in to use this tool, if you don't have an account you can create one for free. Once you create an account you will get free trial credits to try out the tool.\",\"your_credits_consumed\":\"Unfortunately, your credits have been fully consumed.\",\"your_credits_consumed_content_1\":\"Unlock your full potential and supercharge your productivity by subscribing to our SaaS tools today. With a single subscription, you'll gain access to a plethora of \u003ca href='/tool/category/AI' target='_blank' rel='noopner'\u003eAI-powered tools\u003c/a\u003e, saving you valuable time and effort.\",\"your_credits_consumed_content_2\":\" Subscribe today and don't miss out on this deal.\",\"new_tools\":\"New Tools\",\"also_in_other_langs\":\"Also in your language\",\"agree\":\"Agree\",\"disagree\":\"Disagree\",\"subscribe\":\"Subscribe\",\"subscribe_desc\":\"Unlock your monthly dose of new productivity tools by subscribing to our newsletter\",\"feature_coming_soon\":\"This feature is coming soon!\",\"related_tools\":\"Related Tools\",\"back_title\":\"Go Back\",\"send_us_feedback_title\":\"Send us feedback or suggestions\",\"copy_title\":\"Copy\",\"also_known_as\":\"Also known as\",\"migration_msg_title\":\"Important information\",\"migration_msg_text\":\"\u003cimg src='/images/online-toolz-logo-2023.png' alt='online tools logo' className='migration-ot-image'/\u003e\u003cbr/\u003eIs now called \u003cb\u003emagictool.ai\u003c/b\u003e\u003cbr/\u003e\u003cimg src='/images/magictool-logo-darkbg.svg' alt='magic tool logo'/\u003e\u003cbr/\u003eEverything else stays the same, we just changed the name.\",\"migration_msg_text_2\":\"$13\",\"close_title\":\"Close\",\"blog_index_h1_title\":\"Magictool.AI Tech Blog\",\"install_extension_area_title\":\"Install Magictool AI now via the Chrome Store\",\"page_title\":\"InsightJini: Chat with your Data and get Instant Insights!\",\"page_meta_desc\":\"Chat with your data and get Instant Insights using our AI powered tool. Upload your data, get automatic insights and chat with your data to get more.\",\"page_h1\":\"InsightJini ✨ Chat with your Data and get Instant Insights!\",\"description\":\"Upload your data to get Instant Insights and Visualizations using our AI tool powered by ChatGPT. Chat with your data to get even more insights.\",\"how_it_works_text\":\"\u003col\u003e\u003cli\u003eUpload your Excel or CSV file\u003c/li\u003e \u003cli\u003eReview the Data\u003c/li\u003e\u003cli\u003eExplore your Charts and Insights\u003c/li\u003e\u003cli\u003eChat with your data to explore more\u003c/li\u003e\u003c/ol\u003e\",\"more_about_the_tool_text\":\"$14\",\"faq_text\":\"\u003ch3\u003eWhat type of files do you accept and what is the max size?\u003c/h3\u003e \u003cp\u003e You can upload Excel and CSV files, max file size is 100MB \u003c/p\u003e \u003ch3\u003eHow long do you store my data\u003c/h3\u003e \u003cp\u003e You data will will be stored on our server for 24 hours, afterwards it will be deleted \u003c/p\u003e \u003ch3\u003eDo you use ChatGPT for the chat feature?\u003c/h3\u003e \u003cp\u003e Yes, we use ChatGPT 3.5 API for the chat feature \u003c/p\u003e \u003ch3\u003eDo you offer an API?\u003c/h3\u003e \u003cp\u003e No we don't offer an API at the moment \u003c/p\u003e \u003ch3\u003eHow much does it cost to use the tool\u003c/h3\u003e \u003cp\u003e Each file upload costs 1 Task credit, also the chatting feature consumes from your AI Words credit \u003c/p\u003e\",\"no_cols_found_in_data\":\"No columns have been found in your data\",\"chat_greeting_msg\":\"Hello, I am InsightJini ✨\\nI can help you answer questions about your data. You can ask me 'Draw a chart about X' or 'What is the Max of column Y'\",\"dims_cant_be_empty\":\"Dimensions can't be empty\",\"dims_cant_be_the_same\":\"Dimensions 1 and 2 can't be the same\",\"first_dim_cant_be_empty\":\"First dimension can't be empty\",\"no_categorial_found\":\"No categorical columns have been found in your data.\",\"no_numeric_found\":\"No numeric columns have been found in your data.\",\"data_file_name_title\":\"This is your data file name\",\"reupload_title\":\"Re-upload or change your data file\",\"instant_insights\":\"Instant Insights\",\"charts\":\"Charts\",\"chat\":\"Chat\",\"data\":\"Data\",\"settings\":\"Settings\",\"dimension_one\":\"Dimension One\",\"dimension_two\":\"Dimension Two\",\"measures\":\"Measures\",\"data_sample\":\"Data Sample\",\"data_sample_title\":\"Below y