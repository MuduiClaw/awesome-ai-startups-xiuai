            </div>
            <div>Metal Graphics Acceleration</div>
          </div>
          <div class="tech-item">
            <div>
              <img alt="Tripod Detection" src="img/showcase_tripod@1x.png"
                   srcset="img/showcase_tripod@2x.png 2x, img/showcase_tripod@1x.png 1x" />
            </div>
            <div>Tripod Detection</div>
          </div>
          <div class="tech-item">
            <div>
              <img alt="Auto-Stabilize" src="img/showcase_stabilize@1x.png"
                   srcset="img/showcase_stabilize@2x.png 2x, img/showcase_stabilize@1x.png 1x" />
            </div>
            <div>Auto-Stabilize</div>
          </div>
          <div class="tech-item">
            <div>
              <img alt="Machine Learning" src="img/showcase_ml@1x.png"
                   srcset="img/showcase_ml@2x.png 2x, img/showcase_ml@1x.png 1x" />
            </div>
            <div>Machine Learning</div>
          </div>
          <div class="tech-item">
            <div>
              <img alt="Computer Vision" src="img/showcase_bmp@1x.png"
                   srcset="img/showcase_bmp@2x.png 2x, img/showcase_bmp@1x.png 1x" />
            </div>
            <div>Computer Vision</div>
          </div>
        </div>
