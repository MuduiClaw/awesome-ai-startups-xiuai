    </section>
  </div>

  <footer>
    <div class="footer-wrap">
      <div>
        <img alt="Spectre App Icon" src="img/spectre-app-icon@1x.png"
             srcset="img/spectre-app-icon@2x.png 2x, img/spectre-app-icon@1x.png 1x" />
      </div>
      <h1>Get Spectre now:</h1>
      <p>On sale for a limited time</p>
      <a href="https://spectre.cam/download" class="app-store-button" style="margin-top: 50px;">
        <div class="app-download-icon"></div>
        <div class="text-wrap">
          <div>Get it on the</div>
          <div class="app-store-text">App Store</div>
        </div>
      </a>
      <p style="margin-top: 100px;">Spectre is made by team that brought you <span class="yellow"><a href="https://halide.cam">Halide</a></span></p>
      <p>#SpectreShot</p>
    </div>
  </footer>

</body>

<script>
  function hideVid(vid) {
    vid.classList.add("hidden");
    vid.pause();
    setTimeout(() => {
      vid.currentTime = 0;
    }, 500);
  };
  function showVid(vid) {
    vid.play();
    vid.classList.remove("hidden");
  }
  function findAndPlay(event) {
    const vid = event.target.parentNode.querySelector("video");
    showVid(vid);
  };
  function findAndPause(event) {
    const vid = event.target.parentNode.querySelector("video");
    hideVid(vid);
  };
  function findAndToggle(event) {
    const vid = event.target.parentNode.querySelector("video");
    if (vid.paused) {
      showVid(vid);
    } else {
      hideVid(vid);
    }
  };
  document.querySelectorAll(".img-or-video").forEach((el) => {
    el.addEventListener("mouseenter", findAndPlay)
    el.addEventListener("mouseleave", findAndPause)
    el.addEventListener("touchstart", findAndToggle)
  })

  // In case JS isnt't enabled.
  const hero = document.getElementById("hero-img")
  function showHero(el) {
    el.classList.add("show-and-slide-in")
    el.classList.remove("hidden")
  }
  hero.classList.add("hidden");
  hero.onload = (event) => showHero(event.target);
  setTimeout(() => {
    showHero(hero)
  }, 1000)
</script>
</html>
