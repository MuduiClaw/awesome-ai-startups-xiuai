                        };

                        function getCookie_(name) {
                            var value = "; " + document.cookie;
                            var parts = value.split("; " + name + "=");
                            if (parts.length == 2) return parts.pop().split(";").shift();
                        }

                        MktoForms2.loadForm("//app-sjl.marketo.com",
                            "874-VIE-290",
                            5346,
                            function(form) {
                                form.onSuccess(function(values, followUpUrl) {
                                    formContractValues.formViewState = '';
                                    formContractValues.formSuccessStatus = 'success';
                                    window.postMessage(formContractValues, window.location.href);
                                    console.table(formContractValues);
                                    sessionStorage.setItem(formContractValues.mapType, formContractValues.formID);
                                    var prevIdVal = getCookie_(formContractValues.mapType);
                                    var newIdVal = "".concat(prevIdVal, " | ").concat(formContractValues.formID);
                                    document.cookie = "".concat(formContractValues.mapType, "=").concat(newIdVal) + ';path=/;SameSite=Lax;secure';
                                    document.cookie = "".concat("__multiSubmitJustSubmitted=true;path=/;SameSite=Lax;secure")
                                });
                            });

                        MktoForms2.whenReady(function(form) {
                            formContractValues.formID = form.getId();
                            formContractValues.mapAccountId = form.getFormElem().find('input[name="munchkinId"]').val();
                            var prevIdVal = getCookie_(formContractValues.mapType) || '';
                            var pageLang = document.getElementsByTagName('html')[0].getAttribute('lang').toLowerCase();
                            if ("pageUrl" in form.vals()) {
                                form.vals({ "pageUrl": window.location.href });
                            }
                            if (prevIdVal.includes(formContractValues.formID) && true) {
                                formContractValues.formViewState = 'previously submitted';
                                window.postMessage(formContractValues, window.location.href);
                                console.table(formContractValues);
                            } else {
                                formContractValues.formViewState = 'form viewed';
                                window.postMessage(formContractValues, window.location.href);
                                console.table(formContractValues);
                                document.cookie = "".concat(formContractValues.mapType, "=''") + ';path=/;SameSite=Lax;secure';
                            }

                            //Translation code starts
                            let formEl = form.getFormElem()[0];
                            let formTranslationMap = formEl.querySelector('#translateMap');

                            if (formTranslationMap != null) {
                                var ANCESTORS_STOR = '.mktoFormRow, .mktoFormCol',
                                    INPUTS_STOR = 'INPUT, SELECT, TEXTAREA, BUTTON',
                                    attrTag = 'data-wrapper-for',
                                    _forEach = Array.prototype.forEach;

                                // Add attribute tag to outer wrapper DIVs with their inner inputs' names
                                (function tagMktoWrappers(formEl) {
                                    _forEach.call(formEl.querySelectorAll(ANCESTORS_STOR), function (ancestor) {
                                        ancestor.setAttribute(attrTag, '');
                                        _forEach.call(ancestor.querySelectorAll(INPUTS_STOR), function (input) {
                                            var currentTag = ancestor.getAttribute(attrTag);
                                            if (input.type === "radio") {
                                                ancestor.setAttribute(attrTag, [currentTag ? currentTag : input.name].join(' ').trim());
                                            } else {
                                                var currentTag = ancestor.getAttribute(attrTag);
                                                ancestor.setAttribute(attrTag, [currentTag ? currentTag : '', input.id, input.name != input.id ? input.name : ''].join(' ').trim());
                                            }
                                        });
                                    });
                                })(formEl);

                                var currentLang = pageLang, // get current language setting (passed in URL or another method ... )
                                    translateMapEl = formEl.querySelector('#translateMap'), // get translations embedded in form rich text area
                                    translateMap = JSON.parse(translateMapEl.textContent || translateMapEl.innerText || translateMapEl.innerHTML),
                                    currentTranslations = translateMap[currentLang],
                                    submitButtonEl = formEl.querySelector('BUTTON[type="submit"]');

                                var fieldName, fieldTranslations, propertyName, propertyValue, translateTargetEl, translateTargetElChild, translateTargetElChildLink, translateTargetElSibling;
                                for (fieldName in currentTranslations) {
                                    fieldTranslations = currentTranslations[fieldName];
                                    for (propertyName in fieldTranslations) {
                                        propertyValue = fieldTranslations[propertyName];
                                        switch (propertyName) {
                                            case "label":
                                                translateTargetEl = formEl.querySelector('[data-wrapper-for="' + fieldName + '"] LABEL');
                                                document.documentElement.innerText ? translateTargetEl.lastChild.nodeValue = propertyValue : translateTargetEl.lastChild.textContent = propertyValue;
                                                break;
                                            case "validation":
                                                translateTargetEl = MktoForms2.$(formEl.querySelector('[data-wrapper-for="' + fieldName + '"] .mktoFieldDescriptor'));
                                                translateTargetEl.data('mktoFieldDescriptor').validationMessage = propertyValue;
                                                break;
                                            case "linkContent":
                                                const linkValue = propertyValue[0].link;
                                                const linkText = propertyValue[1].text;
                                                translateTargetEl = formEl.querySelector('[data-wrapper-for="' + fieldName + '"] LABEL');
                                                translateTargetEl.innerHTML += '<a href="' + linkValue + '">' + linkText + '</a>';
                                                break;
                                            case "option":
                                                for (let index = 0; index < propertyValue.length; ++index) {
                                                    const optionValue = propertyValue[index].value;
                                                    const optionText = propertyValue[index].text;

                                                    translateTargetEl = formEl.querySelector('[name="' + fieldName + '"]');
                                                    translateTargetElChild = translateTargetEl.querySelectorAll('option')[index];
                                                    if (translateTargetElChild.value === optionValue) {
                                                        translateTargetElChild.innerText = optionText;
                                                    }
                                                }
                                                break;
                                            case "radioButtons":
                                                for (let index = 0; index < propertyValue.length; ++index) {
                                                    const radioValue = propertyValue[index].value;
                                                    const radioText = propertyValue[index].text;

                                                    translateTargetEl = formEl.querySelectorAll('[name="' + fieldName + '"]')[index];
                                                    translateTargetElSibling = translateTargetEl.nextSibling;
                                                    if (translateTargetEl.value === radioValue) {
                                                        translateTargetElSibling = translateTargetEl.nextSibling;
                                                        translateTargetElSibling.innerText = radioText;
                                                    }
                                                }
                                                break;
                                            case "submit":
                                                translateTargetEl = submitButtonEl;
                                                translateTargetEl.innerHTML = propertyValue;
                                                break;
                                            case "submitProgress":
                                                submitButtonEl.setAttribute("data-submit-progress-text", propertyValue);
                                                form.onSubmit(function (form) {
                                                    if (form.submittable()) {
                                                        submitButtonEl.innerHTML = submitButtonEl.getAttribute("data-submit-progress-text");
                                                    }
                                                });
                                        }
                                    }
                                }
                            }
                            //Translation code ends
                        });
                    </script>

            


        </div>
