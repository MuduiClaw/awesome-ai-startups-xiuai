      <script>
         let llmData = []; // This will hold the fetched data
         
         async function fetchLLMPricing() {
            const apiUrl = 'https://llm-price.huhuhang.workers.dev/';
            try {
               const response = await fetch(apiUrl);
               const data = await response.json();
               llmData = data;
               populateTable(llmData);
               populateProviders(llmData);
            } catch (error) {
               console.error('Error fetching LLM pricing:', error);
            }
         }
         
         function populateTable(data) {
            const tableBody = document.getElementById('tableBody');
            tableBody.innerHTML = ''; // Clear existing table rows
            const loadingRow = document.getElementById('loadingRow');
         
            // Remove the loading animation row
            if (loadingRow) {
               loadingRow.remove();
            }
         
            data.forEach(record => {
               const updateTime = new Date(record.fields.update_time).toLocaleString('en-US', { timeZone: 'UTC', year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' });
               
               // Check current color theme
               const isDarkMode = document.documentElement.classList.contains('dark');
               
               // Construct logo file path
               const providerlogoPath = `/logos/${record.fields.provider.replace(/\s+/g, '').toLowerCase()}${isDarkMode ? '-dark' : '-light'}.svg`;
         
               const row = `<tr class="bg-gray-100 border-b dark:bg-gray-800 dark:border-gray-700">
                     <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">${record.fields.model_name}</td>
                     <td class="px-6 py-4"><img src="${providerlogoPath}" alt="${record.fields.provider} Logo" class="inline w-6 h-6 mr-2"></td>
                     <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
                        ${parseFloat(record.fields.input_tokens) === 0 ? 'N/A' : new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(record.fields.input_tokens)}
                     </td>
                     <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
                        ${parseFloat(record.fields.output_tokens) === 0 ? 'N/A' : new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(record.fields.output_tokens)}
                     </td>
                     <td class="px-6 py-4">${record.fields.url ? `<a href="${record.fields.url}" class="text-blue-400 hover:underline" target="_blank">${record.fields.provider}</a>` : ''}</td>
                     <td class="px-6 py-4">${updateTime}</td>
               </tr>`;
               tableBody.innerHTML += row;
            });
         }
         
         function populateProviders(data) {
             const providers = [...new Set(data.map(record => record.fields.provider))];
             const providerSelect = document.getElementById('providerFilter');
             providers.forEach(provider => {
                 const option = `<option value="${provider}">${provider}</option>`;
                 providerSelect.innerHTML += option;
             });
         }
         
         function filterData() {
             const providerFilter = document.getElementById('providerFilter').value;
             const modelSearch = document.getElementById('modelSearch').value.toLowerCase();
         
             const filteredData = llmData.filter(record => {
                 return (
                     (providerFilter === '' || record.fields.provider === providerFilter) &&
                     record.fields.model_name.toLowerCase().includes(modelSearch)
                 );
             });
         
             populateTable(filteredData);
         }
         
         document.getElementById('providerFilter').addEventListener('change', filterData);
         document.getElementById('modelSearch').addEventListener('keyup', filterData);
         
         fetchLLMPricing();
      </script>
      <script>
         function updateRecordCount() {
           const recordCount = document.getElementById('recordCount');
           const tableRows = document.querySelectorAll('#tableBody tr:not(#loadingRow)');
           if (tableRows.length === 0) {
         } else {
             recordCount.textContent = `${tableRows.length} records after filtering.`;
           }
         }
         
         window.addEventListener('load', updateRecordCount);
         document.getElementById('providerFilter').addEventListener('change', updateRecordCount);
         document.getElementById('modelSearch').addEventListener('keyup', updateRecordCount);
      </script>
      <script>
         var themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
         var themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');
         
         // Change the icon inside the button according to the previous settings.
         if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            themeToggleLightIcon.classList.remove('hidden');
         } else {
            themeToggleDarkIcon.classList.remove('hidden');
         }
         
         var themeToggleBtn = document.getElementById('theme-toggle');
         
         themeToggleBtn.addEventListener('click', function() {
            // Icon in the toggle button
            themeToggleDarkIcon.classList.toggle('hidden');
            themeToggleLightIcon.classList.toggle('hidden');
         
            // If a color theme has been set before
            if (localStorage.getItem('color-theme')) {
               if (localStorage.getItem('color-theme') === 'light') {
                     document.documentElement.classList.add('dark');
                     localStorage.setItem('color-theme', 'dark');
               } else {
                     document.documentElement.classList.remove('dark');
                     localStorage.setItem('color-theme', 'light');
               }
            // If no color theme has been set before
            } else {
               if (document.documentElement.classList.contains('dark')) {
                     document.documentElement.classList.remove('dark');
                     localStorage.setItem('color-theme', 'light');
               } else {
                     document.documentElement.classList.add('dark');
                     localStorage.setItem('color-theme', 'dark');
               }
            }
         
            // Re-call the populateTable function to update the logo.
            populateTable(llmData);
         });
      </script>
      <script>
         // Get <a> tag elements
         const sortModelNameLink = document.getElementById('sortModelName');
         const sortProvidersLink = document.getElementById('sortProviders');
         const sortInputTokensLink = document.getElementById('sortInputTokens');
         const sortOutputTokensLink = document.getElementById('sortOutputTokens');
         
         // Declare variables to store the current sort order
         let modelNameOrder = 'asc'; // Initially ascending
         let providersOrder = 'asc'; // Initially ascending
         let inputTokensOrder = 'desc'; // Initially descending
         let outputTokensOrder = 'desc'; // Initially descending

         // Define sort function
         function sortTable(column, order) {
            // Get table data
            const tableRows = Array.from(document.querySelectorAll('#tableBody tr:not(#loadingRow)'));
            const sortedRows = tableRows.sort((a, b) => {
               let aValue, bValue;
         
               if (column === 1) { // Providers column
                     const aProviderImg = a.children[column].querySelector('img');
                     const bProviderImg = b.children[column].querySelector('img');
                     aValue = aProviderImg ? aProviderImg.alt.trim().toLowerCase() : '';
                     bValue = bProviderImg ? bProviderImg.alt.trim().toLowerCase() : '';
               } else if (column === 0) { // Model Name column
                     aValue = a.children[column].textContent.trim().toLowerCase();
                     bValue = b.children[column].textContent.trim().toLowerCase();
               } else { // Input Tokens and Output Tokens columns
                     aValue = parseFloat(a.children[column].textContent.replace(/[^0-9.-]+/g, ""));
                     bValue = parseFloat(b.children[column].textContent.replace(/[^0-9.-]+/g, ""));
               }
         
               if (order === 'asc') {
                     if (column === 0 || column === 1) {
                        return aValue.localeCompare(bValue);
                     } else {
                        return aValue - bValue;
                     }
               } else {
                     if (column === 0 || column === 1) {
                        return bValue.localeCompare(aValue);
                     } else {
                        return bValue - aValue;
                     }
               }
            });
         
            // Clear table body
            const tableBody = document.getElementById('tableBody');
            tableBody.innerHTML = '';
         
            // Insert sorted rows
            sortedRows.forEach(row => tableBody.appendChild(row));
         }
         
         // Add click event listeners to <a> tags
         sortModelNameLink.addEventListener('click', (event) => {
            event.preventDefault(); // Prevent default behavior
            modelNameOrder = modelNameOrder === 'asc' ? 'desc' : 'asc';
            sortTable(0, modelNameOrder); // Sort column 1 (Model Name)
         });
         
         sortProvidersLink.addEventListener('click', (event) => {
            event.preventDefault(); // Prevent default behavior
            providersOrder = providersOrder === 'asc' ? 'desc' : 'asc';
            sortTable(1, providersOrder); // Sort column 2 (Providers)
         });
         
         sortInputTokensLink.addEventListener('click', (event) => {
            event.preventDefault(); // Prevent default behavior
            inputTokensOrder = inputTokensOrder === 'asc' ? 'desc' : 'asc';
            sortTable(2, inputTokensOrder); // Sort column 3 (Input Tokens)
         });
         
         sortOutputTokensLink.addEventListener('click', (event) => {
            event.preventDefault(); // Prevent default behavior
            outputTokensOrder = outputTokensOrder === 'asc' ? 'desc' : 'asc';
            sortTable(3, outputTokensOrder); // Sort column 4 (Output Tokens)
         });
      </script>
      <!-- Google tag (gtag.js) -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZX0QMFZJYL"></script>
