"},{"name":"Product","slug":"product","href":"/blog/topics?topics=product","weight":6},{"name":"Founders","slug":"founders","href":"/blog/topics?topics=founders","weight":10}]},"title":"Building a founder-first company","date":"2025-01-07T10:31:57","modified":"2025-01-31T14:48:08","blocks":[{"name":"wrapper","attributes":{"slug":"blog-text-block","alias":"Text Block","className":"pb-48 md:pb-64","id":"50b329c3-f220-4379-be34-4eb6b2d8eede","reuId":"4zlXFD","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"Grid","className":"max-w-100% mx-auto px-1 sm:max-w-725 sm:px-0","id":"c6e1241c-aaba-4b60-a80c-779980b6e808","reuId":"R0uWmE","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"Row","id":"0c584250-026d-40bf-b922-9be5e35ac9ed","reuId":"EqvlO7","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"Column","className":"flex flex-col items-start w-100%","id":"5184a460-a4c4-4d38-a207-bd0ff1c7bb2f","reuId":"aoCu83","data":{}},"innerBlocks":[{"name":"paragraph","attributes":{"className":"leading-32 text-20 text-charcoal sm:leading-36","id":"a000b327-a7ab-421a-83e6-4d4c2073885a","reuId":"KdUOeD","innerContent":"We’re excited to announce that the highly skilled team of engineers at Lekko is joining Rippling. Founded by Konrad Niemiec, Lekko was built to replicate and evolve the dynamic code system Konrad and his team were able to build at Uber and Meta. Konrad knew that good coding tools are transparent, allow work to happen without rebuilds, customer incidents, or zombie flags that come back to haunt you. Lekko addressed this need by creating dynamic software tools for a broader range of companies with more individualized relationships with the customers, clients and partners that use their products.","content":"We’re excited to announce that the highly skilled team of engineers at Lekko is joining Rippling. Founded by Konrad Niemiec, Lekko was built to replicate and evolve the dynamic code system Konrad and his team were able to build at Uber and Meta. Konrad knew that good coding tools are transparent, allow work to happen without rebuilds, customer incidents, or zombie flags that come back to haunt you. Lekko addressed this need by creating dynamic software tools for a broader range of companies with more individualized relationships with the customers, clients and partners that use their products.","data":{}},"innerBlocks":[]}]}]}]}]},{"name":"wrapper","attributes":{"slug":"blog-pull-quote-basic","alias":"Inline Pull Quote 1","className":"pb-48 relative md:pb-64","id":"41037079-68a9-472c-b05d-3730dd78d9ce","reuId":"e0E7OO","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"Grid","className":" grid max-w-100% mx-auto px-1 sm:max-w-725 sm:px-0","id":"54c3ded9-29d2-4669-94c1-706d4ceb823e","reuId":"aC6lTU","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"Row","id":"292ade8a-f3ff-4d2c-b4ea-f7842b456c50","reuId":"WBYC1C","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"Column","className":"w-100%","id":"09e05554-6a20-4c2d-968e-22808278979f","reuId":"OYteAG","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"ImageX","className":"float-left mr-8 mt-10 w-28 md:w-42","id":"f27747d0-d1ae-4d2d-ac63-d223382dedf7","reuId":"jB26P2","data":{}},"innerBlocks":[{"name":"image","attributes":{"mediaURL":"https://rippling.imgix.net/images/quote-mark.svg","width":"44","height":"35","nonResponsive":true,"id":"0358fc29-d000-411d-9b23-8f620206c16f","reuId":"jmuoZd","data":{}},"innerBlocks":[]}]},{"name":"paragraph","attributes":{"className":" font-bold -tracking-150 font-display leading-38 mb-16 mt-0 text-32 sm:mb-20 md:-tracking-300 md:leading-56 md:text-48","id":"271d51d4-d68f-4faf-84fe-e70b768b5697","reuId":"gppTwf","innerContent":"\u003cstrong\u003eThe Lekko team and I are excited to join Rippling’s talented group of engineers. Rippling’s culture matches ours by rewarding autonomy and pushing through uncertainty. We are motivated to leverage our combined experiences to accelerate the scalability and flexibility of Rippling’s platform.\u003c/strong\u003e","content":"\u003cstrong\u003eThe Lekko team and I are excited to join Rippling’s talented group of engineers. Rippling’s culture matches ours by rewarding autonomy and pushing through uncertainty. We are motivated to leverage our combined experiences to accelerate the scalability and flexibility of Rippling’s platform.\u003c/strong\u003e","data":{}},"innerBlocks":[]},{"name":"wrapper","attributes":{"alias":"Citation","className":"align-center jusify-start flex mt-16","id":"c0f007f4-4f20-449f-9779-dadf17002ae2","reuId":"ZUiRLV","data":{}},"innerBlocks":[{"name":"paragraph","attributes":{"className":"font-medium is-style-overline leading-16 mr-8 text-12 uppercase","id":"d3d3de75-f6cb-4e37-924e-5dfc00d96e67","reuId":"pwO6kh","innerContent":"Konrad Niemiec","content":"Konrad Niemiec","data":{}},"innerBlocks":[]},{"name":"paragraph","attributes":{"className":"font-medium is-style-overline leading-16 text-12 text-grey-4 uppercase","id":"a3e10295-3015-4cc7-ae1e-c83ba5822d1a","reuId":"wRjnZr","innerContent":"Founder of Lekko","content":"Founder of Lekko","data":{}},"innerBlocks":[]}]}]}]}]}]},{"name":"wrapper","attributes":{"slug":"blog-inline-image","alias":"Inline Image","className":"pb-48 md:pb-64","id":"1fb4b615-1c27-4a7a-a722-e053ef550392","reuId":"PLAM6U","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"Grid","className":"max-w-100% mx-auto px-1 sm:max-w-725 sm:px-0","id":"87ea8257-5ec9-4825-b19d-b8bcfa44c8e3","reuId":"GnwEHy","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"Row","className":"text-center","id":"5779d2e1-6297-4d01-a7be-15d7b805624d","reuId":"DR7LKZ","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"Column","className":"relative w-100%","id":"5802e5e2-75d1-45a2-a420-af560e1c8547","reuId":"WzfG1x","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"className":"flex items-center justify-center mx-auto relative w-100%","id":"ea456df2-88fd-432e-ae59-1e97e84fe529","reuId":"JLtE5F","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"ImageX","className":"w-100%","id":"bd354c98-315e-4b15-aabe-c27c7804706b","reuId":"gDpCnP","data":{}},"innerBlocks":[{"name":"image","attributes":{"mediaURL":"https://rippling2.imgix.net/lekko.png","width":"450","height":"326","nonResponsive":true,"pushForI18n":true,"className":"block w-100%","id":"c955d9c7-7b70-4684-af27-43c0b4496e3d","reuId":"WKo7bj","data":{}},"innerBlocks":[]}]}]}]}]}]}]},{"name":"wrapper","attributes":{"slug":"blog-text-block","alias":"Text Block","className":"pb-48 md:pb-64","id":"50b329c3-f220-4379-be34-4eb6b2d8eede","reuId":"4zlXFD","data":{}},"innerBlocks":[{"clientId":"f880be73-893b-4561-a542-adeb6af103f5","name":"wrapper","isValid":true,"originalContent":"","validationIssues":[],"className":"max-w-100% mx-auto px-1 sm:max-w-725 sm:px-0","attributes":{"alias":"Grid","id":"f880be73-893b-4561-a542-adeb6af103f5","reuId":"YcZhLq","parentClientId":"94c5a47d-0f23-4792-9f73-cd85ff59ff9a","className":"max-w-100% mx-auto px-1 sm:max-w-725 sm:px-0","data":{}},"innerBlocks":[{"clientId":"0770706c-02c1-4794-b827-4d0f438bef6f","name":"wrapper","isValid":true,"originalContent":"","validationIssues":[],"attributes":{"alias":"Row","id":"0770706c-02c1-4794-b827-4d0f438bef6f","reuId":"k5X00Z","parentClientId":"94c5a47d-0f23-4792-9f73-cd85ff59ff9a","data":{}},"innerBlocks":[{"clientId":"35fa8616-ca8b-4c91-9e80-e7222cbfeb41","name":"wrapper","isValid":true,"originalContent":"","validationIssues":[],"className":"flex flex-col items-start w-100%","attributes":{"alias":"Column","id":"35fa8616-ca8b-4c91-9e80-e7222cbfeb41","reuId":"7RSizr","parentClientId":"94c5a47d-0f23-4792-9f73-cd85ff59ff9a","className":"flex flex-col items-start w-100%","data":{}},"innerBlocks":[{"clientId":"23bbad42-78e5-41be-bb63-e0eba647923b","name":"paragraph","isValid":true,"attributes":{"content":"Konrad, along with engineers David Kang, Sergey Passichenko and Jonathan Dobbie, will be joining our Platform team and will be part of a cohort of more than 150 former founders at Rippling. We hire founders because of their grit, ambition, and resilience. They have experience building both their teams and products from scratch, thrive on change, push the limits of possible, and nothing is ever not their problem.\u0026nbsp;","dropCap":false,"id":"23bbad42-78e5-41be-bb63-e0eba647923b","reuId":"xcchn3","innerContent":"Konrad, along with engineers David Kang, Sergey Passichenko and Jonathan Dobbie, will be joining our Platform team and will be part of a cohort of more than 150 former founders at Rippling. We hire founders because of their grit, ambition, and resilience. They have experience building both their teams and products from scratch, thrive on change, push the limits of possible, and nothing is ever not their problem.\u0026nbsp;","data":{}},"innerBlocks":[]},{"clientId":"5486f28c-eb62-498a-b242-937cf24c0861","name":"paragraph","isValid":true,"attributes":{"content":"When former founders join Rippling, we’re sure to place them in a team where they can have an immediate and significant impact. They often run entire teams and build new products. Konrad and the Lekko team will accelerate our investment in the Rippling platform, helping to scale our capabilities and meet the needs of our growing customers and users.\u0026nbsp;","dropCap":false,"id":"5486f28c-eb62-498a-b242-937cf24c0861","reuId":"EcbiBc","innerContent":"When former founders join Rippling, we’re sure to place them in a team where they can have an immediate and significant impact. They often run entire teams and build new products. Konrad and the Lekko team will accelerate our investment in the Rippling platform, helping to scale our capabilities and meet the needs of our growing customers and users.\u0026nbsp;","data":{}},"innerBlocks":[]},{"clientId":"afe74cd6-be55-4b66-96f4-1b3fa2ed9a7a","name":"paragraph","isValid":true,"attributes":{"content":"Welcome, Konrad and team. We’re excited to build together.","dropCap":false,"id":"afe74cd6-be55-4b66-96f4-1b3fa2ed9a7a","reuId":"gUt5WI","innerContent":"Welcome, Konrad and team. We’re excited to build together.","data":{}},"innerBlocks":[]},{"clientId":"57441e1d-6a50-4363-9c05-54c5b10f8423","name":"paragraph","isValid":true,"attributes":{"content":"If you’re a founder or former founder, reach out. We have positions open across Engineering and throughout Rippling.","dropCap":false,"id":"57441e1d-6a50-4363-9c05-54c5b10f8423","reuId":"yJZU8H","innerContent":"If you’re a founder or former founder, reach out. We have positions open across Engineering and throughout Rippling.","data":{}},"innerBlocks":[]}]}]}],"added":true,"position":"first"}]},{"name":"wrapper","attributes":{"alias":"Grid Inline Cta w/image","className":" max-w-100% mx-auto pb-48 xsx:w-93% md:max-w-725 md:pb-64 md:px-0 md:w-100%","id":"79f621f6-0811-46d0-903a-acc6a41c9c1c","reuId":"U7Fz2V","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"link":"/careers/open-roles","alias":"Inline Inline Cta w/image","className":"   group bg-plum flex flex-col items-end justify-center mx-auto overflow-hidden rounded-4 text-center w-100% sm:flex-row sm:max-w-725 sm:text-left","id":"ac13cfbc-7271-4bd2-96b7-949cf9436bcc","reuId":"1rCw5X","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"alias":"InfoCol","className":"  w-100% sm:w-50%","id":"36ad78a2-c270-4e17-a360-993c82882b8c","reuId":"qaimxL","data":{}},"innerBlocks":[{"name":"wrapper","attributes":{"className":"  pb-0 pt-32 px-24 sm:pl-48 sm:pr-24 sm:py-48","id":"8e034f59-a3a6-4cb4-a0fc-c0b87145dcc6","reuId":"qCVCJY","data":{}},"innerBlocks":[{"name":"paragraph","attributes":{"className":"font-semibold leading-26 max-w-100% mb-8 text-22 text-center text-white sm:leading-30 sm:max-w-250 sm:text-24 sm:text-left","id":"321e6074-f581-450f-abc1-964e7a7a4431","reuId":"AUQEjd","innerContent":"We're hiring! ","content":"We're hiring! ","da