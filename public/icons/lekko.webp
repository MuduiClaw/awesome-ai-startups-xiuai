b=a.contentDocument||a.contentWindow.document;if(b){var d=b.createElement('script');d.innerHTML="window.__CF$cv$params={r:'92df8543ee6016fa',t:'MTc0NDI1OTU0OC4wMDAwMDA='};var a=document.createElement('script');a.nonce='';a.src='/cdn-cgi/challenge-platform/scripts/jsd/main.js';document.getElementsByTagName('head')[0].appendChild(a);";b.getElementsByTagName('head')[0].appendChild(d)}}if(document.body){var a=document.createElement('iframe');a.height=1;a.width=1;a.style.position='absolute';a.style.top=0;a.style.left=0;a.style.border='none';a.style.visibility='hidden';document.body.appendChild(a);if('loading'!==document.readyState)c();else if(window.addEventListener)document.addEventListener('DOMContentLoaded',c);else{var e=document.onreadystatechange||function(){};document.onreadystatechange=function(b){e(b);'loading'!==document.readyState&&(document.onreadystatechange=e,c())}}}})();</script></body><script>
            window.__BUILD_ID__ = 'bwvg1Nw_mESeFU1tX5bPi';

            const getLatestBuildId = async () => {
              try {
                const res = await fetch('/api/www-vercel-get-build-id')
                const data = await res.json()
                return data.buildId
              } catch (err) {
                console.error('Failed to fetch buildId', err)
                return null
              }
            }
            
            const reloadWindow = () => {
              // dont reload if we're already reloading...
              if (window.__STALE_BUILD_RELOAD__) return
              window.__STALE_BUILD_RELOAD__ = true
              window.location.reload(true)
            }
            
            const buildIdIsStale = async () => {
              const latestBuildId = await getLatestBuildId()
              // we dont want to infinitely reload users windows if this fails...
              if (!latestBuildId) return false
              // test logic
              if (window.__TEST_BUILD_ID__) return latestBuildId !== window.__TEST_BUILD_ID__
              return window.__BUILD_ID__ !== latestBuildId
            }
            
            const handleBuildIdValidation = async () => {
              const shouldReloadWindow = await buildIdIsStale()
              if (shouldReloadWindow) reloadWindow()
            }
            
            const onVisibilityChange = expectedVisibility => {
              if (document.visibilityState === expectedVisibility) {
                handleBuildIdValidation()
              }
            }
            
            const watchAndRefreshOnStaleBuild = () => {
              // should run on the client side
              if (typeof window === 'undefined') return
            
              if (!window.__VISIBILITY_LISTENER__) {
                // we want to run the check manually when a user revisits a tab (visible)
                window.__VISIBILITY_LISTENER__ = window.addEventListener(
                  'visibilitychange',
                  () => onVisibilityChange('visible')
                )
              }
            
              if (!window.__BUILD_ID_CHECK_INTERVAL__) {
                // we want the check to run automatically on non-active tabs (hidden)
                window.__BUILD_ID_CHECK_INTERVAL__ = window.setInterval(
                  () => onVisibilityChange('hidden'),
                  300000
                )
              }
            }
            
            (() => watchAndRefreshOnStaleBuild())()
            </script></html></body></html>