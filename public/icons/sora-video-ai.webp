    <style>
        /* Custom styles */
        .brand-gradient {
            background: linear-gradient(to right, #10B981, #06B6D4);
        }

        .glass-sharp {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(20px);
            position: relative;
            z-index: 1;
        }

        .animate-pulse-brightness {
            animation: pulse-brightness 2s infinite;
        }

        @keyframes pulse-brightness {
            0%, 100% { filter: brightness(1); }
            50% { filter: brightness(1.2); }
        }

        body {
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        body::-webkit-scrollbar {
            display: none;
        }

        .preview-face {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            transition: opacity 0.3s ease;
        }

        .preview-face img {
            max-width: 80%;
            height: auto;
        }

        .text-gradient {
            background: linear-gradient(to right, #fff 20%, rgba(255, 255, 255, 0.7));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .gradient-bg {
            background: linear-gradient(to right, #10B981, #06B6D4);
        }

        .text-gradient-animated {
            background: linear-gradient(to right, #fff, #fff, rgba(255, 255, 255, 0.6));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-size: 200% auto;
            animation: shine 3s linear infinite;
        }

        @keyframes shine {
            to {
                background-position: 200% center;
            }
        }

        .animate-pulse-slow {
            animation: pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @keyframes pulse {
            0%, 100% {
                opacity: 1;
            }
            50% {
                opacity: .7;
            }
        }

        @keyframes arrow-pulse {
            0%, 100% {
                transform: translateX(0);
                opacity: 0.8;
            }
            50% {
                transform: translateX(-10px);
                opacity: 1;
            }
        }

        .animate-pulse-slow {
            animation: arrow-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        .shadow-glow {
            box-shadow: 0 0 30px -5px rgba(16, 185, 129, 0.3);
        }

        .source-image-card {
            transition: all 0.3s ease;
        }

        .source-image-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 30px -5px rgba(16, 185, 129, 0.3);
        }

        .heading-gradient {
            position: relative;
            display: inline-block;
            color: white;
            z-index: 1;
        }

        .heading-gradient::after {
            content: attr(data-text);
            position: absolute;
            left: 0;
            top: 0;
            z-index: -1;
            background: linear-gradient(to right, #fff, #fff, rgba(255, 255, 255, 0.6));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .relative {
            position: relative;
            z-index: 1;
        }

        .fixed {
            z-index: 0;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        @keyframes floatReverse {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(10px); }
        }

        .float {
            animation: float 6s ease-in-out infinite;
        }

        .float-reverse {
            animation: floatReverse 6s ease-in-out infinite;
        }

        .float-delay-1 {
            animation-delay: -2s;
        }

        .float-delay-2 {
            animation-delay: -4s;
        }

        .video-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            grid-auto-rows: minmax(100px, auto);
            gap: 1rem;
            max-height: 800px;
            overflow: hidden;
            padding: 2rem;
            margin: -2rem;
        }

        @media (max-width: 1024px) {
            .video-grid {
                grid-template-columns: repeat(4, 1fr);
                max-height: 600px;
            }
        }

        @media (max-width: 768px) {
            .video-grid {
                grid-template-columns: repeat(3, 1fr);
                max-height: 500px;
            }
        }

        .video-item {
            grid-column: span 2;
            transition: all 0.3s ease;
        }

        .video-item:nth-child(3n) {
            grid-column: span 3;
        }

        .video-item:nth-child(5n) {
            grid-column: span 2;
        }

        .video-item:hover {
            z-index: 10;
        }

        .video-scroll {
            position: relative;
            width: 100%;
            overflow: hidden;
            padding: 1rem 0;
        }

        .video-track {
            display: flex;
            gap: 1rem;
            animation: scroll 60s linear infinite;
            width: max-content;
        }

        .video-track-reverse {
            animation: scroll-reverse 60s linear infinite;
        }

        @keyframes scroll {
            0% {
                transform: translateX(0);
            }
            100% {
                transform: translateX(-50%);
            }
        }

        @keyframes scroll-reverse {
            0% {
                transform: translateX(-50%);
            }
            100% {
                transform: translateX(0);
            }
        }

        .video-item {
            width: 400px;
            flex-shrink: 0;
        }

        @media (max-width: 768px) {
            .video-item {
                width: 300px;
            }
        }
    </style>
</head>
<body class="bg-black">
