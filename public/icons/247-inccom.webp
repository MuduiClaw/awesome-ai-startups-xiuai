    .ft-col-border-left:before {
    border-left: solid 2px #b9babb00;
    }
    .star-icon h2:before {
    left: 0;
    top: 0;
    visibility: hidden;
}
.border-left {
    border-left: solid 2px #b9babb00;
}
}
