.ft-col-border-left:before {
    border-left: solid 2px #b9babb;
    position: relative;
    content: "";
    margin-top: 31.2%;
}
.border-left {
    border-left: solid 2px #b9babb;
}
.star-icon h2:before {
   content: url(https://www.247.ai/wp-content/uploads/2023/12/Fa-Team-Fontawesome-FontAwesome-Star-of-Life.svg);
    width: 14px;
    position: absolute;
    left: -28px;
    top: -4px;
}
.scroll-section .lqd-section-scroll-dot {
    width: 6px;
    height: 6px;
    border: 1px solid #000;
    cursor: pointer;
    font-size: 0px;
    color: #000;
    background-color: #000;
    border-radius: 100%;
}
.scroll-section .lqd-section-scroll-dots {
    right: 109px;
}
.scroll-section .lqd-section-scroll-dot.is-active, .lqd-section-scroll-dot:hover {
    border-color: #1b58f4;
    background-color: #1b58f4;
    color: #fff;
}

