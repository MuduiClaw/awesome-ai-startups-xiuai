.sliding_box_child.active-elem {
    width: 79.6%;
    background-color: #fff;
    box-shadow: 10px 10px 40px #00000029;
}
.sliding_box_child img {
    box-shadow: 0px 0px 5px 0px rgba(0, 0, 0, 0.12);
}
.sliding_box_child .slide-row{
    display: inline-block;
}
.sliding_box_child .slide-row.row-one {
    width: 60%;
}
.sliding_box_child .slide-row.row-two {
    width: 36%;
}
.sliding_box_child.active-elem .sb-image {
    /*border-right: solid 2px #ddd;*/
}
.sliding_box_child.active-elem .sb-image p {
    color: #c1c1c2;
}
.sliding_box_child .sb-image {
    border-right: solid 2px transparent;
}
.sliding_box_child {
    padding: 0;
    position: relative;
    float: left;
    width: 100px;
    -webkit-transition: all 450ms ease-in-out;
    -moz-transition: all 450ms ease-in-out;
    -o-transition: all 450ms ease-in-out;
    transition: all 450ms ease-in-out;
    overflow: hidden;
    margin-right: 20px;
    border-radius: 8px;
    background-color: #685BC7;
    box-shadow: 10px 10px 40px #00000029;
}
.sliding_box_child .sb-image {
width: 350px !important;
    height: 480px;
    position: relative;
}
.slide-row p{
    font-size: 16px;
    letter-spacing: 0;
    font-family: 'Lato';
}
.sliding_box_child .sb-image p {
    position: relative;
    transform: rotate(270deg);
    font-size: 42px;
    font-weight: 800;
    left: -125px;
    top: 50%;
    /* bottom: 189px; */
    letter-spacing: 7px;
    /* display: block; */
    color: #fff;
    margin: 0;
    text-align: left;
}
.sliding_box_child:first-child .sb-image p {
    /*left: -145px;*/
    /*bottom: 215px;*/
