.lqd-blog-post-style-1 .entry-meta time,
.lqd-blog-post-style-2 .entry-meta a,
.lqd-blog-post-style-2 .entry-meta time,
.lqd-blog-post-style-5 .entry-meta a,
.lqd-blog-post-style-5 .entry-meta time {
    font-size: 12px !important;
}

.faq-sec-items span.accordion-expander {
    background: #1b58f4 !important;
}

/*button style starts here*/
.transparent-btn.custombtnlink .elementor-button.btn:hover {
    color: #1b58f4 !important;
}

a.elementor-button.btn.btn-solid {
    background: #1b58f4 !important;
    border: 1px solid #1b58f4 !important;
    color: #fff !important;
    font-size: 15px !important;
    padding: 8px 15px !important;
    line-height: 1.25em !important;
    text-transform: capitalize !important;
}

a.elementor-button.btn.btn-solid:hover,
a.elementor-button.btn.btn-solid:focus {
    background: #292929 !important;
    color: #fff !important;
    border: 1px solid #292929 !important;
}

header.site-header a.elementor-button.btn.btn-solid {
    font-size: 14px !important;
    padding: 5px 15px !important;
    line-height: 0px !important;
    border-radius: 5px !important;
}

header.site-header a.elementor-button.btn.btn-solid:hover,
header.site-header a.elementor-button.btn.btn-solid:focus {
    color: #fff !important;
    border: 1px solid #292929 !important;
}

.customblackbtn a.elementor-button.btn.btn-solid:hover,
.customblackbtn a.elementor-button.btn.btn-solid:focus {
    color: #fff !important;
}

.customblackbtn a.elementor-button.btn.btn-solid {
    background: #292929 !important;
    border: 1px solid #292929 !important;
}

.customwhitebtn a.elementor-button.btn.btn-solid,
.customwhitebtn a.elementor-button.btn.btn-solid:hover span {
    background: #1b58f4 !important;
    border: 1px solid #1b58f4 !important;
    color: #ffffff !important;
}

.customwhitebtn1 a.elementor-button.btn.btn-solid {
    background: #1b58f4 !important;
    border: 1px solid #1b58f4 !important;
    color: #ffffff !important;
}

.customwhitebtn1 a.elementor-button.btn.btn-solid:hover {
    background: #292929 !important;
    border: 1px solid #292929 !important;
    color: #ffffff !important;
}

.elementor-widget-social-icons a.elementor-icon.elementor-social-icon:hover {
    background: #1b58f4 !important;
    opacity: 1 !important;
}

footer .elementor-widget-social-icons a.elementor-icon.elementor-social-icon:hover {
    background: #1b58f400 !important;
    opacity: 1 !important;
}

.carousel-nav.carousel-nav-lg .flickity-button:hover {
    background: #1b58f4 !important;
}

.carousel-nav.carousel-nav-circle .flickity-button svg,
.carousel-nav.carousel-nav-square .flickity-button svg {
    max-width: 38% !important;
}

.customwhitebtn1.servicebtn a.elementor-button.btn.btn-solid:hover {
    background: #1b58f4 !important;
    border: 1px solid #1b58f4 !important;
    color: #ffffff !important;
}

.customwhitebtn1.servicebtn a.elementor-button.btn.btn-solid {
    background: #292929 !important;
    border: 1px solid #292929 !important;
    color: #ffffff !important;
}

/*============================Logos Greyscale style======================*/
.grayscale-logos img,
.grayscale-logos a image,
.grayscale-logos a .lqd-tabs-nav-icon-icon {
    -webkit-filter: grayscale(100%);
    filter: grayscale(100%);
}

.grayscale-logos img:hover,
.grayscale-logos a:hover image,
.grayscale-logos a:hover .lqd-tabs-nav-icon-icon,
.grayscale-logos .active a .lqd-tabs-nav-icon-icon{
    -webkit-filter: grayscale(0%);
    filter: grayscale(0%);
}

#blue-gradient .ld-flipbox-back,
#blue-gradient .icon-box-bg-gradient .elementor-widget-wrap {
    background-image: linear-gradient(115deg, #1B58F421 0%, #BCA7FA89 52%, #BCCAEE 100%) !important;
}

#blue-gradient .address-infoitem > .elementor-element-populated > .elementor-background-overlay {
    background-image: linear-gradient(115deg, #1B58F421 0%, #BCA7FA89 52%, #BCCAEE 100%);
}

#blue-gradient .address-infoitem > .elementor-element-populated > .elementor-background-overlay:hover {
    background-image: linear-gradient(115deg, #1b58f400 0%, #bca7fa00 52%, #bccaee00 100%);
}

#blue-gradient .address-infoitem:hover > .elementor-element-populated > .elementor-background-overlay {
    background-color: #000000ad !important;
    background-image: linear-gradient(115deg, #00000036 0%, #00000029 52%, #00000029 100%);
}

.black-hover-btn a.elementor-button.btn {
    background: #0A0A0A !important;
}

body.search.search-results .lqd-lp-style-22 .lqd-lp-meta {
    visibility: hidden;
}

body.search.search-results header.entry-header.lqd-lp-header.mb-3 {
    margin-bottom: 0px !important;
}

/*========================End Logos Greyscale style======================*/
/*remove arrow btn*/
.flip-button,
.flipreadmorebtn {
    display: none;
}

button.navbar-toggle.collapsed.nav-trigger.style-mobile.d-flex.pos-rel.align-items-center.justify-content-center {
    background: transparent !important;
}
li#menu-item-31848, li#menu-item-31847 {
    display: none !important;
}
/*custom login css starts*/
.login p.forgetmenot {
    display: block !important;
    max-width: 100% !important;
    float: unset !important;
}
.login label {
    display: block !important;
}
/*custom login css ends*/
@media screen and (max-width: 992px) {
    li#menu-item-31848, li#menu-item-31847 {
    display: block !important;
}
.menu-item-31848 a, .menu-item-31847 a {
    background: #1b58f4;
    border-radius: 4px;
    color: #fff !important;
    text-align: center !important;
    width: 100% !important;
    display: block !important;
    margin: 5px 0px;
}
.lqd-module-search-slide-top .ld-search-form .input-icon{
        margin-top: -50px !important;
}
    .csr-flip-box .ld-flipbox-front .ld-flipbox-inner {
        display: flex !important;
    }

    .ccs-flipbox-custom .ld-flipbox-back .ld-flipbox-inner {
        padding: 0px 15px !important;
    }

    .paoc-popup-center-center .paoc-cb-popup-body {
        border-radius: 15px;
        padding: 0px !important;
    }

    .team-image {
        padding-right: 0px !important;
    }

    .team-profile {
        margin-bottom: 15px;
    }

    .homecontactus .pl-0 {
        padding-left: 15px !important;
    }

    .homecontactus .pr-0 {
        padding-right: 15px !important;
    }

    .timeline > .elementor-widget-wrap.elementor-element-populated {
        background: #1b58f4 !important;
    }

    .faq-sec-items .accordion-item.panel a,
    .faq-sec-items .accordion-item.panel a span {
        line-height: 30px !important;
        font-weight: 500 !important;
        font-size: 17px !important;
