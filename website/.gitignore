# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# downloaded product icons (generated by scripts/download_icons.py)
/public/icons/*.png
/public/icons/*.jpg
/public/icons/*.jpeg
/public/icons/*.webp
/public/icons/*.gif
/public/icons/*.ico

# build-generated data cache (written by data.ts during SSG)
/public/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
